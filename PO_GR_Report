function requestVisibilityStatus(){
  const total=requestState.filtered.length,end=requestState.start+requestState.visible;
  requestId("visible").textContent=total?
    fmt(requestState.start+1)+"–"+fmt(end)+" / "+fmt(total)+" yêu cầu":"0 yêu cầu";
  requestId("first").disabled=requestState.start===0&&requestState.visible<=requestState.size;
  requestId("last").disabled=end>=total;
  requestId("sentinel").textContent=end<total?
    "Cuộn xuống để tải thêm các yêu cầu":"Đã đến cuối danh sách yêu cầu";

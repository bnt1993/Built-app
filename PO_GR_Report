function fromJSText(text,globalNames){
  const names=Array.isArray(globalNames)?globalNames:[globalNames];
  let name="",match=null;
  for(const candidate of names){
    const found=new RegExp("window\\."+candidate+"\\s*=\\s*\\[").exec(text);
    if(found){name=candidate;match=found;break}
  }
  if(!match)throw Error("Không tìm thấy biến dữ liệu: "+names.map(n=>"window."+n).join(" hoặc "));
  const start=match.index+match[0].lastIndexOf("[");
  let depth=0,inString=false,escaped=false,end=-1;
  for(let i=start;i<text.length;i++){
    const c=text[i];
    if(inString){
      if(escaped)escaped=false;

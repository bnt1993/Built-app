function updateVisibleStatus(){
  const total=state.filtered.length,start=state.start,shown=state.visibleCount;
  id("page-summary").textContent=total?fmt(start+1)+"–"+fmt(start+shown)+" / "+fmt(total)+" dòng":"0 dòng";
  id("page-indicator").textContent=total?(start===0&&shown<total?"Tự tải khi cuộn · ":"")+
    fmt(start+shown)+"/"+fmt(total):"0 / 0";
  id("first").disabled=start===0&&shown<=state.size;
  id("last").disabled=start+shown>=total;
  id("load-sentinel").textContent=start+shown<total?"Cuộn xuống để tải thêm dữ liệu":"Đã hiển thị đến cuối danh sách";
}
function showWindow(start,count){
  const total=state.filtered.length;
  state.start=Math.max(0,Math.min(start,Math.max(0,total-1)));
  state.visibleCount=Math.min(count,Math.max(0,total-state.start));
  id("report-body").replaceChildren();
  appendRows(state.filtered.slice(state.start,state.start+state.visibleCount));
  id("empty").hidden=total!==0;
  updateVisibleStatus();
}
function loadNextBatch(){
  if(state.loading||state.start!==0||state.visibleCount>=state.filtered.length)return false;
  const old=state.visibleCount;
  state.visibleCount=Math.min(state.filtered.length,old+state.size);
  appendRows(state.filtered.slice(old,state.visibleCount));
  updateVisibleStatus();

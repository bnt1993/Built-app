    if(!state.po.length){
      id("dataset-summary").textContent="Chưa có dữ liệu PO hợp lệ";
      id("join-note").textContent=state.poError||"Cần tải PO.js để đối chiếu";
    }else{
      const emptyGR=[Object.values(aliases.gr).map(names=>names[0])];
      const info=buildReport(state.po,state.gr.length?state.gr:emptyGR,id("include-105").checked);
      state.rows=info.rows;state.totalPO=info.totalPO;state.excludedPO=info.excludedPO;state.warnings=[];
      if(!state.gr.length){
        for(const row of state.rows){
          row.grQty=NaN;row.percent=NaN;row.remain=NaN;row.status="invalid";
          row.issues.push("Chưa có dữ liệu GR hợp lệ");
        }
        state.warnings.push("Chưa có dữ liệu GR hợp lệ; chưa thể tính số lượng đã nhận");

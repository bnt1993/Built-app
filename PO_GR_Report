      if(info.mismatch)state.warnings.push(info.mismatch+" dòng GR có mã vật tư khác PO");
      if(info.duplicates)state.warnings.push(info.duplicates+" chứng từ GR trùng đã bỏ qua");
      if(info.invalidDate)state.warnings.push(info.invalidDate+" dòng PO có ngày không hợp lệ");
      if(info.invalidQty)state.warnings.push(info.invalidQty+" dòng GR có số lượng không hợp lệ");
      if(info.unitMismatches)state.warnings.push(info.unitMismatches+" dòng PO cần kiểm tra đơn vị GR");
      id("join-note").textContent=state.warnings.length?state.warnings.join(" · "):
        "Đã đọc "+fmt(info.totalPO)+" dòng PO, "+fmt(info.totalGR)+" dòng GR · đối chiếu theo PO + Item + mã vật tư";

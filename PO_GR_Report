function agingClass(r){if(r.status==="done"||r.status==="excess")return "complete";
  return r.age>=80?"critical":r.age>=60?"high":r.age>=30?"medium":"low"}
function td(tr,value,className="",title=""){const x=document.createElement("td");x.textContent=value;
  if(className)x.className=className;if(title)x.title=title;tr.appendChild(x);return x}
function appendRows(rows){

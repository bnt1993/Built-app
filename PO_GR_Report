      else if(c==='"')inString=false;
      continue;
    }
    if(c==='"'){inString=true;continue}
    if(c==="[")depth++;
    if(c==="]"){depth--;if(depth===0){end=i+1;break}}
  }
  if(end<0)throw Error(name+" thiếu dấu đóng mảng. Vui lòng kiểm tra dấu ]; trong file.");
  const array=JSON.parse(text.slice(start,end));
  if(!isTable(array))throw Error(name+" không đúng định dạng bảng.");
  // Separate PO and GR timestamps are preferred over the older common field.
  const stampNames=names.includes("duLieuGR")?SOURCE_TIMESTAMPS.gr:
    names.includes("duLieuRequest")?SOURCE_TIMESTAMPS.request:SOURCE_TIMESTAMPS.po;
  let updated="";
  for(const stamp of stampNames){
    const found=new RegExp("window\\."+stamp+"\\s*=\\s*([\"'])(.*?)\\1").exec(text);
    if(found){updated=found[2];break}
  }

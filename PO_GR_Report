    td(tr,r.po,"sap", "Item: "+r.item);td(tr,r.material,"sap");td(tr,r.description,"desc",r.description);
    td(tr,displayDate(r.poDate));td(tr,fmt(r.poQty),"number");td(tr,fmt(r.grQty),"number");
    td(tr,displayDate(r.latestGr),r.latestGr?"":"empty");

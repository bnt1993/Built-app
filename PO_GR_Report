async function readScript(filename,globalNames){
  const names=Array.isArray(globalNames)?globalNames:[globalNames];
  // Remove previous global values so an old PO version cannot be mistaken
  // for the one just loaded. Restore them if the new script fails.
  const previous=new Map(names.map(name=>[name,window[name]]));
  for(const name of names){
    try{delete window[name]}catch{window[name]=undefined}
  }
  const stampNames=names.includes("duLieuGR")?SOURCE_TIMESTAMPS.gr:
    names.includes("duLieuRequest")?SOURCE_TIMESTAMPS.request:SOURCE_TIMESTAMPS.po;
  const oldStamps=new Map(stampNames.map(name=>[name,window[name]]));
  for(const name of stampNames){
    try{delete window[name]}catch{window[name]=undefined}
  }
  return new Promise((resolve,reject)=>{
    const script=document.createElement("script");let finished=false;
    function finish(error){
      if(finished)return;
      finished=true;clearTimeout(timeout);script.remove();
      const selected=names.find(name=>isTable(window[name]));
      const data=selected?window[selected]:null;
      const updated=stampNames.map(name=>window[name]).find(value=>
        typeof value==="string"&&value.trim())||"";
      if(error||!selected){
        for(const [name,value] of previous)window[name]=value;
        for(const [name,value] of oldStamps)window[name]=value;
        reject(Error(error||filename+" không chứa "+names.map(n=>"window."+n).join(" hoặc ")+" hợp lệ."));
        return;
      }
      resolve({data,updated:String(updated||""),globalName:selected});
    }
    const timeout=setTimeout(()=>finish("Hết thời gian tải "+filename),45000);
    script.onerror=()=>finish("Không tải được "+filename+" từ cùng thư mục HTML");
    script.onload=()=>finish("");

function showRequestWindow(start,count){
  const total=requestState.filtered.length;
  requestState.start=Math.max(0,Math.min(start,Math.max(0,total-1)));
  requestState.visible=Math.max(0,Math.min(count,total-requestState.start));
  const fragment=document.createDocumentFragment();
  for(const r of requestState.filtered.slice(
    requestState.start,requestState.start+requestState.visible))
    fragment.appendChild(requestRowDOM(r));
  requestId("body").replaceChildren(fragment);
  requestId("empty").hidden=total!==0;
  requestVisibilityStatus();
}
function addRequestBatch(){
  if(activeReportTab!=="request"||requestState.loading||
    requestState.start!==0||requestState.start+requestState.visible>=requestState.filtered.length)
    return false;
  const from=requestState.visible;
  const to=Math.min(requestState.filtered.length,from+requestState.size);
  const fragment=document.createDocumentFragment();
  for(const r of requestState.filtered.slice(from,to))
    fragment.appendChild(requestRowDOM(r));
  requestId("body").appendChild(fragment);
  requestState.visible=to;requestVisibilityStatus();return true;
}

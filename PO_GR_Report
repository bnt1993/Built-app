<script>
(function(){
"use strict";
const id=name=>document.getElementById(name);
const SOURCE_NAMES={po:["duLieuPO","duLieuCongTy"],gr:["duLieuGR"],request:["duLieuRequest"]};
const SOURCE_TIMESTAMPS={po:["thoiGianCapNhatPO","thoiGianCapNhat"],
  gr:["thoiGianCapNhatGR","thoiGianCapNhat"],
  request:["thoiGianCapNhatRequest","thoiGianCapNhat"]};
const todayISO=()=>{const d=new Date();return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0")};
const numeric=new Intl.NumberFormat("vi-VN",{maximumFractionDigits:2});
const state={po:[],gr:[],rows:[],filtered:[],poUpdated:"",grUpdated:"",loaded:false,loading:false,
  start:0,visibleCount:0,size:50,sort:"age",direction:"desc",warnings:[],poError:"",grError:"",reportError:"",poVar:"",grVar:"",totalPO:0,excludedPO:0};
const aliases={
  po:{po:["Pur. Doc.","Purchase Order","PO Num","PO Number","Purchasing Document"],
    item:["Item","PO Item","Purchasing Item"],material:["Material","Material Number","SAP"],
    description:["Short Text","Material Description","Description"],poDate:["Doc. Date","PO Date","Document Date"],
    poQty:["PO Quantity","Order Quantity","Quantity"],unit:["OUn","Order Unit","Unit"],
    buyer:["Created By","Buyer"],plant:["Plnt","Plant"],supplier:["Supplier","Vendor"],
    netPrice:["Net Price"],currency:["Crcy","Currency"]},
  gr:{po:["Purchase order","Purchase Order","PO Num"],item:["Item","PO Item"],
    material:["Material","Material Number"],date:["Posting Date","Entry Date"],
    movement:["Movement Type","MvT"],qty:["Qty in unit of entry","Quantity","Qty"],
    unit:["Unit of Entry","Unit"],doc:["Material Document","Document Number"],
    docItem:["Material Doc.Item","Document Item"],bill:["Bill of Lading","Bill"],
    description:["Material Description","Short Text"]}
};
function norm(text){return String(text??"").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/[^a-z0-9]/g,"")}
function findCol(head,names){for(const name of names){const ix=head.findIndex(v=>norm(v)===norm(name));if(ix>=0)return ix}return -1}
function normalizeCode(v){return String(v??"").trim().replace(/\.0+$/,"")}
function itemCode(v){const x=normalizeCode(v);return /^\d+$/.test(x)?x.replace(/^0+(?=\d)/,""):x}
function unitCode(v){return String(v??"").trim().toUpperCase()}
function number(v){
  if(typeof v==="number")return Number.isFinite(v)?v:NaN;
  let s=String(v??"").trim().replace(/[\u00a0\s]/g,"");
  if(!s)return NaN;
  const i=s.lastIndexOf(","),j=s.lastIndexOf(".");
  if(i>=0&&j>=0)s=i>j?s.replace(/\./g,"").replace(",","."):s.replace(/,/g,"");
  // Generated SAP sources use decimal commas, including three decimal places.
  // A single comma must never turn 81,078 EUR into 81078 EUR.
  else if(i>=0)s=s.replace(",",".");
  else if(j>=0&&/^-?\d{1,3}(?:\.\d{3}){2,}$/.test(s))s=s.replace(/\./g,"");
  const result=Number(s);return Number.isFinite(result)?result:NaN;
}
function excelDate(v){
  if(v===null||v===undefined||v==="")return "";
  const s=String(v).trim();
  const serial=Number(s);
  if(/^\d{4,6}(?:\.0+)?$/.test(s)&&serial>=1&&serial<100000){
    return new Date(Date.UTC(1899,11,30)+Math.floor(serial)*86400000).toISOString().slice(0,10);
  }
  let m=s.match(/^(\d{4})[-/](\d{1,2})[-/](\d{1,2})/);
  if(m)return validDate(m[1]+"-"+m[2].padStart(2,"0")+"-"+m[3].padStart(2,"0"));
  m=s.match(/^(\d{1,2})[/. -](\d{1,2})[/. -](\d{4})/);
  if(m)return validDate(m[3]+"-"+m[2].padStart(2,"0")+"-"+m[1].padStart(2,"0"));
  return "";
}
function validDate(s){const m=/^(\d{4})-(\d{2})-(\d{2})$/.exec(s);if(!m)return "";
  const d=new Date(s+"T00:00:00Z");return !Number.isNaN(d.valueOf())&&d.toISOString().slice(0,10)===s?s:""}
function displayDate(s){if(!s)return "—";const v=s.split("-");return v[2]+"/"+v[1]+"/"+v[0]}
function daysOld(s){if(!s)return NaN;return Math.max(0,Math.floor((Date.parse(todayISO()+"T00:00:00Z")-Date.parse(s+"T00:00:00Z"))/86400000))}
function fmt(n){return Number.isFinite(n)?numeric.format(n):"—"}
function escapeText(v){return String(v??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
function calculateStatus(row){
  if(row.issues?.length||!Number.isFinite(row.poQty)||row.poQty<=0||!Number.isFinite(row.grQty))return "invalid";
  if(row.grQty<0)return "invalid";
  if(row.grQty===0)return "none";
  if(row.grQty<row.poQty-1e-8)return "partial";
  if(row.grQty>row.poQty+1e-8)return "excess";
  return "done";
}
function mapFields(source,kind){
  if(!Array.isArray(source)||!Array.isArray(source[0]))throw Error("Nguồn "+kind.toUpperCase()+" không có dòng tiêu đề dạng mảng.");
  const headers=source[0].map(String),out={};
  for(const [k,list] of Object.entries(aliases[kind]))out[k]=findCol(headers,list);
  for(const key of (kind==="po"?["po","item","material","poQty"]:["po","item","material","movement","qty"])){
    if(out[key]<0)throw Error("Nguồn "+kind.toUpperCase()+" thiếu cột bắt buộc: "+aliases[kind][key][0]);
  }
  return out;
}
function cell(row,col){return col<0?"":row[col]??""}
function buildReport(poData,grData,allow105=false){
  const p=mapFields(poData,"po"),g=mapFields(grData,"gr");
  const grByKey=new Map(),seen=new Set();
  let ignored=0,duplicates=0,invalidQty=0,unitMismatches=0;
  const signs={"101":1,"102":-1};if(allow105){signs["105"]=1;signs["106"]=-1}
  for(const raw of grData.slice(1)){
    if(!Array.isArray(raw))continue;
    const po=normalizeCode(cell(raw,g.po)),item=itemCode(cell(raw,g.item)),
      material=normalizeCode(cell(raw,g.material)),movement=String(cell(raw,g.movement)).trim();
    if(!po||!item||!material||!(movement in signs)){ignored++;continue}
    const doc=normalizeCode(cell(raw,g.doc)),docItem=itemCode(cell(raw,g.docItem));
    const date=excelDate(cell(raw,g.date)),dedup=doc?doc+"|"+docItem+"|"+date:"";
    if(dedup&&seen.has(dedup)){duplicates++;continue}
    if(dedup)seen.add(dedup);
    const qty=number(cell(raw,g.qty));
    // Retain invalid transactions in the journal and invalidate their PO line.
    // Dropping one would make an unknown receipt look like zero received.
    if(!Number.isFinite(qty))invalidQty++;
    const entry={date,doc,docItem,movement,qty:Math.abs(qty)*signs[movement],
      unit:String(cell(raw,g.unit)).trim(),bill:String(cell(raw,g.bill)).trim(),
      material,po,item};
    const key=po+"|"+item;
    if(!grByKey.has(key))grByKey.set(key,[]);
    grByKey.get(key).push(entry);
  }
  const rows=[];let mismatch=0,invalidDate=0;
  let excludedPO=0;
  for(const raw of poData.slice(1)){
    if(!Array.isArray(raw))continue;
    const po=normalizeCode(cell(raw,p.po));
    // Always read the complete PO.js dataset, then retain purchase orders
    // whose document number starts with 48. Do not filter by pending status.
    if(!po.startsWith("48")){excludedPO++;continue}
    const item=itemCode(cell(raw,p.item)),
      material=normalizeCode(cell(raw,p.material));
    // Keep every 48* PO row even when Item/Material is missing. Surface the
    // incomplete record as "Cần kiểm tra" rather than silently dropping it.
    const poDate=excelDate(cell(raw,p.poDate));
    if(!poDate)invalidDate++;
    const related=(grByKey.get(po+"|"+item)||[]).filter(x=>{
      const exact=x.material.toUpperCase()===material.toUpperCase();
      if(!exact)mismatch++;
      return exact;
    }).sort((a,b)=>b.date.localeCompare(a.date)||b.doc.localeCompare(a.doc));
    const ordered=number(cell(raw,p.poQty));
    const poQty=Number.isFinite(ordered)?ordered:NaN;
    const unit=String(cell(raw,p.unit)).trim();
    const unitMismatch=related.some(r=>!unitCode(unit)||!unitCode(r.unit)||unitCode(r.unit)!==unitCode(unit));
    if(unitMismatch)unitMismatches++;
    const grQty=unitMismatch?NaN:related.reduce((sum,r)=>sum+r.qty,0);
    const issues=[];
    if(!item||!material)issues.push("Thiếu Item hoặc mã vật tư");
    if(!Number.isFinite(poQty)||poQty<=0)issues.push("Số lượng PO không hợp lệ");
    if(unitMismatch)issues.push("Đơn vị PO/GR khác nhau hoặc còn thiếu; chưa có hệ số quy đổi");
    if(related.some(r=>!Number.isFinite(r.qty)))issues.push("Số lượng GR không hợp lệ");
    if(grQty<0)issues.push("Số lượng GR âm");
    const latest=related.find(x=>x.date)?.date||"";
    const bill=(related.find(x=>x.bill)||{}).bill||"";
    const row={po,item,material,description:String(cell(raw,p.description)).trim(),
      poDate,poQty,grQty,latestGr:latest,bill,
      key:po+"|"+item+"|"+material,age:daysOld(poDate),
      percent:!issues.length&&Number.isFinite(poQty)&&poQty>0?grQty/poQty*100:NaN,
      remain:!issues.length&&Number.isFinite(poQty)?Math.max(0,poQty-grQty):NaN,
      supplier:String(cell(raw,p.supplier)).trim(),plant:String(cell(raw,p.plant)).trim(),
      buyer:String(cell(raw,p.buyer)).trim(),unit,unitMismatch,issues,
      netPrice:number(cell(raw,p.netPrice)),currency:String(cell(raw,p.currency)).trim(),
      receipts:related};
    row.status=!item||!material?"invalid":calculateStatus(row);
    row.searchText=[row.po,row.item,row.material,row.description,row.supplier,
      row.buyer,row.plant,row.bill,row.key].join(" ").toLocaleLowerCase();
    rows.push(row);
  }
  return {rows,ignored,duplicates,mismatch,invalidDate,invalidQty,unitMismatches,excludedPO,totalPO:poData.length-1,totalGR:grData.length-1};
}
function pct(v){return Number.isFinite(v)?numeric.format(v)+"%":"—"}
function statusText(s){return {none:"Chưa nhận",partial:"Nhận một phần",done:"Đã đủ",excess:"Nhận vượt",invalid:"Cần kiểm tra"}[s]||s}
function sortValue(r,key){if(key==="lastGr")return r.latestGr;return r[key]}
function searchMatch(r,value){
  const terms=value.split(/[,;\n|]+/).map(t=>t.trim().toLocaleLowerCase()).filter(Boolean);
  if(!terms.length)return true;
  const text=r.searchText||[r.po,r.item,r.material,r.description,r.supplier,
    r.buyer,r.plant,r.bill,r.key].join(" ").toLocaleLowerCase();
  return terms.some(term=>text.includes(term));
}
function filteredRows(rows,options){
  return rows.filter(r=>{
    if(!searchMatch(r,options.query||""))return false;
    if(options.status==="pending"&&!(r.status==="none"||r.status==="partial"||r.status==="invalid"))return false;
    if(options.status!=="all"&&options.status!=="pending"&&options.status!==r.status)return false;
    if(options.supplier&&r.supplier!==options.supplier)return false;
    if(options.from&&(!r.poDate||r.poDate<options.from))return false;
    if(options.to&&(!r.poDate||r.poDate>options.to))return false;
    if(options.overdue&&!(r.status!=="done"&&r.status!=="excess"&&r.age>=60))return false;
    return true;
  });
}
function options(){return {query:id("search").value,status:id("status-filter").value,
  supplier:id("supplier-filter").value,
  from:id("date-from").value,to:id("date-to").value,overdue:id("overdue-only").checked}}
function sortRows(rows,key,dir){const d=dir==="asc"?1:-1;return rows.slice().sort((a,b)=>{
  const x=sortValue(a,key),y=sortValue(b,key);
  if(typeof x==="number"||typeof y==="number"){
    const ax=Number.isFinite(x)?x:-Infinity,bx=Number.isFinite(y)?y:-Infinity;
    return (ax-bx)*d||a.key.localeCompare(b.key);
  }
  return String(x??"").localeCompare(String(y??""),"vi",{numeric:true})*d||a.key.localeCompare(b.key);
})}
function updateSelect(name,items,all){
  const select=id(name),current=select.value;select.replaceChildren(new Option(all,""));
  for(const v of [...new Set(items)].filter(Boolean).sort((a,b)=>a.localeCompare(b,"vi",{numeric:true})))
    select.add(new Option(v,v));
  select.value=[...select.options].some(o=>o.value===current)?current:"";
}
function updateQuickTabs(){

// Extract the trailing WK code from File Name, e.g. ..._WK31.xlsx -> WK31.
// File Name stays intact for details and export. A missing/invalid code is blank.
function requestWeekFromFile(filename){
  const base=String(filename??"").trim().split(/[\\/]/).pop()
    .replace(/\.(?:xlsx|xls|xlsm|csv)$/i,"").trim();
  const matched=/(?:^|[_\s.\-])WK[\s_\-]*([0-5]?\d)\s*$/i.exec(base);
  if(!matched)return "";
  const number=Number(matched[1]);
  return number>=1&&number<=53?"WK"+String(number).padStart(2,"0"):"";
}
function buildRequestReport(source,poRows,opts={}){
  if(!Array.isArray(source)||!Array.isArray(source[0]))
    throw Error("Request.js không có dòng tiêu đề.");
  const header=source[0],cols={};
  for(const [key,names] of Object.entries(REQUEST_COLUMNS))
    cols[key]=findCol(header,names);
  for(const key of ["sap","date","qty","status","po"]){
    if(cols[key]<0)throw Error("Request.js thiếu cột: "+REQUEST_COLUMNS[key][0]);
  }
  const byPO=new Map();
  for(const p of poRows||[]){
    const po=normalizeCode(p.po);
    if(!byPO.has(po))byPO.set(po,[]);
    byPO.get(po).push(p);
  }
  const rows=[];
  for(let i=1;i<source.length;i++){
    const raw=source[i];if(!Array.isArray(raw))continue;
    const c=key=>cols[key]>=0?raw[cols[key]]??"":"";
    const sap=normalizeCode(c("sap")),po=normalizeCode(c("po"));
    const matchesPO=po&&opts.poReady?byPO.get(po)||[]:[];
    const matches=matchesPO.filter(p=>normalizeCode(p.material)===sap);
    const linked=matches.length>0;
    const units=new Set(matches.map(p=>unitCode(p.unit)));
    const unitMismatch=units.size>1||matches.some(p=>p.unitMismatch);
    const invalidPO=matches.some(p=>!Number.isFinite(p.poQty)||p.poQty<=0||!p.item||!p.material);
    const invalidGR=matches.some(p=>!Number.isFinite(p.grQty));
    const negativeGR=matches.some(p=>p.grQty<0);
    const poQty=linked&&!invalidPO&&units.size<=1?matches.reduce((sum,p)=>sum+p.poQty,0):NaN;
    const grQty=linked&&opts.grReady&&!unitMismatch&&!invalidGR?
      matches.reduce((sum,p)=>sum+p.grQty,0):NaN;
    const percent=Number.isFinite(poQty)&&poQty>0&&Number.isFinite(grQty)?
      grQty/poQty*100:NaN;
    const link=!sap?"invalid":!po?"missing":!opts.poReady?"unverified":
      !matchesPO.length?"unavailable":!linked?"mismatch":
      invalidPO?"data-invalid":!opts.grReady?"gr-unavailable":
      unitMismatch?"unit-mismatch":invalidGR?"data-invalid":negativeGR?"negative":
      grQty<=0?"no-gr":grQty<poQty-1e-8?"partial":"complete";
    const r={
      index:i-1,file:String(c("file")).trim(),week:requestWeekFromFile(c("file")),rowNo:String(c("rowNo")).trim(),

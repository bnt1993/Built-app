  description:["Description"],stock:["Stock"],reorder:["Reorder Point"],
  lot:["Lot size of reorder"],qty:["Qty need to order","Required Qty"],
  unit:["Unit"],price:["Price(EUR)"],amount:["Amount(EUR)"],
  orderType:["OrderType"],note:["Note"],supplier:["Supplier"],
  hall:["Hall"],status:["Status"],po:["PO No.","PO No","Purchase order"],
  orderedDate:["Ordered date","PO date"]
};
const REQUEST_LINK_LABELS={
  missing:"Chưa ghi số PO",
  unverified:"Chưa tải dữ liệu PO",
  unavailable:"PO chưa có trong PO.js",
  mismatch:"PO khác mã SAP",
  "gr-unavailable":"Có PO · chưa tải GR.js",

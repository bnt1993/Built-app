    function veLichSuVatTu() {
      const total=materialHistoryRows.length;
      materialHistoryPage=Math.max(1,Math.min(materialHistoryPage,
        Math.max(1,Math.ceil(total/MATERIAL_HISTORY_PAGE_SIZE))));
      const visibleColumns=cotHienThiLichSuVatTu();
      const dateColumn=cotNgayLichSuVatTu();
      const sortableHeader=(name,index,active)=>{
        const label=index===-1?tuDien("historyDirection"):tenCotHistoryDaDich(name);
        const sortTitle=tuDien("historySortBy",{column:label});
        const order=active?(materialHistorySortDirection<0?"descending":"ascending"):"none";
        const arrow=active?(materialHistorySortDirection<0?"↓":"↑"):"↕";
        return '<th aria-sort="'+order+'"><button type="button" class="material-history-sort-trigger" '+
          'onclick="doiSapXepLichSuVatTu('+index+')" title="'+thoatHTML(sortTitle)+
          '" aria-label="'+thoatHTML(sortTitle)+'"><span>'+thoatHTML(label)+
          '</span><span class="material-history-sort-arrow" aria-hidden="true">'+arrow+'</span></button></th>';
      };
      const activeIndex=materialHistorySortColumn===-2&&dateColumn>=0?dateColumn:materialHistorySortColumn;
      document.getElementById("material-history-head").innerHTML=historyColumns.length?
        "<tr>"+sortableHeader("",-1,activeIndex===-1)+
        visibleColumns.map(col=>sortableHeader(col.name,col.index,activeIndex===col.index)).join("")+"</tr>":"";
      document.getElementById("material-history-body").innerHTML=
        htmlDongLichSuVatTu(materialHistoryRows.slice(0,
          materialHistoryPage*MATERIAL_HISTORY_PAGE_SIZE))||
        '<tr><td class="empty-table" colspan="'+Math.max(1,visibleColumns.length+1)+'">'+
        thoatHTML(tuDien(historyLoading?"historyLoading":historyLoaded?"noResults":historyStatusKey))+"</td></tr>";
      capNhatPhanTrangLichSuVatTu();
    }

    function doiTrangLichSuVatTu(step) {
      const max=Math.max(1,Math.ceil(materialHistoryRows.length/MATERIAL_HISTORY_PAGE_SIZE));
      const next=Math.max(1,Math.min(max,materialHistoryPage+step));
      if(next===materialHistoryPage)return;
      const table=document.querySelector(".material-history-table");
      if(next>materialHistoryPage) {
        const start=materialHistoryPage*MATERIAL_HISTORY_PAGE_SIZE;
        document.getElementById("material-history-body").insertAdjacentHTML("beforeend",
          htmlDongLichSuVatTu(materialHistoryRows.slice(start,
            Math.min(next*MATERIAL_HISTORY_PAGE_SIZE,materialHistoryRows.length))));
        materialHistoryPage=next;
        capNhatPhanTrangLichSuVatTu();
      } else {
        materialHistoryPage=next;
        veLichSuVatTu();
        table.scrollTop=Math.max(0,Math.min(table.scrollTop,table.scrollHeight-table.clientHeight));
      }
    }


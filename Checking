      const cotCuoi = soCotNguon + (themThanhTien ? 1 : 0);
      const dongCuoi = 6 + src.length + (themThanhTien ? 2 : 0);
      if (dongCuoi > 1048576 || cotCuoi > 16384 || cotCuoi < 1) throw new Error("XLSX_EXCEL_LIMIT");

      materialHistoryExporting=true;
      button.disabled=true;
      button.setAttribute("aria-busy","true");
      caption.textContent=tuDien("exportGenerating");
      try {
        await new Promise(resolve=>setTimeout(resolve,0));
        const blob=await taoBaoCaoLichSuXlsx();

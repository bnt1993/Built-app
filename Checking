    // Match SAP source columns by normalized header, not their display order.
    function cotTheoTenTimKiem(aliases,fallback=-1) {
      const normalize=name=>chuanHoaTimKiem(name).replace(/[^a-z0-9]/g,"");
      const accepted=new Set(aliases.map(normalize));
      const index=tieuDeCot.findIndex(name=>accepted.has(normalize(name)));
      return index>=0?index:(fallback>=0&&fallback<tieuDeCot.length?fallback:-1);
    }

    // BM comes from a named source column. No index fallback to unrelated fields.
    function chiSoCotBmChinhXac() {
      const aliases=["BM No","BM No.","BM Number","BM Code","BM",
        "B/M No","B.M. No","BM Material","BM Material No","Mã BM","Mã số BM"];
      const normalize=name=>chuanHoaTimKiem(name).replace(/[^a-z0-9]/g,"");
      const accepted=new Set(aliases.map(normalize));
      const candidates=tieuDeCot.map((name,index)=>({name:normalize(name),index}))
        .filter(x=>accepted.has(x.name));
      if(!candidates.length)return -1;
      if(candidates.length===1)return candidates[0].index;
      const sample=tatCaDuLieu.slice(1,Math.min(tatCaDuLieu.length,201));
      const score=index=>sample.reduce((count,row)=>
        count+(Array.isArray(row)&&String(row[index]??"").trim()?1:0),0);
      candidates.sort((a,b)=>score(b.index)-score(a.index)||a.index-b.index);
      return candidates[0].index;
    }

    function khopTuKhoaVatTu(muc,term,scope,ganDung) {
      const keyword=chuanHoaTimKiem(term).trim();
      if(!keyword)return true;
      const text=muc[scope]||"";
      if(text.includes(keyword))return true;
      // Part numbers may contain spaces, hyphens, slashes or dots. Compare the
      // compact form only for code searches; descriptions retain phrase matching.
      if(/\d/.test(keyword)){
        const compact=keyword.replace(/[^a-z0-9]/g,"");
        if(compact.length>=3){
          const candidates=scope==="all"?[muc.sapCompact,muc.partCompact,muc.bmCompact]:
            scope==="sap"?[muc.sapCompact]:
            scope==="part"?[muc.partCompact]:
            scope==="bmno"?[muc.bmCompact]:[];
          if(candidates.some(value=>value&&value.includes(compact)))return true;
        }
      }
      return ganDung&&coTuGanDung(text,keyword);
    }

    function coTuGanDung(chuoi,tuKhoa) {
      if (tuKhoa.length < 4 || tuKhoa.length > 48) return false;
      const words = chuanHoaTimKiem(chuoi).split(/[^a-z0-9]+/).filter(Boolean);
      return words.some(word => Math.abs(word.length-tuKhoa.length)<=1 && trungGanDung(word,tuKhoa));
    }


    const maSapDaLapChiMuc=new Set();

    // One search box handles a phrase or many SAP codes separated by comma,
    // semicolon, pipe, newline or spaces for code-like tokens.
    function phanTichTimKiem(value, scope) {
      const raw=String(value??"").trim();
      if(!raw) return {terms:[],exactSap:null};
      const explicitlySeparated=/[,;|\r\n]/.test(raw);
      let parts=explicitlySeparated ? raw.split(/[,;|\r\n]+/) : [raw];
      if(!explicitlySeparated) {
        const words=raw.split(/\s+/).filter(Boolean);
        const lookLikeCodes=words.length>1&&words.every(x=>
          /^[a-z0-9._-]+$/i.test(x)&&/\d/.test(x));
        const verifiedSapCodes=lookLikeCodes&&words.every(x=>
          maSapDaLapChiMuc.has(chuanHoaMaSap(x).toLowerCase()));
        // "all" must not mistake a multipart part number for several SAP codes.
        if(words.length>1&&(scope==="sap"||(scope==="all"&&verifiedSapCodes)))
          parts=words;
      }
      const terms=[...new Set(parts.map(x=>chuanHoaTimKiem(x).trim()).filter(Boolean))].slice(0,2000);
      // Multi-code searches use exact SAP matches. Other multi-keyword
      // searches keep the existing substring/typo-tolerant OR semantics.
      const sapList=terms.length>1&&(scope==="all"||scope==="sap")&&
        terms.every(x=>/^[a-z0-9._-]+$/i.test(x)&&/\d/.test(x)&&
          (scope==="sap"||maSapDaLapChiMuc.has(chuanHoaMaSap(x).toLowerCase())))
        ? new Set(terms.map(x=>chuanHoaMaSap(x).toLowerCase())):null;
      return {terms,exactSap:sapList};
    }

    // Browsers have single-line search inputs: normalize a pasted SAP column.
    function xuLyDanTimKiem(e) {
      const paste=e.clipboardData?.getData("text/plain") || "";
      if(!/[\r\n\t]/.test(paste))return;
      e.preventDefault();
      const field=e.target;
      const start=field.selectionStart??field.value.length;
      const end=field.selectionEnd??field.value.length;
      field.setRangeText(paste.replace(/[\r\n\t]+/g,", "),start,end,"end");
      yeuCauLocDuLieu();
    }


    // History.js is a real optional source, loaded on demand. There is no
    // inferred transaction history from snapshots or stock balances.
    const DUONG_DAN_HISTORY="History.js";
    let historyColumns=[];
    let historyAll=[];
    let historyLoaded=false;
    let historyLoading=false;
    let historySeq=0;
    let historyStatusKey="historyIdle";

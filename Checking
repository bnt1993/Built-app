    // Lập chỉ mục theo nhóm, tránh khóa giao diện với bảng dữ liệu lớn.
    function taoChiMucTimKiem() {
      const lanHienTai = ++lanLapChiMuc;
      const chiSoBmNo=chiSoCotBmChinhXac();
      const chiSoPart=cotTheoTenTimKiem([
        "Part No","Part No.","Part Number","Part Nr","Part #",
        "Part Code","Mã phụ tùng","Mã phụ kiện"
      ],tieuDeCot.length>5?5:2);
      const chiSoSap=cotTheoTenTimKiem([
        "Material","Material Number","SAP","SAP Code","Mã SAP","Mã vật tư"
      ],0);
      const chiSoMoTa=cotTheoTenTimKiem([
        "Material Description","Description","Mô tả","Mô tả vật tư"
      ],1);
      // Prefer named headers; keep the existing quantity column position as a fallback.
      const cotSoLuong = tieuDeCot.findIndex(x =>
        ["quantity", "qty", "số lượng", "stock", "stock qty", "on hand", "tồn kho"].includes(String(x ?? "").trim().toLowerCase()));
      chiSoSoLuong = cotSoLuong >= 0 ? cotSoLuong : 3;
      chiSoReorderPoint = cotReorderPoint();
      analyticsReady = false;
      const chiSoGia = tieuDeCot.findIndex(x =>
        ["price", "unit price", "đơn giá", "giá"].includes(String(x ?? "").trim().toLowerCase()));
      let giaTriDaTinh = 0;
      let soDongGiaKhongHopLe = 0;
      duLieuTimKiem = [];
      maSapDaLapChiMuc.clear();
      soCoTonKho = 0;
      chiMucSanSang = false;
      dangLocDuLieu = true;
      let viTri = 1;
      const tong = Math.max(0, tatCaDuLieu.length - 1);
      document.getElementById("metric-total").textContent = dinhDangSoLuong.format(tong);
      document.getElementById("metric-instock").textContent = "…";
      document.getElementById("metric-attention").textContent = "…";
      tongGiaTriTonKho = null;
      soDongGiaTriKhongHopLe = 0;
      document.getElementById("metric-inventory-value").textContent = "…";
      document.getElementById("metric-value-note").textContent = tuDien("inventoryValueNote");
      document.getElementById("trang-thai-ban-ghi").textContent = tuDien("processing");
      document.getElementById("than-bang").innerHTML =
        '<tr><td colspan="6" class="empty-table">' + tuDien("preparing") + '</td></tr>';

      function xuLyNhom() {
        if (lanHienTai !== lanLapChiMuc) return;
        const gioiHan = Math.min(viTri + 1000, tatCaDuLieu.length);
        for (; viTri < gioiHan; viTri++) {
          const dong = tatCaDuLieu[viTri];
          if (!Array.isArray(dong)) continue;
          const giaTri = dong.map(ten=>chuanHoaTimKiem(ten));
          const sap=giaTri[chiSoSap]||"";
          const part=chiSoPart>=0?giaTri[chiSoPart]||"":"";
          const bmno=chiSoBmNo>=0?giaTri[chiSoBmNo]||"":"";
          const compactCode=value=>value.replace(/[^a-z0-9]/g,"");
          if(sap)maSapDaLapChiMuc.add(chuanHoaMaSap(dong[chiSoSap]).toLowerCase());
          const soLuong = chuyenThanhSo(dong[chiSoSoLuong]);
          const coTonKho = soLuong > 0;
          const reorderPoint = chiSoReorderPoint >= 0 ? chuyenThanhSo(dong[chiSoReorderPoint]) : NaN;
          const trangThaiTon = trangThaiTheoReorderPoint(soLuong, reorderPoint);
          if (coTonKho) soCoTonKho++;
          // Inventory valuation uses all rows, independent of the active search/filter.
          // Do not count empty stock or non-numeric/negative prices as monetary value.
          let giaTriDong = 0;
          if (chiSoGia >= 0 && coTonKho) {
            const donGia = chuyenThanhSo(dong[chiSoGia]);
            const thanhTien = soLuong * donGia;
            if (Number.isFinite(donGia) && donGia >= 0 && Number.isFinite(thanhTien)) {
              giaTriDaTinh += thanhTien;
              giaTriDong = thanhTien;
            } else {
              soDongGiaKhongHopLe++;
            }
          }
          duLieuTimKiem.push({
            chiSo: viTri,
            dong: dong,
            all: giaTri.join("\u0001"),
            sap, desc:chiSoMoTa>=0?giaTri[chiSoMoTa]||"":"",
            part,bmno,
            sapCompact:compactCode(sap),
            partCompact:compactCode(part),
            bmCompact:compactCode(bmno),
            coTonKho: coTonKho, soLuong, reorderPoint, trangThaiTon, giaTriDong
          });
        }
        if (viTri < tatCaDuLieu.length) {
          setTimeout(xuLyNhom, 0);
        } else {
          chiMucSanSang = true;
          tongGiaTriTonKho = chiSoGia < 0 ? null : giaTriDaTinh;
          soDongGiaTriKhongHopLe = soDongGiaKhongHopLe;
          document.getElementById("metric-instock").textContent = dinhDangSoLuong.format(soCoTonKho);
          hienThiTongGiaTriKho();
          analyticsReady=true;
          capNhatThongKeNangCao();
          luuAnhChupKho();
          dongBoChiTietDaChon();
          locDuLieu();
        }
      }
      xuLyNhom();
    }

    let boTriHoanTimKiem = null;
    let dangLocDuLieu = false;
    function yeuCauLocDuLieu() {
      clearTimeout(boTriHoanTimKiem);
      dangLocDuLieu = true;
      ++soLanLocDuLieu;
      trangHienTai = 1;
      boTriHoanTimKiem = setTimeout(locDuLieu, 170);
    }

    // Lọc theo từng nhịp animation frame và hủy các truy vấn đã lỗi thời.
    function locDuLieu() {
      clearTimeout(boTriHoanTimKiem);
      boTriHoanTimKiem = null;
      if (!chiMucSanSang) return;
      dangLocDuLieu = true;
      const tuKhoa = chuanHoaTimKiem(document.getElementById("o-tim-kiem").value.trim());
      const cheDoTim = document.querySelector('input[name="truongTim"]:checked').value;
      const chiTonKho = document.getElementById("chk-ton-kho").checked;
      const locCanhBao=document.getElementById("loc-canh-bao").value;
      const {terms:nhieuTuKhoa,exactSap:danhSachSap}=phanTichTimKiem(tuKhoa,cheDoTim);
      const ganDung=document.getElementById("tim-gan-dung").checked;
      const truongTim = cheDoTim === "all" ? "all" : cheDoTim;
      const lanLocHienTai = ++soLanLocDuLieu;
      const moi = [];
      let viTri = 0;
      const tong = duLieuTimKiem.length;
      document.getElementById("trang-thai-ban-ghi").textContent = tuDien("searching");

      function xuLyNhom() {
        if (lanLocHienTai !== soLanLocDuLieu) return;
        const gioiHan = Math.min(viTri + 2500, tong);
        for (; viTri < gioiHan; viTri++) {
          const muc = duLieuTimKiem[viTri];
          const hopTuKhoa=danhSachSap
            ? danhSachSap.has(chuanHoaMaSap(muc.dong[0]).toLowerCase())
            : !tuKhoa||nhieuTuKhoa.some(term=>
                khopTuKhoaVatTu(muc,term,truongTim,ganDung));
          if (hopTuKhoa && (!chiTonKho || muc.coTonKho) &&
              (locCanhBao==="all" || muc.trangThaiTon===locCanhBao)) moi.push(muc);
        }
        if (viTri < tong) {
          requestAnimationFrame(xuLyNhom);
          return;
        }
        ketQuaLoc = moi;
        sapXepKetQua();
        dangLocDuLieu = false;
        hienThiTrangHienTai();
        document.querySelector(".table-wrapper").scrollTop = 0;
        document.getElementById("trang-thai-ban-ghi").textContent =
          tuDien("records",{found:dinhDangSoLuong.format(ketQuaLoc.length), total:dinhDangSoLuong.format(tong)});

      }
      xuLyNhom();
    }

    function sapXepTheoCot(chiSoCot) {
      if (cotSapXep === chiSoCot) huongSapXep *= -1;
      else { cotSapXep = chiSoCot; huongSapXep = 1; }
      trangHienTai = 1;
      veTieuDe();
      locDuLieu();
    }

    function sapXepKetQua() {
      if (cotSapXep < 0) return;
      ketQuaLoc.sort((a, b) => {
        const giaTriA = String(a.dong[cotSapXep] ?? "").trim();
        const giaTriB = String(b.dong[cotSapXep] ?? "").trim();
        const soA = chuyenThanhSo(giaTriA);
        const soB = chuyenThanhSo(giaTriB);
        let ketQua;

        if (giaTriA === "" && giaTriB !== "") {
          ketQua = 1;
        } else if (giaTriA !== "" && giaTriB === "") {
          ketQua = -1;
        } else if (Number.isFinite(soA) && Number.isFinite(soB)) {
          ketQua = soA - soB;
        } else {
          ketQua = giaTriA.localeCompare(giaTriB, "vi", {
            numeric: true,
            sensitivity: "base"
          });
        }

        return ketQua * huongSapXep;
      });
    }

    function hienThiTrangHienTai() {
      const tongSoTrang = Math.max(1, Math.ceil(ketQuaLoc.length / SO_DONG_MOI_TRANG));
      if (trangHienTai > tongSoTrang) trangHienTai = tongSoTrang;
      const batDau = (trangHienTai - 1) * SO_DONG_MOI_TRANG;
      const mucTrenTrang = ketQuaLoc.slice(batDau, batDau + SO_DONG_MOI_TRANG);
      const html = mucTrenTrang.map(muc => {
        const selectedClass = muc.chiSo === dongDangChonIndex ? "selected" : "";
        const selectedAria = muc.chiSo === dongDangChonIndex ? "true" : "false";
        const o = COT_HIEN_THI.map(chiSoCot => {
          const giaTri = thoatHTML(hienThiGiaTri(chiSoCot, muc.dong[chiSoCot]));
          if (chiSoCot === 0) {
            const sap=chuanHoaMaSap(muc.dong[0]);
            const tip=tuDien("sapTooltip",{code:sap});
            return '<td><span class="sap-code" title="'+thoatHTML(tip)+'" aria-label="'+thoatHTML(tip)+'">' +
              giaTri + '</span></td>';
          }
          if (chiSoCot === chiSoSoLuong) {
            const trangThai=muc.trangThaiTon||"unknown";
            const tooltip=tuDien("detailStatusTooltip",{
              status:tenTrangThaiTon(trangThai),
              stock:String(muc.dong[chiSoSoLuong]??"—"),
              reorder:Number.isFinite(muc.reorderPoint)?dinhDangSoLuong.format(muc.reorderPoint):"—"
            });
            return '<td><span class="stock-badge stock-'+trangThai+'" title="'+thoatHTML(tooltip)+'" aria-label="'+thoatHTML(tooltip)+'">' +
              (trangThai==="zero"?'⚠ ':'')+giaTri+'</span></td>';
          }
          return '<td>' + giaTri + '</td>';
        }).join("");
        return '<tr class="' + selectedClass + (muc.coTonKho ? '' : ' out-of-stock') + '" data-row-index="' + muc.chiSo +
          '" tabindex="0" aria-selected="' + selectedAria +
          '" onclick="chonDong(' + muc.chiSo + ', this)" ondblclick="moLichSuVatTu(' + muc.chiSo + ')">' + o + '</tr>';
      }).join("");

      document.getElementById("than-bang").innerHTML = html ||
        '<tr><td colspan="6" class="empty-table">' + tuDien("noResults") + '</td></tr>';
      capNhatDieuKhienPhanTrang();
    }

    function doiTrang(buoc) {
      denTrang(trangHienTai+buoc);
    }

    // Bottom-of-table auto-pagination. A small cooldown prevents one touch
    // gesture or a programmatic scroll reset from skipping several pages.
    let viTriCuonBangCu = 0;
    let mocChuyenTrangTuDong = 0;

    function xuLyCuonCuoiBang() {
      const vungBang = document.querySelector(".table-wrapper");
      if (!vungBang) return;
      const viTriHienTai = vungBang.scrollTop;
      const dangCuonXuong = viTriHienTai > viTriCuonBangCu + 1;
      viTriCuonBangCu = viTriHienTai;
      if (!dangCuonXuong || Date.now() < mocChuyenTrangTuDong) return;

      // Do not turn pages when the table is shorter than the scroll region.
      if (vungBang.scrollHeight <= vungBang.clientHeight + 24) return;
      const tongTrang = Math.max(1, Math.ceil(ketQuaLoc.length / SO_DONG_MOI_TRANG));
      if (trangHienTai >= tongTrang) return;
      if (viTriHienTai + vungBang.clientHeight < vungBang.scrollHeight - 24) return;

      mocChuyenTrangTuDong = Date.now() + 650;
      doiTrang(1);  // Preserves the existing Next/Previous button behavior.
      viTriCuonBangCu = 0;
    }

    function chonDongBangPhim(buoc) {
      if (ketQuaLoc.length === 0) return;

      const viTriHienTai = ketQuaLoc.findIndex(muc => muc.chiSo === dongDangChonIndex);
      let viTriMoi = viTriHienTai < 0
        ? (buoc > 0 ? 0 : ketQuaLoc.length - 1)
        : viTriHienTai + buoc;

      if (viTriMoi < 0 || viTriMoi >= ketQuaLoc.length) return;

      trangHienTai = Math.floor(viTriMoi / SO_DONG_MOI_TRANG) + 1;
      hienThiTrangHienTai();

      const mucMoi = ketQuaLoc[viTriMoi];
      const dongMoi = document.querySelector(
        '#than-bang tr[data-row-index="' + mucMoi.chiSo + '"]'
      );
      if (!dongMoi) return;

      chonDong(mucMoi.chiSo, dongMoi);
      dongMoi.scrollIntoView({ block: "nearest" });
    }

    function hienThiChiTiet(dongData) {
      let htmlChiTiet = "";
      const chiSoBm=chiSoCotBmChinhXac();
      for (let c = 0; c < tieuDeCot.length; c++) {
        if(c===chiSoBm)continue;
        htmlChiTiet+='<div class="detail-item" data-col-index="'+c+'"><label>'+
          thoatHTML(tenCotDaDich(tieuDeCot[c]))+'</label><span>'+
          thoatHTML(hienThiGiaTri(c,dongData[c]))+'</span></div>';
      }
      const luoiChiTiet = document.getElementById("luoi-chi-tiet");
      const cardBmNo = document.getElementById("bm-no-card");
      cardBmNo.remove();
      luoiChiTiet.innerHTML = htmlChiTiet;
      // Keep Part No before Storage Bin regardless of their order in the source.
      const partIndex=cotTheoTenTimKiem([
        "Part No","Part No.","Part Number","Part Nr","Part #",
        "Part Code","Mã phụ tùng","Mã phụ kiện"
      ],tieuDeCot.length>5?5:2);
      const binIndex=tieuDeCot.findIndex(name=>
        ["storage bin","storagebin","vị trí lưu kho"].includes(String(name??"").trim().toLowerCase()));
      if(partIndex>=0&&binIndex>=0&&partIndex!==binIndex) {
        const part=luoiChiTiet.querySelector('.detail-item[data-col-index="'+partIndex+'"]');
        const bin=luoiChiTiet.querySelector('.detail-item[data-col-index="'+binIndex+'"]');
        if(part&&bin)bin.before(part);
      }
      luoiChiTiet.appendChild(cardBmNo);
      capNhatCardBmNo(dongData);
      hienThiCardTongQuanVatTu(dongData);
    }

    function dongBoChiTietDaChon() {
      const row=dongDangChonIndex>0?tatCaDuLieu[dongDangChonIndex]:null;
      const sap=row?chuanHoaMaSap(row[0]):"";
      const label=document.getElementById("nhan-sap");
      label.textContent=row?tuDien("sapCode",{code:sap}):tuDien("noSelectedSap");
      label.title=row?tuDien("sapTooltip",{code:sap}):"";
      document.getElementById("chi-tiet-trong").style.display=row?"none":"";
      if(row)hienThiChiTiet(row);
      else {
        const bm=document.getElementById("bm-no-card");bm.remove();
        document.getElementById("luoi-chi-tiet").replaceChildren(bm);
        document.getElementById("bm-no-list").replaceChildren();
        for(const id of ["detail-stock-value","detail-stock-status","detail-last-output"]){
          document.getElementById(id).textContent="—";
          document.getElementById(id+"-note").textContent="";
        }
      }
      taiBoSuuTapAnh(sap);
    }

    function chonDong(index, element) {
      document.querySelectorAll("#than-bang tr").forEach(tr => {
        tr.classList.remove("selected");
        tr.setAttribute("aria-selected", "false");
      });
      element.classList.add("selected");
      element.setAttribute("aria-selected", "true");
      dongDangChonIndex = index;

      const dongData = tatCaDuLieu[index];
      const maSap = chuanHoaMaSap(dongData[0]); // Cột đầu tiên là Mã SAP
      document.getElementById("nhan-sap").textContent = tuDien("sapCode",{code:maSap || "—"});
      document.getElementById("nhan-sap").title=tuDien("sapTooltip",{code:maSap||"—"});
      document.getElementById("chi-tiet-trong").style.display = "none";

      // Keep image/navigation state intact when re-rendering translated details.
      hienThiChiTiet(dongData);
      // Load history lazily once after the first Stock selection, for the last OUTPUT date.
      if(!daThuTaiHistoryChoCard&&!historyLoaded) {
        daThuTaiHistoryChoCard=true;
        taiHistory(false);
      }

      // Tải hình ảnh tương ứng với Mã SAP
      taiBoSuuTapAnh(maSap);
      if (window.matchMedia("(max-width: 900px)").matches) {
        document.querySelector(".detail-section").scrollIntoView({ behavior: "smooth", block: "start" });
      }
    }

    let lanTaiAnh = 0;
    let dangQuetAnh = false;
    const boNhoAnh = new Map();
    const dangKiemTraAnh = new Map();
    const boNhoBoSuuTap = new Map();

    // HEAD kiểm tra tên tệp mà không tải toàn bộ ảnh. Fallback Image() nếu
    // chạy file://, ổ mạng, hoặc server không hỗ trợ HEAD.
    function kiemTraAnh(url) {
      const daLuu = boNhoAnh.get(url);
      if (daLuu && daLuu.hetHan > Date.now()) return Promise.resolve(daLuu.coAnh);
      if (dangKiemTraAnh.has(url)) return dangKiemTraAnh.get(url);

      const tacVu = (async function() {
        let coAnh;
        if (location.protocol === "http:" || location.protocol === "https:") {
          const controller = new AbortController();
          const gioiHan = setTimeout(() => controller.abort(), 3000);
          try {
            const response = await fetch(url, {
              method: "HEAD", cache: "force-cache", signal: controller.signal
            });
            if (response.status === 404) {
              coAnh = false;
            } else if (response.ok) {
              const loai = (response.headers.get("content-type") || "").toLowerCase();
              coAnh = !loai || loai.startsWith("image/") || loai.includes("octet-stream");
            }
          } catch (e) {
            // Trình duyệt hoặc server không hỗ trợ HEAD: thử Image().
          } finally {
            clearTimeout(gioiHan);
          }
        }

        if (coAnh === undefined) {
          coAnh = await new Promise(resolve => {
            const img = new Image();
            let xong = false;
            const gioiHan = setTimeout(() => ketThuc(false), 5000);
            function ketThuc(ok) {
              if (xong) return;
              xong = true;
              clearTimeout(gioiHan);
              img.onload = null;
              img.onerror = null;
              resolve(ok);
            }
            img.onload = () => ketThuc(true);
            img.onerror = () => ketThuc(false);
            img.src = url;
          });
        }

        boNhoAnh.set(url, {
          coAnh: coAnh, hetHan: Date.now() + (coAnh ? 600000 : 60000)
        });
        if (boNhoAnh.size > 600) boNhoAnh.delete(boNhoAnh.keys().next().value);
        return coAnh;
      })();

      dangKiemTraAnh.set(url, tacVu);
      return tacVu.finally(() => dangKiemTraAnh.delete(url));
    }

    // Optional Material/manifest.json: {"SAP001":["SAP001_01.jpg","SAP001_02.png"]}.
    // A manifest avoids up to 22 HEAD requests per SAP; missing files fall back to scanning.
    let promiseManifestAnh = null;
    const bienTheAnh=new Map();
    function taiManifestAnh() {
      if(window.MaterialImageManifest&&typeof window.MaterialImageManifest==="object")
        return Promise.resolve(window.MaterialImageManifest);
      if(!promiseManifestAnh) {
        promiseManifestAnh=new Promise(resolve=>{
          const script=document.createElement("script");
          let done=false;
          const finish=value=>{if(done)return;done=true;clearTimeout(timer);script.remove();resolve(value);};
          const timer=setTimeout(()=>finish(null),2500);
          script.src=THU_MUC_HINH+"manifest.js";
          script.onload=()=>finish(window.MaterialImageManifest||null);
          script.onerror=()=>finish(null);
          document.head.appendChild(script);
        }).then(async data=>{
          if(data||!/^https?:$/.test(location.protocol))return data;
          const controller=new AbortController();
          const timer=setTimeout(()=>controller.abort(),2500);
          try {
            const response=await fetch(THU_MUC_HINH+"manifest.json",{cache:"no-cache",signal:controller.signal});
            return response.ok?await response.json():null;
          }catch{return null;}finally{clearTimeout(timer);}
        }).then(data=>data&&typeof data==="object"&&!Array.isArray(data)?data:null);
      }
      return promiseManifestAnh;
    }

    function hinhAnhTuManifest(manifest,sap) {
      if(!manifest)return null;
      const modern=manifest.version===2&&manifest.materials&&typeof manifest.materials==="object";
      const entries=modern?manifest.materials:manifest;
      if(!Object.prototype.hasOwnProperty.call(entries,sap))
        return modern&&manifest.complete===true?[]:null;
      const names=entries[sap];
      if(!Array.isArray(names))return null;
      const valid=name=>typeof name==="string"&&/^(?:_optimized\/)?[a-zA-Z0-9_. -]+\.(?:jpg|jpeg|png|webp)$/i.test(name);
      const url=name=>THU_MUC_HINH+name.split("/").map(encodeURIComponent).join("/");
      const images=[];
      for(const item of names) {
        const original=typeof item==="string"?item:item?.original;
        if(!valid(original))continue;
        const src=url(original);
        bienTheAnh.set(src,{
          preview:valid(item?.preview)?url(item.preview):src,
          thumb:valid(item?.thumb)?url(item.thumb):src
        });
        images.push(src);
      }
      return [...new Set(images)];
    }
    function duongDanAnh(src,kind) {return bienTheAnh.get(src)?.[kind]||src;}
    function ganAnh(img,src,original,priority="auto") {
      if(img.dataset.requested===src)return;
      img.dataset.requested=src;
      img.decoding="async";img.fetchPriority=priority;
      img.onerror=()=>{if(img.dataset.requested===src&&img.getAttribute("src")!==original)img.src=original;};
      img.src=src;
    }

    // Chỉ 4 tác vụ kiểm tra đồng thời, giữ dữ liệu từ SAP đã xem gần đây.
    async function taiBoSuuTapAnh(maSap) {
      const lanHienTai = ++lanTaiAnh;
      maSapDangXem = chuanHoaMaSap(maSap);
      danhSachAnhDangXem = [];
      viTriAnhDangXem = 0;
      dangQuetAnh = Boolean(maSapDangXem);
      capNhatGiaoDienAnh();
      if (!maSapDangXem) return;

      const boDaCo = boNhoBoSuuTap.get(maSapDangXem);
      if (boDaCo && boDaCo.hetHan > Date.now()) {
        danhSachAnhDangXem = boDaCo.urls.slice();
        dangQuetAnh = false;
        capNhatGiaoDienAnh();
        return;
      }

      const manifest=await taiManifestAnh();
      if(lanHienTai!==lanTaiAnh)return;
      const daBiet=hinhAnhTuManifest(manifest,maSapDangXem);
      if(daBiet!==null) {
        danhSachAnhDangXem=daBiet;
        dangQuetAnh=false;
        boNhoBoSuuTap.set(maSapDangXem,{urls:daBiet.slice(),hetHan:Date.now()+300000});
        capNhatGiaoDienAnh();
        return;
      }
      const danhSachTen = [];
      for (let k = 1; k <= SO_ANH_TOI_DA; k++) {
        const hauTo = String(k).padStart(2, "0");
        danhSachTen.push(maSapDangXem + "_" + hauTo + ".jpg");
        danhSachTen.push(maSapDangXem + "_" + hauTo + ".png");
      }
      danhSachTen.push(maSapDangXem + ".jpg", maSapDangXem + ".png");

      const hangDoi = [...new Set(danhSachTen)];
      let viTri = 0;
      async function congNhan() {
        while (viTri < hangDoi.length && lanHienTai === lanTaiAnh) {
          const url = THU_MUC_HINH + encodeURIComponent(hangDoi[viTri++]);
          const tonTai = await kiemTraAnh(url);
          if (tonTai && lanHienTai === lanTaiAnh && !danhSachAnhDangXem.includes(url)) {
            const anhDangChon = danhSachAnhDangXem[viTriAnhDangXem];
            danhSachAnhDangXem.push(url);
            danhSachAnhDangXem.sort();
            viTriAnhDangXem = anhDangChon
              ? danhSachAnhDangXem.indexOf(anhDangChon) : 0;
            capNhatGiaoDienAnh();
          }
        }
      }

      await Promise.all([congNhan(), congNhan(), congNhan(), congNhan()]);
      if (lanHienTai !== lanTaiAnh) return;
      dangQuetAnh = false;
      boNhoBoSuuTap.set(maSapDangXem, {
        urls: danhSachAnhDangXem.slice(),
        hetHan: Date.now() + (danhSachAnhDangXem.length ? 300000 : 60000)
      });
      if (boNhoBoSuuTap.size > 80) boNhoBoSuuTap.delete(boNhoBoSuuTap.keys().next().value);
      capNhatGiaoDienAnh();
    }

    // Chuẩn bị ảnh tiếp theo sau khi chuyển ảnh để thao tác mượt hơn.
    function napTruocAnhKeTiep() {
      if (danhSachAnhDangXem.length < 2) return;
      const url = danhSachAnhDangXem[(viTriAnhDangXem + 1) % danhSachAnhDangXem.length];
      const anh = new Image();
      anh.decoding = "async";
      anh.fetchPriority="low";
      anh.src = duongDanAnh(url,"preview");
    }

    function capNhatAnhThuNho() {
      const holder=document.getElementById("image-thumbnails");
      const key=danhSachAnhDangXem.join("\u0001");
      if(holder.dataset.galleryKey!==key) {
        holder.dataset.galleryKey=key;
        holder.innerHTML="";
        danhSachAnhDangXem.forEach((src,index)=>{
          const btn=document.createElement("button");
          btn.type="button";
          btn.className="image-thumb";
          btn.setAttribute("aria-label", (index+1)+" / "+danhSachAnhDangXem.length);
          const img=document.createElement("img");
          img.alt="";img.loading="lazy";img.width=55;img.height=55;
          ganAnh(img,duongDanAnh(src,"thumb"),src,"low");
          btn.appendChild(img);
          btn.addEventListener("click",()=>{
            viTriAnhDangXem=index;
            capNhatGiaoDienAnh();napTruocAnhKeTiep();
          });
          holder.appendChild(btn);
        });
      }
      [...holder.children].forEach((btn,index)=>
        btn.setAttribute("aria-pressed",String(index===viTriAnhDangXem)));
    }


    function tinhPhanTichDashboard(rows,headers) {
      const priceCol=cotHistoryTheoTen(headers,["Price","Unit Price","Đơn giá","Giá"]);
      const unitCol=cotHistoryTheoTen(headers,["Base Unit of Measure","Unit","UOM","Đơn vị","Đơn vị tính"]);
      const descCol=cotHistoryTheoTen(headers,["Material Description","Description","Mô tả","Mô tả vật tư"]);
      const valueBySap=new Map(),detailsBySap=new Map();
      let total=0,missingPrice=0,inStock=0,attention=0;
      for(const rec of rows) {
        const qty=rec.soLuong;
        const price=priceCol>=0?chuyenThanhSo(rec.dong[priceCol]):NaN;
        const validPrice=Number.isFinite(price)&&price>=0;
        const sap=chuanHoaMaSap(rec.dong[0])||"—";
        if(Number.isFinite(qty)&&qty>0) {
          inStock++;
          const description=descCol>=0?String(rec.dong[descCol]??"").trim():"";
          const unit=unitCol>=0?String(rec.dong[unitCol]??"").trim().toUpperCase():"";
          let d=detailsBySap.get(sap);
          if(!d) {
            d={description,quantity:0,unit:unit||"",inconsistent:false,mixed:false,missing:false};
            detailsBySap.set(sap,d);
          }
          if(!d.description&&description)d.description=description;
          if(!unit)d.missing=true;
          else if(d.unit&&d.unit!==unit)d.mixed=true;
          if(d.missing||d.mixed)d.inconsistent=true;
          if(unit&&d.unit===unit&&!d.inconsistent)d.quantity+=qty;
          const value=qty*price;
          if(validPrice&&Number.isFinite(value)) {
            total+=value;
            if(value>0) {
              valueBySap.set(sap,(valueBySap.get(sap)||0)+value);
            }
          } else missingPrice++;
        }
        if(["zero","below","at"].includes(rec.trangThaiTon))attention++;

      }
      const rank=map=>[...map].map(([name,value])=>({name,value})).sort(
        (a,b)=>b.value-a.value||a.name.localeCompare(b.name));
      const values=rank(valueBySap).map(x=>({...x,...detailsBySap.get(x.name)}));
      return {count:rows.length,inStock,attention,total:priceCol<0?null:total,missingPrice,
        values};
    }


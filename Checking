    function vePhanBoTrangThai(rows=duLieuTimKiem) {
      const target=document.getElementById("insight-stock-distribution");
      if(!analyticsReady){target.textContent=tuDien("noAnalytics");return}
      const count={healthy:0,at:0,below:0,zero:0,unknown:0};
      for(const record of rows)count[record.trangThaiTon]=(count[record.trangThaiTon]||0)+1;
      const total=rows.length;
      if(!total){target.textContent=tuDien("noAnalytics");return}
      const shades={healthy:"#16a34a",at:"#facc15",below:"#fb923c",zero:"#e11d48",unknown:"#94a3b8"};
      const names={healthy:"stockAbove",at:"stockEqual",below:"stockBelow",zero:"stockZero",unknown:"stockUnknown"};
      let offset=0;
      const sectors=[];
      for(const key of ["healthy","at","below","zero","unknown"]){
        const proportion=100*count[key]/total;
        sectors.push(shades[key]+" "+offset.toFixed(4)+"% "+(offset+proportion).toFixed(4)+"%");
        offset+=proportion;
      }
      const legend=Object.keys(names).map(key=>
        '<div class="dist-row"><span class="dist-swatch" style="background:'+shades[key]+'"></span>'+
        '<span>'+thoatHTML(tuDien(names[key]))+'</span><b>'+dinhDangSoLuong.format(count[key])+'</b></div>').join("");
      target.innerHTML='<div class="stock-donut" role="img" aria-label="'+
        thoatHTML(tuDien("stockDistribution"))+'" style="background:conic-gradient('+sectors.join(",")+')">'+
        '<div class="stock-donut-inner"><strong>'+dinhDangSoLuong.format(total)+'</strong><span>'+
        thoatHTML(tuDien("stockDistributionTotal"))+'</span></div></div>'+
        '<div class="stock-distribution-list">'+legend+'</div>';
    }


    function trungGanDung(mot, hai) {
      if (mot === hai) return true;
      if (Math.abs(mot.length - hai.length) > 1) return false;
      let i=0,j=0,soLoi=0;
      while (i < mot.length && j < hai.length) {
        if (mot[i] === hai[j]) {i++;j++;continue;}
        if (++soLoi > 1) return false;
        if (mot.length > hai.length) i++;
        else if (hai.length > mot.length) j++;
        else {i++;j++;}
      }
      return soLoi + (i<mot.length||j<hai.length ? 1:0) <= 1;
    }


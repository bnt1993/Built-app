    function timNguonHistory() {
      const candidates=[
        "duLieuLichSu","duLieuHistory","duLieuLichSuNhapXuat","lichSuNhapXuat",
        "inventoryTransactions","historyData","HistoryData","HISTORY_DATA",
        "inventoryHistory","historyTransactions","duLieuNhapXuat"
      ];
      for(const key of candidates) {
        const data=window[key];
        if(Array.isArray(data) ||
           (data && typeof data==="object" && !Array.isArray(data) &&
            [data.rows,data.data,data.records,data.transactions].some(Array.isArray))) {
          return data;
        }
      }
      return null;
    }

    function tenHistoryChuan(ten) {
      return String(ten??"").normalize("NFD").replace(/[\u0300-\u036f]/g,"")
        .replace(/đ/g,"d").toLowerCase().replace(/[^a-z0-9]/g,"");
    }
    function tenCotHistoryDaDich(name) {
      const raw=String(name??"");
      if(ngonNguHienTai!=="vi")return raw;
      const names={
        material:"Mã vật tư",materialnumber:"Mã vật tư",
        materialdescription:"Mô tả vật tư",
        postingdate:"Ngày hạch toán",documentdate:"Ngày chứng từ",
        entrydate:"Ngày ghi nhận",transactiondate:"Ngày giao dịch",
        quantity:"Số lượng",qty:"Số lượng",qtyinunitofentry:"Số lượng theo đơn vị",
        unitofentry:"Đơn vị tính",baseunitofmeasure:"Đơn vị cơ sở",
        amtin:"Giá trị (đồng)",amtinloccur:"Giá trị (đồng)",
        amountinlocalcurrency:"Giá trị (đồng)",amtinlocalcurrency:"Giá trị (đồng)",
        costcenter:"Trung tâm chi phí",storagebin:"Vị trí lưu kho",
        storagelocation:"Kho lưu trữ",plant:"Nhà máy",
        movementtype:"Loại giao dịch",movement:"Loại giao dịch",
        materialdocument:"Số chứng từ vật tư",documentnumber:"Số chứng từ",
        documentheadertext:"Nội dung chứng từ",text:"Ghi chú",
        purchaseorder:"Đơn đặt hàng",postingtime:"Giờ hạch toán",
        valuationtype:"Loại định giá",batch:"Lô hàng",user:"Người thực hiện",
        movementqty:"Số lượng giao dịch",quantitychange:"Biến động số lượng"
      };
      return names[tenHistoryChuan(raw)]||tenCotDaDich(raw);
    }
    function cotHistoryTheoTen(headers, aliases) {
      const names=new Set(aliases.map(tenHistoryChuan));
      return headers.findIndex(key=>names.has(tenHistoryChuan(key)));
    }
    function ngayHistoryISO(value) {
      if(value==null || value==="")return "";
      const text=String(value).trim();
      let m=text.match(/^(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})/);
      if(m) return m[1]+"-"+m[2].padStart(2,"0")+"-"+m[3].padStart(2,"0");
      m=text.match(/^(\d{1,2})[/. -](\d{1,2})[/. -](\d{4})/);
      if(m) return m[3]+"-"+m[2].padStart(2,"0")+"-"+m[1].padStart(2,"0");
      if(typeof value==="number" && value>20000 && value<100000) {
        // Excel date serial: Excel day 1 = 1900-01-01 (1900 leap-year quirk).
        return new Date(Date.UTC(1899,11,30)+Math.floor(value)*86400000).toISOString().slice(0,10);
      }
      return "";
    }

    // Use only the Movement value: INPUT = inbound, OUTPUT = outbound;
    // all other values (including SAP movement codes) are "Other".
    function loaiHistory(raw) {
      const movement=String(raw??"").trim().toUpperCase();
      if(movement==="INPUT")return "in";
      if(movement==="OUTPUT")return "out";
      return "unknown";
    }

    function bienDoiHistory(source) {
      let data=source,headers=null;
      if(data && !Array.isArray(data) && typeof data==="object") {
        headers=data.headers||data.columns||data.tieuDeCot||null;
        data=data.rows??data.data??data.records??data.transactions;
      }
      if(!Array.isArray(data))throw Error("HISTORY_BAD_FORMAT");
      if(!data.length) return {headers:Array.isArray(headers)?headers.map(String):[],rows:[]};
      let inputRows=data;
      if(Array.isArray(inputRows[0])) {
        if(!Array.isArray(headers)) {headers=inputRows[0];inputRows=inputRows.slice(1);}
        const maxLength=Math.max(headers.length,...inputRows.slice(0,100).map(r=>Array.isArray(r)?r.length:0));
        const names=Array.from({length:maxLength},(_,i)=>String(headers[i]??("Column "+(i+1))));
        const rows=inputRows.filter(Array.isArray);
        return {headers:names,rows};
      }
      if(inputRows[0] && typeof inputRows[0]==="object" && !Array.isArray(inputRows[0])) {
        const names=[];
        const seen=new Set();
        for(const row of inputRows) {
          if(!row || typeof row!=="object" || Array.isArray(row))continue;
          for(const key of Object.keys(row)) {
            if(!seen.has(key)) {seen.add(key);names.push(key);}
          }
        }
        return {headers:names,rows:inputRows.filter(x=>x&&typeof x==="object"&&!Array.isArray(x))
          .map(row=>names.map(name=>row[name]??""))};
      }
      throw Error("HISTORY_BAD_FORMAT");
    }

    function capNhatTrangThaiHistory(key) {
      historyStatusKey=key;
    }

    // Parse the actual 6 MB History.js as *data* rather than executing it.
    // It assigns window.duLieuCongTy, the same global used by data.js for Stock.
    // Parsing protects the live stock source from being overwritten.
    function docHistoryTuVanBan(source) {
      const assignment=/window\.(?:duLieuCongTy|duLieuLichSu|duLieuHistory|lichSuNhapXuat|inventoryTransactions|historyData)\s*=\s*\[/.exec(source);
      if(!assignment)throw Error("HISTORY_BAD_FORMAT");
      const from=assignment.index+assignment[0].length-1;
      const to=source.lastIndexOf("]");
      if(to<=from)throw Error("HISTORY_BAD_FORMAT");
      const data=JSON.parse(source.slice(from,to+1));
      const time=/window\.thoiGianCapNhat\s*=\s*("(?:\\.|[^"\\])*")/.exec(source);
      return {data,updated:time?JSON.parse(time[1]):""};
    }

    async function apDungNguonHistory(source,origin="file",updated="",sequence=historySeq) {
      let parsed;
      try {parsed=bienDoiHistory(source);}
      catch(err){capNhatTrangThaiHistory("historyInvalid");return false;}
      const columns=parsed.headers;
      const postingColumn=cotHistoryTheoTen(columns,["Posting Date","PostingDate","Ngày hạch toán"]);
      const dateColumn=postingColumn>=0?postingColumn:cotHistoryTheoTen(columns,[
        "Date","Document Date","Transaction Date","Datetime",
        "Created At","Ngay","Ngày","Ngày giao dịch"]);
      // Prioritize a literal "Movement" column, then the source's "Movement Type".
      const movementColumn=cotHistoryTheoTen(columns,["Movement"]);
      const typeColumn=movementColumn>=0?movementColumn:cotHistoryTheoTen(columns,[
        "Movement Type","Type","IN/OUT","Transaction Type",
        "Loai","Loại","Loại giao dịch","Nhập/Xuất","Action"]);
      if(!columns.length) {
        capNhatTrangThaiHistory("historyInvalid");
        return false;
      }
      const indexed=[];
      const sapCol=cotHistoryTheoTen(columns,["Material","SAP","SAP Code","Material Number","Mã SAP","Mã vật tư"]);
      const lastOutput=new Map();
      for(let i=0;i<parsed.rows.length;i++) {
        if(sequence!==historySeq)return false;
        const row=parsed.rows[i];
        const cells=row.map(v=>v!==null&&typeof v==="object"?JSON.stringify(v):String(v??""));
        const date=dateColumn>=0?ngayHistoryISO(row[dateColumn]):"";
        const type=loaiHistory(typeColumn>=0?row[typeColumn]:"");
        indexed.push({cells,number:i,date,type});
        if(sapCol>=0&&type==="out"&&ngayHistoryHopLe(date)) {
          const sap=chuanHoaMaSap(row[sapCol]).toLowerCase();
          if(sap&&(!lastOutput.has(sap)||date>lastOutput.get(sap)))lastOutput.set(sap,date);
        }
        if(i>0 && i%1600===0)await new Promise(resolve=>setTimeout(resolve,0));
      }
      if(sequence!==historySeq)return false;
      indexed.sort((a,b)=>(b.date||"").localeCompare(a.date||"") || a.number-b.number);
      historyColumns=columns;
      historyHallCache=null;
      historyTypeColumn=typeColumn;
      historyAll=indexed;
      ngayXuatCuoiTheoSap.clear();
      for(const [sap,date] of lastOutput)ngayXuatCuoiTheoSap.set(sap,date);
      historyLoaded=true;
      capNhatTrangThaiHall();
      capNhatCardNgayXuat();
      veSoSanhNhapXuatKho();
      veTopVatTuXuatKho();
      veVatTuTonLau();
      veBieuDoSuDungKho();
      const total=indexed.length;
      const status=total?(origin==="existing"?"historyLoadedExisting":updated?"historyLoadedAt":"historyLoaded"):"historyEmpty";
      capNhatTrangThaiHistory(status);
      locLichSuVatTu();
      return true;
    }

    // Only the known array assignment is read; no eval/new Function on History.js.
    // Local file:// environments cannot fetch JS text, so they use a temporary
    // script, snapshot both shared globals, then restore Stock immediately.
    function taiHistoryBangScript() {
      return new Promise((resolve,reject)=>{
        const hasStock=Object.prototype.hasOwnProperty.call(window,"duLieuCongTy");
        const hasTime=Object.prototype.hasOwnProperty.call(window,"thoiGianCapNhat");
        const oldStock=window.duLieuCongTy;
        const oldTime=window.thoiGianCapNhat;
        const oldScript=document.getElementById("script-history-data");
        if(oldScript)oldScript.remove();
        const script=document.createElement("script");
        script.id="script-history-data";
        script.async=true;
        script.src=DUONG_DAN_HISTORY+"?t="+Date.now();
        let finished=false;
        const timer=setTimeout(()=>finish(null,Error("HISTORY_TIMEOUT")),18000);
        function restore() {
          if(hasStock)window.duLieuCongTy=oldStock;
          else delete window.duLieuCongTy;
          if(hasTime)window.thoiGianCapNhat=oldTime;
          else delete window.thoiGianCapNhat;
        }
        function finish(data,err) {
          if(finished)return;
          finished=true;
          clearTimeout(timer);
          restore();
          script.remove();
          if(err)reject(err);
          else resolve(data);
        }
        script.onload=()=>{
          const data=window.duLieuCongTy!==oldStock
            ? window.duLieuCongTy:timNguonHistory();
          finish({data,updated:window.thoiGianCapNhat||""},null);
        };
        script.onerror=()=>finish(null,Error("HISTORY_MISSING"));
        document.body.appendChild(script);
      });
    }

    async function taiHistory(force=false) {
      if(historyLoading || (historyLoaded && !force))return;
      historyLoading=true;
      veSoSanhNhapXuatKho();
      veTopVatTuXuatKho();
      veVatTuTonLau();
      const sequence=++historySeq;
      capNhatTrangThaiHistory("historyLoading");
      veBieuDoSuDungKho();
      locLichSuVatTu();
      try{
        let source;
        if(typeof fetch==="function" && location.protocol!=="file:") {
          const response=await fetch(DUONG_DAN_HISTORY+"?t="+Date.now(),{cache:"no-store",priority:"low"});
          if(!response.ok)throw Error("HISTORY_MISSING");
          source=docHistoryTuVanBan(await response.text());
        } else source=await taiHistoryBangScript();
        if(!source.data)throw Error("HISTORY_BAD_FORMAT");
        const ok=await apDungNguonHistory(source.data,"file",source.updated,sequence);
        if(!ok && historyStatusKey==="historyLoading")
          capNhatTrangThaiHistory("historyInvalid");
      }catch(err){
        console.warn("History.js:",err);
        // Preserve the last good History result when a reload fails.
        capNhatTrangThaiHistory(err.message==="HISTORY_BAD_FORMAT"||err instanceof SyntaxError
          ?"historyInvalid":"historyNoSource");
      }finally{
        if(sequence===historySeq) {
          historyLoading=false;
          locLichSuVatTu();
          capNhatCardNgayXuat();
          veBieuDoSuDungKho();
          veSoSanhNhapXuatKho();
          veTopVatTuXuatKho();
          veVatTuTonLau();
        }
      }
    }

    let materialHistorySap="";
    let materialHistoryRows=[];
    let materialHistoryPage=1;
    let materialHistoryReturnFocus=null;
    let materialHistoryStockIndex=-1;
    let materialHistoryCostColumn=-1;
    let materialHistoryScrollQueued=false;
    let materialHistorySortColumn=-2; // -2 = Posting Date; -1 = transaction direction
    let materialHistorySortDirection=-1; // latest first by default
    let materialHistoryExporting=false;
    const MATERIAL_HISTORY_PAGE_SIZE=50;

    // Use calendar months that have fully ended, not the unfinished current month.
    // Consumption sums all OUTPUT quantities; the monthly average uses 12 full months.
    function thongKeConsumptionVatTu(sapRows,stockRow) {
      const qtyColumn=cotHistoryTheoTen(historyColumns,[
        "Qty in unit of entry","Quantity","Qty","Movement Qty","Số lượng",
        "So luong","Quantity Change","Qty Out","Outbound","Số lượng xuất"]);
      const unitColumn=cotHistoryTheoTen(historyColumns,[
        "Unit of Entry","Base Unit of Measure","Unit","UOM","Đơn vị","Đơn vị tính"]);
      const stockUnitColumn=cotHistoryTheoTen(tieuDeCot,[
        "Unit","Stock Unit","Base Unit of Measure","UOM","Đơn vị","Đơn vị tính"]);
      const stockUnit=stockRow&&stockUnitColumn>=0?
        String(stockRow[stockUnitColumn]??"").trim().toUpperCase():"";
      const stock=stockRow?chuyenThanhSo(stockRow[chiSoSoLuong]):NaN;
      const output=sapRows.filter(rec=>rec.type==="out");
      const units=unitColumn>=0?Array.from(new Set(output.map(rec=>
        String(rec.cells[unitColumn]??"").trim().toUpperCase()).filter(Boolean))):[];
      const mixed=units.length>1;
      const unit=mixed?(stockUnit&&units.includes(stockUnit)?stockUnit:""):units[0]||"";
      const hasQuantity=qtyColumn>=0;
      const summable=hasQuantity&&(!mixed||!!unit)&&!(output.length>0&&unitColumn>=0&&!unit);
      const today=new Date();
      const start=new Date(today.getFullYear(),today.getMonth()-12,1);
      const end=new Date(today.getFullYear(),today.getMonth(),1);
      const monthKey=date=>date.getFullYear()+"-"+String(date.getMonth()+1).padStart(2,"0");
      const period=String(start.getMonth()+1).padStart(2,"0")+"/"+start.getFullYear()+
        " – "+String(today.getMonth()||12).padStart(2,"0")+"/"+
        (today.getMonth()?today.getFullYear():today.getFullYear()-1);
      const beginning=monthKey(start),ending=monthKey(end);
      let consumption=0,recent=0,invalid=0;
      const hasDates=sapRows.some(rec=>/^(?:19|20)\d{2}-\d{2}-\d{2}$/.test(rec.date));
      if(summable)for(const rec of output) {
        if(unitColumn>=0&&unit&&String(rec.cells[unitColumn]??"").trim().toUpperCase()!==unit) {
          invalid++;
          continue;
        }
        const raw=rec.cells[qtyColumn];
        const quantity=chuyenThanhSo(raw);
        if(!Number.isFinite(quantity)){invalid++;continue;}
        const used=Math.abs(quantity);
        consumption+=used;
        if(rec.date&&rec.date.slice(0,7)>=beginning&&rec.date.slice(0,7)<ending)
          recent+=used;
      }
      const average=summable&&hasDates?recent/12:NaN;
      // Do not predict with mixed/unknown units or partially invalid output.
      const compatible=unitColumn>=0&&!!unit&&!!stockUnit&&unit===stockUnit&&!mixed&&invalid===0;
      const coverage=summable&&compatible&&Number.isFinite(stock)&&stock>=0&&
        Number.isFinite(average)&&average>0?stock/average:NaN;
      return {consumption:summable?consumption:NaN,average,coverage,
        unit,stock,stockUnit,mixed,invalid,
        hasQuantity,hasDates,period,compatible,outputCount:output.length,
        summable};
    }


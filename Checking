    function sapXepLichSuVatTu() {
      const dateIndex=cotNgayLichSuVatTu();
      const column=materialHistorySortColumn;
      const descending=materialHistorySortDirection<0;
      const collator=new Intl.Collator(ngonNguHienTai==="en"?"en":"vi",{
        numeric:true,sensitivity:"base"
      });
      const isDate=column===-2||(column>=0&&column===dateIndex)||
        (column>=0&&/date|ngay/.test(tenHistoryChuan(historyColumns[column])));
      const isNumeric=column>=0&&/qty|quantity|amount|amt|value|price|soluong|giatri/.test(
        tenHistoryChuan(historyColumns[column]));
      const sortVal=rec=>{
        if(column===-1)return tuDien({
          in:"historyInShort",out:"historyOutShort",unknown:"historyOtherShort"
        }[rec.type]);
        if(isDate) {
          const date=(column===-2||column===dateIndex)?
            rec.date:ngayHistoryISO(rec.cells[column]);
          return ngayHistoryHopLe(date)?date:"";
        }
        return String(rec.cells[column]??"").trim();
      };
      materialHistoryRows.sort((a,b)=>{
        const av=sortVal(a),bv=sortVal(b);
        if(av===""||bv==="") {
          if(av!==bv)return av===""?1:-1;
          return a.number-b.number;
        }
        let comparison=0;
        if(isNumeric){
          const na=chuyenThanhSo(av),nb=chuyenThanhSo(bv);
          comparison=Number.isFinite(na)&&Number.isFinite(nb)?
            Math.sign(na-nb):collator.compare(av,bv);
        }else comparison=collator.compare(av,bv);
        return (descending?-comparison:comparison)||(a.number-b.number);
      });
    }

    function doiSapXepLichSuVatTu(column) {
      const dateIndex=cotNgayLichSuVatTu();
      if(column!==-1&&!cotHienThiLichSuVatTu().some(c=>c.index===column))return;
      const current=materialHistorySortColumn===-2&&dateIndex>=0?dateIndex:materialHistorySortColumn;
      if(current===column)materialHistorySortDirection*=-1;
      else {
        materialHistorySortColumn=column;
        materialHistorySortDirection=column===dateIndex?-1:1;
      }
      if(materialHistorySortColumn===-2&&column!==dateIndex)materialHistorySortColumn=column;
      if(materialHistorySortColumn===-2&&column===dateIndex)materialHistorySortColumn=column;
      materialHistoryPage=1;
      sapXepLichSuVatTu();
      veLichSuVatTu();
      document.querySelector(".material-history-table").scrollTop=0;
    }


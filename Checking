    // Use real posting dates for consumption and saved synchronization snapshots
    // for inventory valuation; never infer missing historical stock balances.
    function nhomKyKho(mode,count,now=new Date()){
      const result=[];
      const today=new Date(Date.UTC(now.getFullYear(),now.getMonth(),now.getDate()));
      for(let i=count-1;i>=0;i--){
        let date=new Date(today),key="",label="",title="";
        if(mode==="week"){
          date.setUTCDate(date.getUTCDate()-(date.getUTCDay()+6)%7-i*7);
          key=date.toISOString().slice(0,10);
          // ISO week number: the Thursday determines the week-year.
          const thursday=new Date(date);thursday.setUTCDate(thursday.getUTCDate()+3);
          const weekYear=thursday.getUTCFullYear();
          const week=Math.ceil(((thursday-new Date(Date.UTC(weekYear,0,1)))/86400000+1)/7);
          label=(ngonNguHienTai==="en"?"Week ":"Tuần ")+week;
          const end=new Date(date);end.setUTCDate(end.getUTCDate()+6);
          title=label+" / "+weekYear+" · "+key+" – "+end.toISOString().slice(0,10);
        }else if(mode==="month"){
          date=new Date(Date.UTC(today.getUTCFullYear(),today.getUTCMonth()-i,1));
          key=date.toISOString().slice(0,7);
          label=String(date.getUTCMonth()+1).padStart(2,"0")+"/"+date.getUTCFullYear();
        }else if(mode==="year"){
          key=String(today.getUTCFullYear()-i);label=key;
        }else{
          date.setUTCDate(date.getUTCDate()-i);
          key=date.toISOString().slice(0,10);
          label=String(date.getUTCDate()).padStart(2,"0")+"/"+
            String(date.getUTCMonth()+1).padStart(2,"0");
        }
        result.push({key,label,title:title||label});
      }
      return result;
    }

    function khoaNhomKho(date,mode){
      if(!ngayHistoryHopLe(date))return "";
      if(mode==="day")return date;
      if(mode==="month")return date.slice(0,7);
      if(mode==="year")return date.slice(0,4);
      const [y,m,d]=date.split("-").map(Number);
      const day=new Date(Date.UTC(y,m-1,d));
      day.setUTCDate(day.getUTCDate()-(day.getUTCDay()+6)%7);
      return day.toISOString().slice(0,10);
    }

    function dinhDangRutGonKho(n){
      if(!Number.isFinite(n))return "—";
      const locale=ngonNguHienTai==="en"?"en-US":"vi-VN";
      const number=new Intl.NumberFormat(locale,{maximumFractionDigits:1});
      const a=Math.abs(n);
      if(a>=1e9)return number.format(n/1e9)+(ngonNguHienTai==="en"?"B":" tỷ");
      if(a>=1e6)return number.format(n/1e6)+(ngonNguHienTai==="en"?"M":" tr");
      if(a>=1e3)return number.format(n/1e3)+"k";
      return number.format(n);
    }


    function nhomKyTrongKhoangKho(mode,range){
      if(!range)return [];
      const byKey=new Map();
      let cursor=range.from,iterations=0;
      while(cursor<=range.to&&iterations++<3654){
        const key=khoaNhomKho(cursor,mode);
        if(!byKey.has(key)){
          let label="",title="";
          if(mode==="week"){
            const start=new Date(key+"T00:00:00Z");
            const thursday=new Date(start);thursday.setUTCDate(thursday.getUTCDate()+3);
            const year=thursday.getUTCFullYear();
            const week=Math.ceil(((thursday-new Date(Date.UTC(year,0,1)))/86400000+1)/7);
            label=(ngonNguHienTai==="en"?"Week ":"Tuần ")+week;
            const finish=congNgayKho(key,6);
            title=key+" – "+finish;
          }else if(mode==="month"){
            const [y,m]=key.split("-");
            label=m+"/"+y;title=label;
          }else if(mode==="year"){label=key;title=key;}
          else{
            const [y,m,d]=key.split("-");label=d+"/"+m;title=d+"/"+m+"/"+y;
          }
          byKey.set(key,{key,label,title});
        }
        cursor=congNgayKho(cursor,1);
      }
      const all=[...byKey.values()];
      const limit=mode==="day"?366:mode==="week"?260:mode==="month"?120:50;
      const selected=all.slice(-limit);
      selected.truncated=all.length>limit;
      return selected;
    }
    function veCotTheoThoiGianKho(id,periods,values,kind){
      const money=kind==="money",usage=kind==="usage";
      const series=periods.map(p=>({...p,value:values.has(p.key)?values.get(p.key):usage?0:null}));
      const max=Math.max(0,...series.map(p=>p.value===null?0:p.value));
      document.getElementById(id).innerHTML='<div class="trend-list">'+series.map(p=>{
        const missing=p.value===null;
        const exact=missing?tuDien("dashValueTrendGap"):
          money?dinhDangGiaTriKho(p.value):dinhDangLuongHistory(p.value);
        const percentage=missing?12:max>0?Math.max(0,100*p.value/max):0;
        return '<div class="trend-column" title="'+thoatHTML(p.title+" · "+exact)+'">'+
          '<span class="trend-amount">'+thoatHTML(missing?"—":dinhDangRutGonKho(p.value))+
          '</span><div class="trend-chart-bar-wrap"><div class="trend-chart-bar'+
          (missing?" missing":usage?" usage":"")+'" style="height:'+
          percentage.toFixed(1)+'%"></div></div><span class="trend-period">'+
          thoatHTML(p.label)+'</span></div>';
      }).join("")+'</div>';
      const plot=document.getElementById(id);plot.scrollLeft=plot.scrollWidth;
    }

    function tinhGiaTriNhapXuat(rows,headers,mode,buckets) {
      const amountCol=cotHistoryTheoTen(headers,["Amt.In","Amt.in loc.cur.",
        "Amt in local currency","Amount in local currency","Amount LC","Amount"]);
      const values=new Map(buckets.map(p=>[p.key,{in:0,out:0}]));
      let count=0,invalid=0,incoming=0,outgoing=0;
      if(amountCol<0)return {missing:true,values,count,invalid,incoming,outgoing};
      for(const row of rows){
        if(row.type!=="in"&&row.type!=="out")continue;
        if(!ngayHistoryHopLe(row.date)){invalid++;continue;}
        const key=khoaNhomKho(row.date,mode);
        if(!values.has(key))continue;
        const amount=chuyenThanhSo(row.cells[amountCol]);
        if(!Number.isFinite(amount)){invalid++;continue;}
        const value=Math.abs(amount);
        values.get(key)[row.type]+=value;
        if(row.type==="in")incoming+=value;else outgoing+=value;
        count++;
      }
      return {missing:false,values,count,invalid,incoming,outgoing};
    }


    function ngayDiaPhuongISO(date=new Date()){
      return date.getFullYear()+"-"+String(date.getMonth()+1).padStart(2,"0")+
        "-"+String(date.getDate()).padStart(2,"0");
    }
    function congNgayKho(iso,days){
      const [y,m,d]=iso.split("-").map(Number);
      const date=new Date(Date.UTC(y,m-1,d+days));
      return date.toISOString().slice(0,10);
    }
    function khoangNgayKho(from,to){
      const a=new Date(from+"T00:00:00Z"),b=new Date(to+"T00:00:00Z");
      return Math.round((b-a)/86400000)+1;
    }

    function layKyPhanTichKho(now=new Date()){
      const today=ngayDiaPhuongISO(now),todayYear=now.getFullYear();
      const mode=document.getElementById("dashboard-range-mode").value;
      let from="",to="",prevFrom="",prevTo="";
      if(mode==="week"){
        to=today;from=congNgayKho(to,-6);
        prevTo=congNgayKho(from,-1);prevFrom=congNgayKho(prevTo,-6);
      }else if(mode==="month"){
        from=today.slice(0,7)+"-01";to=today;
        const [y,m]=from.split("-").map(Number);
        const p=new Date(Date.UTC(y,m-2,1));
        prevFrom=p.toISOString().slice(0,10);
        const elapsed=khoangNgayKho(from,to);
        const lastDay=new Date(Date.UTC(p.getUTCFullYear(),p.getUTCMonth()+1,0)).getUTCDate();
        prevTo=congNgayKho(prevFrom,Math.min(elapsed,lastDay)-1);
      }else if(mode==="year"){
        const yearFrom=Number(document.getElementById("dashboard-range-year-from").value);
        const yearTo=Number(document.getElementById("dashboard-range-year-to").value);
        const yearSpan=yearTo-yearFrom+1;
        if(!Number.isInteger(yearFrom)||!Number.isInteger(yearTo)||
          yearFrom<2000||yearTo>2100||yearTo>todayYear||
          yearFrom>yearTo||yearSpan>10)return null;
        from=yearFrom+"-01-01";
        to=yearTo===todayYear?today:yearTo+"-12-31";
        // Compare with the immediately preceding, equally many calendar years.
        // For an ongoing year, cap the comparison at the same month and day.
        const priorEndYear=yearFrom-1;
        prevFrom=(yearFrom-yearSpan)+"-01-01";
        prevTo=yearTo===todayYear?
          priorEndYear+"-"+today.slice(5):priorEndYear+"-12-31";
        if(!ngayHistoryHopLe(prevTo))prevTo=priorEndYear+"-02-28";
      }else if(mode==="custom"){
        from=document.getElementById("dashboard-range-from").value;
        to=document.getElementById("dashboard-range-to").value;
        if(!ngayHistoryHopLe(from)||!ngayHistoryHopLe(to)||from>to)return null;
        const days=khoangNgayKho(from,to);
        if(days>3653)return null;
        prevTo=congNgayKho(from,-1);
        prevFrom=congNgayKho(prevTo,-days+1);
      }else return null;
      return {mode,from,to,prevFrom,prevTo};
    }

    function doiKyPhanTichKho(){
      const mode=document.getElementById("dashboard-range-mode").value;
      document.getElementById("dashboard-range-year-field").hidden=mode!=="year";
      document.getElementById("dashboard-range-year-end-field").hidden=mode!=="year";
      document.getElementById("dashboard-range-from-field").hidden=mode!=="custom";
      document.getElementById("dashboard-range-to-field").hidden=mode!=="custom";
      const range=layKyPhanTichKho();
      const startYear=Number(document.getElementById("dashboard-range-year-from").value);
      const endYear=Number(document.getElementById("dashboard-range-year-to").value);
      const beyondLimit=mode==="year"&&Number.isInteger(startYear)&&
        Number.isInteger(endYear)&&endYear-startYear+1>10;
      document.getElementById("dashboard-range-summary").textContent=range?
        tuDien("dashboardTimeCurrent",{from:range.from,to:range.to}):
        tuDien(beyondLimit?"dashboardTimeYearLimit":"dashboardTimeInvalid");
      veSoSanhNhapXuatKho();
      veTopVatTuXuatKho();
      veBieuDoSuDungKho();
      veBieuDoGiaTriKho();
    }

    // Storage Location is resolved by header, never by position: History.js may
    // insert this column before Posting Date. Unknown codes stay unclassified.
    function cotStorageLocation(headers){
      return cotHistoryTheoTen(headers,["Storage Location","Storage Loc.","StorageLoc",
        "SLoc","Storage Location Code","Vị trí kho","Kho lưu trữ","Khu vực kho"]);
    }
    function hallTuStorageLocation(value){
      const key=tenHistoryChuan(value);
      if(["hall1","h1","khu1","nhakho1"].includes(key))return "hall1";
      if(["hall2","h2","khu2","nhakho2"].includes(key))return "hall2";
      return "";
    }
    function hallDangLoc(){
      return document.getElementById("dashboard-hall").value||"all";
    }
    function coCotHistoryHall(){
      return cotStorageLocation(historyColumns)>=0;
    }
    function coCotStockHall(){
      return cotStorageLocation(tieuDeCot)>=0;
    }
    let historyHallCache=null;
    let stockHallCache=null;
    function lichSuTheoHall(){
      const hall=hallDangLoc();
      if(hall==="all")return historyAll;
      const index=cotStorageLocation(historyColumns);
      if(index<0)return null;
      if(historyHallCache&&historyHallCache.records===historyAll&&
        historyHallCache.index===index&&historyHallCache.hall===hall)
        return historyHallCache.rows;
      const rows=historyAll.filter(rec=>hallTuStorageLocation(rec.cells[index])===hall);
      historyHallCache={records:historyAll,index,hall,rows};
      return rows;
    }
    function tonKhoTheoHall(){
      const hall=hallDangLoc();
      if(hall==="all")return duLieuTimKiem;
      const index=cotStorageLocation(tieuDeCot);
      if(index<0)return null;
      if(stockHallCache&&stockHallCache.records===duLieuTimKiem&&
        stockHallCache.index===index&&stockHallCache.hall===hall)
        return stockHallCache.rows;
      const rows=duLieuTimKiem.filter(rec=>hallTuStorageLocation(rec.dong[index])===hall);
      stockHallCache={records:duLieuTimKiem,index,hall,rows};
      return rows;
    }
    function capNhatTrangThaiHall(){
      const note=document.getElementById("dashboard-hall-status");
      const hall=hallDangLoc();
      if(hall==="all"){note.textContent="";return;}
      const alerts=[];
      if(!coCotStockHall())alerts.push(tuDien("dashboardHallNoStockColumn"));
      if(historyLoaded&&!coCotHistoryHall())alerts.push(tuDien("dashboardHallNoHistoryColumn"));
      note.textContent=alerts.join(" · ")||tuDien("dashboardQuantitySource");
    }
    function doiLocHallPhanTich(){
      historyHallCache=null;stockHallCache=null;
      dashboardOutCache=null;dashboardDormantCache=null;
      dashboardTableState.out.page=1;dashboardTableState.dormant.page=1;
      document.getElementById("dashboard-out-min").value="0";
      capNhatTrangThaiHall();
      if(analyticsReady)capNhatThongKeNangCao();
      else {
        veSoSanhNhapXuatKho();veTopVatTuXuatKho();
        veVatTuTonLau();veBieuDoSuDungKho();veBieuDoGiaTriKho();
      }
    }

    function locGiaoDichKho(range,types=["in","out"]){
      if(!historyLoaded||!range)return [];
      const scope=lichSuTheoHall();
      if(!scope)return [];
      return scope.filter(rec=>types.includes(rec.type)&&
        ngayHistoryHopLe(rec.date)&&rec.date>=range.from&&rec.date<=range.to);
    }

    function cotGiaTriLichSuKho(){
      return cotHistoryTheoTen(historyColumns,[
        "Amt.In","Amt.in loc.cur.","Amt in local currency",
        "Amount in local currency","Amount LC","Amount"]);
    }
    function cotSoLuongHistoryDungCot(){
      return cotHistoryTheoTen(historyColumns,["Qty in unit of entry"]);
    }
    function cotMaSapLichSuKho(){
      return cotHistoryTheoTen(historyColumns,[
        "Material","SAP","SAP Code","Material Number","Material Code",
        "Mã SAP","Mã vật tư"]);
    }
    function tongNhapXuatTrongKhoang(range,amountCol){
      const sum={in:0,out:0,inCount:0,outCount:0,invalid:0};
      if(!range||amountCol<0)return sum;
      for(const rec of locGiaoDichKho(range)){
        const raw=String(rec.cells[amountCol]??"").trim();
        const value=raw?chuyenThanhSo(raw):NaN;
        if(!Number.isFinite(value)){sum.invalid++;continue;}
        sum[rec.type]+=Math.abs(value);
        sum[rec.type+"Count"]++;
      }
      return sum;
    }
    function hienThiThayDoiKho(type,current,previous){
      const amount=document.getElementById("dashboard-compare-"+type+"-current");
      const change=document.getElementById("dashboard-compare-"+type+"-change");
      const prior=document.getElementById("dashboard-compare-"+type+"-prior");
      amount.textContent=dinhDangGiaTriKho(current);
      prior.textContent=tuDien("dashboardComparePrevious")+": "+dinhDangGiaTriKho(previous);
      change.dataset.change="none";
      if(previous===0){
        change.textContent=current>0?tuDien("dashboardCompareNew"):"—";
        change.title=tuDien("dashboardCompareNoPrevious");
      }else{
        const percent=(current-previous)/previous*100;
        change.textContent=(percent>0?"+":"")+
          new Intl.NumberFormat(ngonNguHienTai==="en"?"en-US":"vi-VN",
            {maximumFractionDigits:1}).format(percent)+"%";
        change.dataset.change=percent>0?"up":percent<0?"down":"none";
        change.title=change.textContent;
      }
    }
    function veSoSanhNhapXuatKho(){
      const root=document.getElementById("dashboard-compare-note");
      const header=document.getElementById("dashboard-compare-periods");
      const range=layKyPhanTichKho();
      if(!range){
        header.textContent=tuDien("dashboardTimeInvalid");
        root.textContent=tuDien("dashboardTimeInvalid");
        for(const type of ["in","out"]){
          document.getElementById("dashboard-compare-"+type+"-current").textContent="—";
          document.getElementById("dashboard-compare-"+type+"-prior").textContent="";
          document.getElementById("dashboard-compare-"+type+"-change").textContent="—";
        }
        return;
      }
      header.textContent=range.from+" – "+range.to+"  /  "+range.prevFrom+" – "+range.prevTo;
      if(!historyLoaded){
        root.textContent=tuDien(historyLoading?"dashboardHistoryLoading":"dashboardCompareNoHistory");
        return;
      }
      if(!lichSuTheoHall()){
        root.textContent=tuDien("dashboardHallNoHistoryColumn");
        for(const type of ["in","out"]){
          document.getElementById("dashboard-compare-"+type+"-current").textContent="—";
          document.getElementById("dashboard-compare-"+type+"-prior").textContent="";
          document.getElementById("dashboard-compare-"+type+"-change").textContent="—";
        }
        return;
      }
      const amountCol=cotGiaTriLichSuKho();
      if(amountCol<0){root.textContent=tuDien("dashUsageNoQty");return;}
      const now=tongNhapXuatTrongKhoang(range,amountCol);
      const before=tongNhapXuatTrongKhoang({from:range.prevFrom,to:range.prevTo},amountCol);
      hienThiThayDoiKho("in",now.in,before.in);
      hienThiThayDoiKho("out",now.out,before.out);
      root.textContent=tuDien("dashboardCompareNote")+
        (now.invalid+before.invalid?" · "+
        tuDien("dashboardCompareInvalid",{count:now.invalid+before.invalid}):"");
    }


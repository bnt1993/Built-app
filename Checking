      e.preventDefault();
      const field=e.target;
      const start=field.selectionStart??field.value.length;
      const end=field.selectionEnd??field.value.length;
      field.setRangeText(paste.replace(/[\r\n\t]+/g,", "),start,end,"end");
      yeuCauLocDuLieu();
    }


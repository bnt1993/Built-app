    let ngonNguHienTai = "vi";
    let giaoDienHienTai = "light";

    function tuDien(key, values = {}) {
      const text = NGON_NGU[ngonNguHienTai][key] ?? NGON_NGU.vi[key] ?? key;
      return String(text).replace(/\{([a-zA-Z]+)\}/g, (_, variable) =>
        Object.prototype.hasOwnProperty.call(values, variable) ? String(values[variable]) : "{" + variable + "}");
    }

    function ghiTuyChon(key, value) {
      try { localStorage.setItem(key, value); } catch (_) { /* file:// / private browsing */ }
    }
    function docTuyChon(key) {
      try { return localStorage.getItem(key); } catch (_) { return null; }
    }

    function tenCotDaDich(tenCot) {
      const ten = String(tenCot ?? "");
      const k = ten.trim().toLowerCase();
      const key = {
        "sap":"colSap", "sap code":"colSap", "mã sap":"colSap",
        "description":"colDescription", "mô tả":"colDescription",
        "part no":"colPart", "part no.":"colPart", "part number":"colPart",
        "quantity":"colQuantity", "qty":"colQuantity", "số lượng":"colQuantity",
        "price":"colPrice", "giá":"colPrice", "bm no":"colBm",
        "unit":"colUnit", "đơn vị":"colUnit", "group":"colGroup", "nhóm":"colGroup"
      }[k];
      return key ? tuDien(key) : ten;
    }

    function apDungNgonNgu() {
      document.documentElement.lang = ngonNguHienTai;
      document.querySelectorAll("[data-i18n]").forEach(el => {
        el.textContent = tuDien(el.dataset.i18n);
      });
      for (const [selector, attribute, key] of [
        ["[data-i18n-placeholder]","placeholder","i18nPlaceholder"],
        ["[data-i18n-title]","title","i18nTitle"],
        ["[data-i18n-aria]","aria-label","i18nAria"],
        ["[data-i18n-alt]","alt","i18nAlt"]
      ]) {
        document.querySelectorAll(selector).forEach(el =>
          el.setAttribute(attribute, tuDien(el.dataset[key]))
        );
      }
      document.getElementById("lang-vi").setAttribute("aria-pressed", String(ngonNguHienTai === "vi"));
      document.getElementById("lang-en").setAttribute("aria-pressed", String(ngonNguHienTai === "en"));
      document.getElementById("theme-toggle").setAttribute("aria-label",
        tuDien(giaoDienHienTai === "dark" ? "themeToLight" : "themeToDark"));
      document.getElementById("theme-toggle").title =
        tuDien(giaoDienHienTai === "dark" ? "themeToLight" : "themeToDark");
      const trangThai = document.getElementById("tinh-trang-du-lieu");
      trangThai.textContent = tuDien(trangThai.dataset.status || "statusConnecting");
      const capNhat = document.getElementById("trang-thai-cap-nhat");
      if (capNhat.dataset.messageKey) capNhat.textContent = tuDien(capNhat.dataset.messageKey, {
        time: capNhat.dataset.updateTime || "", file: duongDanOMang
      });

      if (tieuDeCot.length) veTieuDe();
      if (chiMucSanSang) {
        hienThiTrangHienTai();
        document.getElementById("trang-thai-ban-ghi").textContent = tuDien("records", {
          found: dinhDangSoLuong.format(ketQuaLoc.length),
          total: dinhDangSoLuong.format(duLieuTimKiem.length)
        });
      }
      const idDaChon = dongDangChonIndex;
      if (idDaChon >= 0 && tatCaDuLieu[idDaChon]) {
        document.getElementById("nhan-sap").textContent =
          tuDien("sapCode",{code:chuanHoaMaSap(tatCaDuLieu[idDaChon][0]) || "—"});
        hienThiChiTiet(tatCaDuLieu[idDaChon]);
      } else {
        document.getElementById("nhan-sap").textContent = tuDien("noSelectedSap");
      }
      document.getElementById("thong-tin-trang").textContent = tuDien("page", {
        current: trangHienTai, total: Math.max(1,Math.ceil(ketQuaLoc.length / SO_DONG_MOI_TRANG))
      });
      capNhatGiaoDienAnh();
      if (chiMucSanSang) {hienThiTongGiaTriKho();capNhatThongKeNangCao();}
      chuyenTab(tabHienTai,{persist:false,skipHistory:true});
      capNhatNgonNguHistory();
      kiemTraNhacBaoCao();
      if (!tatCaDuLieu.length) document.getElementById("trang-thai-cap-nhat").textContent = tuDien("loadingSource");
    }


    // Tabs switch views without reloading or losing stock search/gallery state.
    let tabHienTai="stock";
    const CAC_TAB=["stock","dashboard","history"];
    function chuyenTab(tab, opts={}) {
      if(!CAC_TAB.includes(tab))return;
      tabHienTai=tab;
      for(const name of CAC_TAB){
        const pane=document.getElementById("view-"+name);
        const button=document.getElementById("tab-"+name);
        const selected=name===tab;
        pane.hidden=!selected;
        button.setAttribute("aria-selected",String(selected));
        button.setAttribute("tabindex",selected?"0":"-1");
        button.classList.toggle("active",selected);
      }
      document.querySelector(".breadcrumbs .active").textContent=tuDien(
        tab==="stock"?"tabStock":tab==="dashboard"?"tabDashboard":"tabHistory");
      if(opts.persist!==false)ghiTuyChon("checking-active-tab",tab);
      if(tab==="dashboard"&&analyticsReady)capNhatThongKeNangCao();
      if(tab==="history"&&!opts.skipHistory)taiHistory(false);
    }

    function xuLyPhimTab(event) {

    function datSoDongMoiTrang(value) {
      const raw=String(value??"").trim(),number=Number(raw);
      if(!raw||!Number.isFinite(number)||!Number.isInteger(number)||number<1) {
        capNhatDieuKhienPhanTrang();return;
      }
      const oldOffset=(trangHienTai-1)*SO_DONG_MOI_TRANG;
      SO_DONG_MOI_TRANG=Math.min(number,SO_DONG_TRANG_TOI_DA);
      trangHienTai=Math.floor(oldOffset/SO_DONG_MOI_TRANG)+1;
      ghiTuyChon("checking-rows-per-page",String(SO_DONG_MOI_TRANG));
      hienThiTrangHienTai();
      document.querySelector(".table-wrapper").scrollTop=0;
    }

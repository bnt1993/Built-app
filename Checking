    #view-dashboard .dashboard-compare-delta[data-change="down"] { color:#16875a; }
    #view-dashboard .dashboard-table-chart { height:375px; }
    #view-dashboard .dashboard-table-chart .dashboard-chart-body { overflow:auto; }
    #view-dashboard .dashboard-detail-table { width:100%; border-collapse:collapse; font-size:11px; }
    #view-dashboard .dashboard-detail-table th {
      position:sticky; top:0; background:var(--app-panel); border-bottom:1px solid var(--line);
      color:var(--muted); font-size:10px; font-weight:750; padding:8px 6px;
      text-align:left; white-space:nowrap;
    }
    #view-dashboard .dashboard-detail-table td {
      padding:7px 6px; border-bottom:1px solid var(--line); vertical-align:top;
    }
    #view-dashboard .dashboard-detail-table td:last-child,
    #view-dashboard .dashboard-detail-table th:last-child { text-align:right; }
    #view-dashboard .dashboard-detail-table tr[data-material-index] { cursor:pointer; }
    #view-dashboard .dashboard-detail-table tr[data-material-index]:hover td { background:var(--app-hover); }
    #view-dashboard .dashboard-detail-table tr[data-material-index]:focus-visible td {
      outline:1px solid var(--blue);
    }
    #view-dashboard .dashboard-detail-table .material-name {
      display:block; color:var(--muted); font-size:10px; overflow-wrap:anywhere;
    }
    #view-dashboard .dashboard-detail-table .material-sap { font-weight:800; }
    @media(max-width:700px) {
      #view-dashboard .dashboard-period-intro { flex:1 1 100%; }
      #view-dashboard .dashboard-compare-grid { grid-template-columns:1fr; }
      #view-dashboard .dashboard-table-chart { height:360px; }
    }

    #view-dashboard #dashboard-range-year-field input,
    #view-dashboard #dashboard-range-year-end-field input {
      width:96px; min-width:88px; max-width:96px;
      font-variant-numeric:tabular-nums;
    }
    @media(max-width:620px){
      #view-dashboard #dashboard-range-year-field,
      #view-dashboard #dashboard-range-year-end-field { flex:0 1 calc(50% - 6px); }
      #view-dashboard #dashboard-range-year-field input,
      #view-dashboard #dashboard-range-year-end-field input {
        width:100%; max-width:130px;
      }
    }

    /* Compact independent pagination on the two material analytics tables. */
    #view-dashboard .dashboard-table-chart {
      height:430px; min-height:0; display:flex; flex-direction:column;
    }
    #view-dashboard .dashboard-table-chart .dashboard-chart-body {
      flex:1 1 0; min-height:0; overflow:auto; overscroll-behavior:contain;
    }
    #view-dashboard .dashboard-mini-pager {
      display:flex; flex:0 0 auto; flex-wrap:wrap; gap:6px 9px;
      justify-content:space-between; align-items:center;
      padding:8px 0 4px; border-top:1px solid var(--line);
    }
    #view-dashboard .dashboard-mini-size,
    #view-dashboard .dashboard-mini-page {
      display:flex; align-items:center; gap:4px 6px; flex-wrap:wrap;
      font-size:10px; color:var(--muted); font-weight:650;
    }
    #view-dashboard .dashboard-mini-pager input,
    #view-dashboard .dashboard-mini-pager select {
      background:var(--app-field); color:var(--ink); border:1px solid var(--line);
      border-radius:6px; min-height:28px; padding:3px 5px;
      font:inherit; font-size:11px; font-variant-numeric:tabular-nums;
    }
    #view-dashboard .dashboard-mini-size select { width:61px; }
    #view-dashboard .dashboard-mini-size input { width:52px; }
    #view-dashboard .dashboard-mini-page input { width:46px; text-align:center; }
    #view-dashboard .dashboard-mini-page button {
      min-width:27px; min-height:28px; border:1px solid var(--line);
      border-radius:6px; background:var(--app-field); color:var(--ink);
      font:inherit; font-size:13px; cursor:pointer;
    }
    #view-dashboard .dashboard-mini-page button:hover:not(:disabled) {
      background:var(--app-hover); border-color:var(--blue);
    }
    #view-dashboard .dashboard-mini-page button:disabled { opacity:.35; cursor:default; }
    #view-dashboard .dashboard-out-range {
      display:flex; flex:0 0 auto; flex-wrap:wrap; align-items:center;
      gap:5px 9px; margin:5px 0 8px; font-size:11px; color:var(--muted);
      font-weight:700;
    }
    #view-dashboard .dashboard-out-range input[type="range"] {
      flex:1 1 115px; width:100px; min-width:72px;
      accent-color:var(--blue); cursor:pointer;
    }
    #view-dashboard .dashboard-out-range input[type="range"]:disabled { opacity:.4; }
    #view-dashboard .dashboard-out-range output {
      color:var(--ink); min-width:75px; text-align:right;
      font-variant-numeric:tabular-nums;
    }
    #view-dashboard .dashboard-detail-table td:nth-child(2),
    #view-dashboard .dashboard-detail-table td:nth-child(3),
    #view-dashboard .dashboard-detail-table th:nth-child(2),
    #view-dashboard .dashboard-detail-table th:nth-child(3) {
      text-align:right; white-space:nowrap; font-variant-numeric:tabular-nums;
    }
    #view-dashboard .dashboard-table-chart > p.insight-note:last-child {
      flex:0 0 auto; margin:5px 0 0; min-height:17px;
      font-size:10px; overflow:hidden; text-overflow:ellipsis;
    }
    @media(max-width:700px) {
      #view-dashboard .dashboard-table-chart { height:430px; }
      #view-dashboard .dashboard-mini-size { flex:1 1 100%; }
    }

    #view-dashboard .dashboard-hall-control select {
      min-width:132px; max-width:170px; border-color:var(--blue);
    }
    #view-dashboard .dashboard-hall-status {
      width:100%; margin:0; font-size:11px; line-height:1.35;
    }
    #view-dashboard .dashboard-hall-status:empty { display:none; }
    #view-dashboard .dashboard-sort-button {
      display:inline-flex; align-items:center; gap:4px; justify-content:inherit;
      font:inherit; font-size:inherit; color:inherit; font-weight:750;
      text-align:inherit; background:transparent; border:none;
      padding:0; cursor:pointer; white-space:nowrap;
    }
    #view-dashboard .dashboard-sort-button:hover,
    #view-dashboard .dashboard-sort-button[aria-sort="ascending"],
    #view-dashboard .dashboard-sort-button[aria-sort="descending"] { color:var(--blue); }
    #view-dashboard .dashboard-sort-button:focus-visible {
      outline:2px solid var(--blue); outline-offset:3px; border-radius:3px;
    }
    #view-dashboard .dashboard-sort-icon { display:inline-block; opacity:.6; min-width:9px; }
    #view-dashboard .dashboard-sort-button[data-active="true"] .dashboard-sort-icon { opacity:1; }
  </style>
</head>
<body>
  <div class="app-shell">
    <header class="app-header">
      <div class="brand">
        <div class="brand-icon" aria-hidden="true">▦</div>
        <div class="brand-wordmark"><span data-i18n="brandName">Quản lý kho SAP</span><small data-i18n="brandSubtitle">KHÔNG GIAN QUẢN LÝ</small></div>
      </div>
      <div class="header-actions">
        <div class="preference-group" role="group" data-i18n-aria="themeSettings" aria-label="Giao diện"><button type="button" id="theme-toggle" onclick="doiGiaoDien()" aria-pressed="false" aria-label="Chuyển sang giao diện tối" title="Chuyển sang giao diện tối">☾</button></div>
        <div class="preference-group" role="group" aria-label="Language / Ngôn ngữ"><button type="button" id="lang-vi" onclick="doiNgonNgu('vi')" aria-pressed="true">VI</button><button type="button" id="lang-en" onclick="doiNgonNgu('en')" aria-pressed="false">EN</button></div>
        <span class="online-pill loading" id="tinh-trang-du-lieu" role="status" data-status="connecting">Đang kết nối</span>
        <button type="button" class="btn btn-secondary" onclick="taiDuLieu()" data-i18n-title="refreshTitle" title="Đồng bộ dữ liệu từ nguồn">↻ <span data-i18n="refresh">Đồng bộ</span></button>
      </div>
    </header>

    <main class="workspace">
      <div class="breadcrumbs"><span data-i18n="workspaceName">Không gian làm việc</span><span>/</span><span class="active" data-i18n="breadcrumb">Tổng quan vật tư</span></div>
      <nav class="view-tabs" aria-label="Các màn hình quản lý kho" data-i18n-aria="tabsAria" role="tablist">
        <button type="button" id="tab-stock" class="view-tab active" role="tab" aria-selected="true" aria-controls="view-stock" tabindex="0" onclick="chuyenTab('stock')"><span aria-hidden="true">▤</span><span data-i18n="tabStock">Tra cứu tồn kho</span></button>
        <button type="button" id="tab-dashboard" class="view-tab" role="tab" aria-selected="false" aria-controls="view-dashboard" tabindex="-1" onclick="chuyenTab('dashboard')"><span aria-hidden="true">◫</span><span data-i18n="tabDashboard">Phân tích kho</span></button>
      </nav>

      <section id="view-stock" class="view-pane" role="tabpanel" aria-labelledby="tab-stock">
      <div class="intro">
        <h1><span data-i18n="heroFirst">Quản lý vật tư</span> <span data-i18n="heroAccent">thông minh.</span></h1>
        <p data-i18n="heroDesc">Tra cứu mã SAP, theo dõi tồn kho và xem hình ảnh vật tư trong cùng một không gian làm việc.</p>
      </div>

      <section class="toolbar" data-i18n-aria="searchFilters" aria-label="Tìm kiếm và bộ lọc">
        <div class="toolbar-primary">
          <div class="search-box-group">
            <div class="search-input">
              <input type="search" id="o-tim-kiem" autocomplete="off" data-i18n-aria="searchAria"
                aria-label="Tìm mã SAP, mô tả, mã phụ tùng" data-i18n-aria="searchAria" data-i18n-placeholder="searchPlaceholder"
                placeholder="Tìm SAP001, SAP002 hoặc mô tả, mã phụ tùng..."
                oninput="yeuCauLocDuLieu()" onpaste="xuLyDanTimKiem(event)">
              <span class="search-hint" aria-hidden="true">/</span>
            </div>
            <button type="button" class="btn btn-primary" onclick="locDuLieu()" data-i18n="search">Tìm kiếm</button>
            <button type="button" class="btn btn-secondary" onclick="lamMoi()" data-i18n="clear">Xóa</button>
          </div>

          <div class="quick-filters" role="group" data-i18n-aria="stockStatus" aria-label="Tồn kho so với điểm đặt hàng lại">
            <label class="quick-stock-select">
              <span data-i18n="stockStatus">Tồn kho so với điểm đặt hàng lại</span>
              <select id="loc-canh-bao" onchange="yeuCauLocDuLieu()">
                <option value="all" data-i18n="stockAny">Tất cả trạng thái</option>
                <option value="healthy" data-i18n="stockAbove">Trên định mức</option>
                <option value="at" data-i18n="stockEqual">Bằng định mức</option>
                <option value="below" data-i18n="stockBelow">Dưới định mức</option>
                <option value="zero" data-i18n="stockZero">Hết hàng (= 0)</option>
                <option value="unknown" data-i18n="stockUnknown">Chưa có định mức</option>
              </select>
            </label>
            <div class="checkbox-group">
              <label><input type="checkbox" id="chk-ton-kho" onchange="yeuCauLocDuLieu()">
                <span data-i18n="onlyStock">Chỉ hiển thị còn hàng</span></label>
            </div>
            <div class="checkbox-group">
              <label><input type="checkbox" id="tim-gan-dung" onchange="yeuCauLocDuLieu()">
                <span data-i18n="fuzzySearch">Tìm gần đúng</span></label>
            </div>
          </div>

          <button type="button" id="btn-xuat-excel" class="btn btn-soft" onclick="xuatExcel()">↓ <span data-i18n="export">Xuất báo cáo bảng tính (.xlsx)</span></button>
        </div>
        <div class="toolbar-filters">
          <span class="filter-label" data-i18n="searchIn">Tìm trong</span>
          <div class="radio-group" role="group" data-i18n-aria="searchScopeAria" aria-label="Phạm vi tìm kiếm">
            <label><input type="radio" name="truongTim" value="all" onchange="yeuCauLocDuLieu()" checked><span data-i18n="searchAll">Tất cả</span></label>
            <label><input type="radio" name="truongTim" value="sap" onchange="yeuCauLocDuLieu()"><span data-i18n="searchSap">Mã SAP</span></label>
            <label><input type="radio" name="truongTim" value="desc" onchange="yeuCauLocDuLieu()"><span data-i18n="searchDesc">Mô tả</span></label>
            <label><input type="radio" name="truongTim" value="part" onchange="yeuCauLocDuLieu()"><span data-i18n="searchPart">Mã phụ tùng</span></label>
            <label><input type="radio" name="truongTim" value="bmno" onchange="yeuCauLocDuLieu()"><span data-i18n="searchBm">Mã BM</span></label>
          </div>
        </div>
      </section>


      <div class="main-container">
        <section class="table-section" aria-labelledby="ten-bang">
          <div class="section-header">
            <div><h2 id="ten-bang" data-i18n="materialsList">Danh sách vật tư</h2><div class="section-caption" data-i18n="rowHint">Nhấn một lần để xem chi tiết; nhấn đúp để mở cửa sổ lịch sử</div></div>
            <div class="table-header-actions"><div class="reorder-legend">
<span><b class="legend-green"></b><span data-i18n="stockAbove">Trên định mức</span></span>
<span><b class="legend-yellow"></b><span data-i18n="stockEqual">Bằng định mức</span></span>
<span><b class="legend-orange"></b><span data-i18n="stockBelow">Dưới định mức</span></span>
<span><b class="legend-red"></b><span data-i18n="stockZero">Hết hàng (= 0)</span></span>
</div><span class="record-count" id="trang-thai-ban-ghi" aria-live="polite">Đang tải dữ liệu...</span></div>
          </div>
          <div class="table-wrapper" role="region" data-i18n-aria="tableAria" aria-label="Bảng vật tư, có thể cuộn ngang" tabindex="0">
            <table id="bang-du-lieu"><thead id="dau-bang"></thead><tbody id="than-bang"><tr><td class="empty-table" data-i18n="loadingData">Đang kết nối dữ liệu...</td></tr></tbody></table>
          </div>
          <div class="table-bottom">
            <div class="page-size-controls">
              <label for="so-dong-moi-trang" data-i18n="rowsPerPage">Số dòng/trang</label>
              <select id="so-dong-moi-trang" onchange="chonSoDongMoiTrang(this.value)" data-i18n-aria="rowsPerPage" aria-label="Số dòng mỗi trang">
                <option value="25">25</option><option value="50">50</option>
                <option value="75" selected>75</option><option value="100">100</option>
                <option value="200">200</option><option value="500">500</option>
                <option value="custom" data-i18n="customAmount">Tùy chọn</option>
              </select>
              <input id="so-dong-tuy-chinh" type="number" inputmode="numeric" min="1" max="5000" step="1" value="75"
                onchange="datSoDongMoiTrang(this.value)" onkeydown="if(event.key==='Enter'){event.preventDefault();datSoDongMoiTrang(this.value);}"
                data-i18n-aria="customRowsAria" aria-label="Nhập số dòng mỗi trang">
            </div>
            <div class="pagination" data-i18n-aria="paginationAria" aria-label="Chuyển trang">
              <button type="button" class="btn btn-secondary" id="btn-trang-dau" onclick="denTrang(1)" data-i18n-title="firstPage" title="Về trang đầu" data-i18n-aria="firstPage" aria-label="Về trang đầu">«</button>
              <button type="button" class="btn btn-secondary" id="btn-trang-truoc" onclick="doiTrang(-1)" disabled>‹ <span data-i18n="prev">Trước</span></button>
              <label for="nhap-so-trang" data-i18n="pageLabel">Trang</label>
              <input id="nhap-so-trang" type="number" inputmode="numeric" min="1" step="1" value="1"
                onchange="nhayDenTrang(this.value)" onkeydown="if(event.key==='Enter'){event.preventDefault();nhayDenTrang(this.value);}"
                data-i18n-aria="jumpPageAria" aria-label="Nhập số trang muốn đến">
              <span id="thong-tin-trang" aria-live="polite">/ 1</span>
              <button type="button" class="btn btn-secondary" id="btn-trang-sau" onclick="doiTrang(1)" disabled><span data-i18n="next">Sau</span> ›</button>
              <button type="button" class="btn btn-secondary" id="btn-trang-cuoi" onclick="denTrang(Math.max(1,Math.ceil(ketQuaLoc.length/SO_DONG_MOI_TRANG)))" data-i18n-title="lastPage" title="Đến trang cuối" data-i18n-aria="lastPage" aria-label="Đến trang cuối">»</button>
            </div>
          </div>
        </section>

        <aside class="detail-section" data-i18n-aria="detailsAria" aria-label="Chi tiết vật tư">
          <div class="detail-title"><strong data-i18n="details">Thông tin chi tiết</strong><small id="nhan-sap" data-i18n="noSelectedSap">Chưa chọn mã SAP</small></div>
          <div class="image-viewer-box" id="khung-anh">
            <div class="image-empty" id="anh-trong">
              <span class="empty-icon" aria-hidden="true">▣</span>
              <span data-i18n="selectSapImage">Chọn một mã SAP để xem hình ảnh</span>
            </div>
            <img id="anh-chinh" data-i18n-alt="imageAlt" alt="Hình ảnh vật tư" decoding="async" onclick="phongToAnh()">
            <button type="button" class="img-nav-btn btn-prev" id="btn-anh-truoc" onclick="doiAnhChiTiet(-1, event)" data-i18n-aria="prevImage" aria-label="Ảnh trước">‹</button>
            <button type="button" class="img-nav-btn btn-next" id="btn-anh-sau" onclick="doiAnhChiTiet(1, event)" data-i18n-aria="nextImage" aria-label="Ảnh sau">›</button>
            <div class="img-counter" id="dem-anh">0/0 ảnh</div>
          </div>
          <div class="image-thumbs" id="image-thumbnails" aria-label="Image thumbnails"></div>
          <div class="detail-placeholder" id="chi-tiet-trong" data-i18n="emptyDetails">Thông tin chi tiết sẽ xuất hiện khi bạn chọn một dòng vật tư.</div>
          <div class="detail-kpi-grid" aria-label="Thông tin tổng quan vật tư" data-i18n-aria="detailKpiAria">
            <div class="detail-kpi-card value"><span data-i18n="detailStockValue">Giá trị tồn kho</span>
              <strong id="detail-stock-value">—</strong><small id="detail-stock-value-note"></small></div>
            <div class="detail-kpi-card status"><span data-i18n="detailStockStatus">Trạng thái tồn kho</span>
              <strong id="detail-stock-status">—</strong><small id="detail-stock-status-note"></small></div>
            <div class="detail-kpi-card last-out"><span data-i18n="detailLastOutput">Ngày xuất gần nhất</span>
              <strong id="detail-last-output">—</strong><small id="detail-last-output-note"></small></div>
          </div>
          <div class="detail-grid" id="luoi-chi-tiet"></div>
          <div class="bm-no-card" id="bm-no-card">
            <div class="bm-no-card-title" data-i18n="colBm">Mã BM</div>
            <div class="bm-no-list" id="bm-no-list"></div>
          </div>
        </aside>
      </div>

      </section>

      <section id="view-dashboard" class="view-pane" role="tabpanel" aria-labelledby="tab-dashboard" hidden>
        <div class="pane-heading"><div><h1 data-i18n="dashboardHeading">Phân tích kho</h1><p data-i18n="dashboardDesc">Theo dõi nhập xuất, vật tư tồn lâu và biến động giá trị kho.</p></div></div>
      <section class="dashboard-period-strip" aria-label="Khoảng thời gian phân tích" data-i18n-aria="dashboardTimeTitle">
        <div class="dashboard-period-intro"><strong data-i18n="dashboardTimeTitle">Khoảng thời gian phân tích</strong>
          <span id="dashboard-range-summary" class="insight-note"></span></div>
        <label class="dashboard-hall-control"><span data-i18n="dashboardHallFilter">Khu vực kho</span>
          <select id="dashboard-hall" onchange="doiLocHallPhanTich()">
            <option value="all" data-i18n="dashboardHallAll">Tất cả khu vực</option>
            <option value="hall1" data-i18n="dashboardHall1">Hall 1</option>
            <option value="hall2" data-i18n="dashboardHall2">Hall 2</option>
          </select></label>
        <label><span data-i18n="dashboardTimeMode">Chọn kỳ</span>
          <select id="dashboard-range-mode" onchange="doiKyPhanTichKho()">
            <option value="week" data-i18n="dashboardTimeWeek">7 ngày gần đây</option>
            <option value="month" data-i18n="dashboardTimeMonth" selected>Tháng hiện tại</option>
            <option value="year" data-i18n="dashboardTimeYear">Theo năm</option>
            <option value="custom" data-i18n="dashboardTimeCustom">Tùy chọn ngày</option>
          </select></label>
        <label id="dashboard-range-year-field" hidden><span data-i18n="dashboardTimeYearFrom">Từ năm</span>
          <input type="number" id="dashboard-range-year-from" min="2000" max="2100" step="1" inputmode="numeric" onchange="doiKyPhanTichKho()"></label>
        <label id="dashboard-range-year-end-field" hidden><span data-i18n="dashboardTimeYearTo">Đến năm</span>
          <input type="number" id="dashboard-range-year-to" min="2000" max="2100" step="1" inputmode="numeric" onchange="doiKyPhanTichKho()"></label>
        <label id="dashboard-range-from-field" hidden><span data-i18n="dashboardTimeFrom">Từ ngày</span>
          <input id="dashboard-range-from" type="date" onchange="doiKyPhanTichKho()"></label>
        <label id="dashboard-range-to-field" hidden><span data-i18n="dashboardTimeTo">Đến ngày</span>
          <input id="dashboard-range-to" type="date" onchange="doiKyPhanTichKho()"></label>
        <p id="dashboard-hall-status" class="dashboard-hall-status insight-note" role="status" aria-live="polite"></p>
      </section>
      <section class="metric-grid" data-i18n-aria="metricsAria" aria-label="Thống kê tồn kho">
        <div class="metric-card">
          <div class="metric-text"><div class="metric-label" data-i18n="dashTotalRows">Tổng dòng vật tư</div><strong class="metric-value" id="metric-total">—</strong><span class="metric-note" data-i18n="dashKpiNote">Toàn bộ dữ liệu kho</span></div>

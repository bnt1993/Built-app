    function phamViTopXuatKho(){
      const mode=document.getElementById("dashboard-out-period").value;
      const global=layKyPhanTichKho();
      if(mode==="selected")return global;
      const now=new Date(),today=ngayDiaPhuongISO(now);
      if(mode==="week")return {from:congNgayKho(today,-6),to:today};
      if(mode==="month")return {from:today.slice(0,7)+"-01",to:today};
      if(mode==="year"){
        if(global?.mode==="year")return global;
        return {from:now.getFullYear()+"-01-01",to:today};
      }
      return global;
    }

    // Separate paging from the Stock lookup; both analytics tables remember
    // their own page and page size, with the same controls as stock search.
    const dashboardTableState={
      out:{page:1,size:25},dormant:{page:1,size:25}
    };
    let dashboardOutCache=null;
    let dashboardDormantCache=null;

    function bangKhoPrefix(kind){
      return kind==="out"?"dashboard-out":kind==="dormant"?"dashboard-dormant":"";
    }
    function capNhatPhanTrangBangKho(kind,total){
      const state=dashboardTableState[kind],prefix=bangKhoPrefix(kind);
      if(!state||!prefix)return {start:0,end:0,total:0};
      const maxPage=Math.max(1,Math.ceil(total/state.size));
      state.page=Math.max(1,Math.min(maxPage,state.page));
      const start=(state.page-1)*state.size,end=Math.min(total,start+state.size);
      const presets=["25","50","75","100","200","500"];
      document.getElementById(prefix+"-size").value=
        presets.includes(String(state.size))?String(state.size):"custom";
      document.getElementById(prefix+"-custom").value=String(state.size);
      const pageInput=document.getElementById(prefix+"-page");
      pageInput.value=String(state.page);pageInput.max=String(maxPage);
      document.getElementById(prefix+"-pages").textContent="/ "+dinhDangSoLuong.format(maxPage);
      for(const suffix of ["first","prev"])
        document.getElementById(prefix+"-"+suffix).disabled=state.page<=1;
      for(const suffix of ["next","last"])
        document.getElementById(prefix+"-"+suffix).disabled=state.page>=maxPage;
      return {start,end,total};
    }
    function veBangKhoTheoLoai(kind){
      if(kind==="out")veTopVatTuXuatKho();
      else if(kind==="dormant")veVatTuTonLau();
    }
    function datSoDongBangKho(kind,value){
      const state=dashboardTableState[kind];if(!state)return;
      const count=Number(value);
      if(!Number.isInteger(count)||count<1){
        veBangKhoTheoLoai(kind);return;
      }
      const nextSize=Math.min(count,5000);
      const firstIndex=(state.page-1)*state.size;
      state.size=nextSize;state.page=Math.floor(firstIndex/nextSize)+1;
      veBangKhoTheoLoai(kind);
    }
    function chonSoDongBangKho(kind,value){
      if(!dashboardTableState[kind])return;
      if(value==="custom"){
        const input=document.getElementById(bangKhoPrefix(kind)+"-custom");
        input.focus();input.select();return;
      }
      datSoDongBangKho(kind,value);
    }
    function denTrangBangKho(kind,target){
      const state=dashboardTableState[kind];if(!state)return;
      const prefix=bangKhoPrefix(kind);
      const pageInput=document.getElementById(prefix+"-page");
      const max=Math.max(1,Number(pageInput.max)||1);
      const page=target==="first"?1:target==="last"?max:
        target==="prev"?state.page-1:target==="next"?state.page+1:Number(target);
      if(!Number.isInteger(page)){pageInput.value=String(state.page);return;}
      state.page=Math.max(1,Math.min(max,page));
      veBangKhoTheoLoai(kind);
      document.getElementById(kind==="out"?"dashboard-top-out":"dashboard-dormant").scrollTop=0;
    }
    function doiLocTopXuatKho(){
      dashboardTableState.out.page=1;
      dashboardOutCache=null;
      document.getElementById("dashboard-out-min").value="0";
      veTopVatTuXuatKho();
    }
    function doiNguongXuatKho(){
      dashboardTableState.out.page=1;veTopVatTuXuatKho();
    }
    function doiLocTonLauKho(){
      dashboardTableState.dormant.page=1;veVatTuTonLau();
    }


    function thongKeTopVatTuXuatKho(range){
      const amountCol=cotGiaTriLichSuKho(),sapCol=cotMaSapLichSuKho();
      if(amountCol<0||sapCol<0)return null;
      const qtyCol=cotSoLuongHistoryDungCot();
      const unitCol=cotHistoryTheoTen(historyColumns,[
        "Unit of Entry","Base Unit of Measure","Unit","UOM","Đơn vị","Đơn vị tính"]);
      const descCol=cotHistoryTheoTen(historyColumns,[
        "Material Description","Description","Mô tả","Mô tả vật tư"]);
      const stockBySap=new Map((tonKhoTheoHall()||[]).map(item=>
        [chuanHoaMaSap(item.dong[0]).toLowerCase(),item]));
      const grouped=new Map();
      for(const rec of locGiaoDichKho(range,["out"])){
        const sap=chuanHoaMaSap(rec.cells[sapCol]);
        const raw=String(rec.cells[amountCol]??"").trim();
        const amount=raw?chuyenThanhSo(raw):NaN;
        if(!sap||!Number.isFinite(amount))continue;
        let row=grouped.get(sap.toLowerCase());
        if(!row){
          const stock=stockBySap.get(sap.toLowerCase());
          row={sap,description:stock?String(stock.dong[1]??""):
            descCol>=0?String(rec.cells[descCol]??""):"",
            value:0,quantity:0,unit:"",quantityValid:true,mixed:false,count:0};
          grouped.set(sap.toLowerCase(),row);
        }
        row.value+=Math.abs(amount);row.count++;
        const qRaw=qtyCol>=0?String(rec.cells[qtyCol]??"").trim():"";
        const quantity=qRaw?chuyenThanhSo(qRaw):NaN;
        const unit=unitCol>=0?String(rec.cells[unitCol]??"").trim().toUpperCase():"";
        if(!unit||!Number.isFinite(quantity)){
          row.quantityValid=false;continue;
        }
        if(row.unit&&row.unit!==unit){
          row.mixed=true;row.quantityValid=false;
        }
        if(!row.unit)row.unit=unit;
        if(row.quantityValid)row.quantity+=Math.abs(quantity);
      }
      return [...grouped.values()].filter(row=>row.value>0)
        .sort((a,b)=>b.value-a.value||a.sap.localeCompare(b.sap));
    }

    function veTopVatTuXuatKho(){
      const root=document.getElementById("dashboard-top-out");
      const note=document.getElementById("dashboard-top-out-note");
      const slider=document.getElementById("dashboard-out-min");
      const amountText=document.getElementById("dashboard-out-min-value");
      if(!historyLoaded){
        root.textContent=tuDien(historyLoading?"dashboardHistoryLoading":"dashboardTopOutEmpty");
        note.textContent="";slider.disabled=true;amountText.textContent="—";
        capNhatPhanTrangBangKho("out",0);return;
      }
      const range=phamViTopXuatKho();
      if(hallDangLoc()!=="all"&&!coCotHistoryHall()){
        root.textContent=tuDien("dashboardHallNoHistoryColumn");
        note.textContent="";slider.disabled=true;amountText.textContent="—";
        capNhatPhanTrangBangKho("out",0);return;
      }
      if(!range){
        root.textContent=tuDien("dashboardTimeInvalid");note.textContent="";
        slider.disabled=true;amountText.textContent="—";
        capNhatPhanTrangBangKho("out",0);return;
      }
      const key=range.from+"|"+range.to+"|"+hallDangLoc();
      if(!dashboardOutCache||dashboardOutCache.key!==key||
        dashboardOutCache.history!==historyAll||
        dashboardOutCache.stock!==duLieuTimKiem){
        const rows=thongKeTopVatTuXuatKho(range);
        dashboardOutCache={key,history:historyAll,stock:duLieuTimKiem,rows};
        dashboardTableState.out.page=1;
        slider.value="0";
        if(rows&&rows.length){
          const max=rows[0].value;
          const step=Math.max(1,10**Math.max(0,Math.floor(Math.log10(Math.max(1,max/100)))));
          slider.min="0";slider.max=String(Math.ceil(max/step)*step);
          slider.step=String(step);slider.disabled=false;
        }else{
          slider.min="0";slider.max="0";slider.step="1";slider.disabled=true;
        }
      }
      const rows=dashboardOutCache.rows;
      if(!rows){
        root.textContent=tuDien("dashboardTopOutMissing");note.textContent="";
        amountText.textContent="—";capNhatPhanTrangBangKho("out",0);return;
      }
      const threshold=Math.max(0,Number(slider.value)||0);
      amountText.textContent=dinhDangGiaTriKho(threshold);
      amountText.title=tuDien("dashboardOutMinSummary",{amount:amountText.textContent});
      const filtered=rows.filter(row=>row.value>=threshold);
      const page=capNhatPhanTrangBangKho("out",filtered.length);
      if(!filtered.length){
        root.textContent=tuDien("dashboardTopOutEmpty");
      }else{
        const header='<thead><tr><th>'+thoatHTML(tuDien("dashTopMaterial"))+
          '</th><th title="'+thoatHTML(tuDien("dashboardTopOutQtyMissingNote"))+'">'+
          thoatHTML(tuDien("dashboardTopOutCount"))+
          '</th><th>'+thoatHTML(tuDien("dashboardTopOutUnit"))+
          '</th><th>'+thoatHTML(tuDien("dashboardTopOutValue"))+'</th></tr></thead>';
        root.innerHTML='<table class="dashboard-detail-table">'+header+'<tbody>'+
          filtered.slice(page.start,page.end).map(rec=>{
            const qty=rec.quantityValid&&!rec.mixed&&rec.unit?
              dinhDangSoLuong.format(rec.quantity):"—";
            const unit=rec.mixed?tuDien("dashboardOutMixedUnits"):(rec.unit||"—");
            return '<tr tabindex="0" data-sap="'+thoatHTML(rec.sap)+'" title="'+
              thoatHTML(tuDien("dashboardTopDoubleClick"))+'"><td><span class="material-sap">'+
              thoatHTML(rec.sap)+'</span><span class="material-name">'+
              thoatHTML(rec.description||"—")+'</span></td><td>'+
              thoatHTML(qty)+'</td><td>'+thoatHTML(unit)+'</td><td><strong>'+
              thoatHTML(dinhDangGiaTriKho(rec.value))+'</strong></td></tr>';
          }).join("")+'</tbody></table>';
      }
      note.textContent=tuDien("dashboardPagerSummary",{
        from:filtered.length?dinhDangSoLuong.format(page.start+1):"0",
        to:dinhDangSoLuong.format(page.end),
        total:dinhDangSoLuong.format(page.total)
      })+" · "+range.from+" – "+range.to;
    }

    function thongKeVatTuTonLau(days,now=new Date()){
      if(!historyLoaded)return null;
      const sapCol=cotMaSapLichSuKho();
      if(sapCol<0)return null;
      const today=ngayDiaPhuongISO(now),stock=new Map();
      const hallStock=tonKhoTheoHall(),hallHistory=lichSuTheoHall();
      if(!hallStock||!hallHistory)return null;
      const unitCol=cotHistoryTheoTen(tieuDeCot,[
        "Unit","Base Unit of Measure","UOM","Đơn vị","Đơn vị tính"]);
      const priceCol=cotHistoryTheoTen(tieuDeCot,["Price","Unit Price","Đơn giá","Giá"]);
      for(const item of hallStock){
        if(!Number.isFinite(item.soLuong)||item.soLuong<=0)continue;
        const sap=chuanHoaMaSap(item.dong[0]),key=sap.toLowerCase();
        if(!key)continue;
        let row=stock.get(key);
        const unit=unitCol>=0?String(item.dong[unitCol]??"").trim():"";
        const priceRaw=priceCol>=0?String(item.dong[priceCol]??"").trim():"";
        const price=priceRaw?chuyenThanhSo(priceRaw):NaN;
        const validPrice=Number.isFinite(price)&&price>=0;
        if(!row){
          row={sap,description:String(item.dong[1]??""),quantity:0,
            unit,quantityValid:!!unit,last:"",days:null,
            price,priceValid:validPrice,priceMixed:false};
          stock.set(key,row);
        }else{
          if(!row.description)row.description=String(item.dong[1]??"");
          if(!validPrice)row.priceValid=false;
          else if(Number.isFinite(row.price)&&
            Math.abs(row.price-price)>Math.max(.01,Math.abs(row.price)*1e-8)){
            row.priceMixed=true;row.priceValid=false;
          }
        }
        if(!unit||row.unit!==unit){
          row.quantityValid=false;
          if(row.unit&&unit&&row.unit!==unit)row.priceMixed=true;
        }
        if(row.quantityValid)row.quantity+=item.soLuong;
      }
      for(const rec of hallHistory){
        if(rec.type!=="out"||!ngayHistoryHopLe(rec.date)||rec.date>today)continue;
        const key=chuanHoaMaSap(rec.cells[sapCol]).toLowerCase();
        const material=stock.get(key);
        if(material&&rec.date>material.last)material.last=rec.date;
      }
      const report=[];
      for(const row of stock.values()){
        row.days=row.last?khoangNgayKho(row.last,today)-1:null;
        if(row.days===null||row.days>=days)report.push(row);
      }
      return report.sort((a,b)=>
        (b.days??Number.MAX_SAFE_INTEGER)-(a.days??Number.MAX_SAFE_INTEGER)||
        a.sap.localeCompare(b.sap));
    }

    function veVatTuTonLau(){
      const root=document.getElementById("dashboard-dormant");
      const note=document.getElementById("dashboard-dormant-note");
      if(!historyLoaded){
        root.textContent=tuDien(historyLoading?"dashboardHistoryLoading":"dashboardDormantNoHistory");
        note.textContent="";capNhatPhanTrangBangKho("dormant",0);return;
      }
      const days=Number(document.getElementById("dashboard-dormant-days").value)||90;
      const today=ngayDiaPhuongISO();
      if(!dashboardDormantCache||dashboardDormantCache.days!==days||
        dashboardDormantCache.today!==today||
        dashboardDormantCache.hall!==hallDangLoc()||
        dashboardDormantCache.history!==historyAll||
        dashboardDormantCache.stock!==duLieuTimKiem){
        const rows=thongKeVatTuTonLau(days);
        dashboardDormantCache={days,today,hall:hallDangLoc(),history:historyAll,stock:duLieuTimKiem,rows};
        dashboardTableState.dormant.page=1;
      }
      const rows=dashboardDormantCache.rows;
      if(rows===null){
        root.textContent=tuDien(hallDangLoc()!=="all"&&!coCotStockHall()?
          "dashboardHallNoStockColumn":hallDangLoc()!=="all"&&!coCotHistoryHall()?
          "dashboardHallNoHistoryColumn":"dashboardDormantMissing");
        note.textContent="";capNhatPhanTrangBangKho("dormant",0);return;
      }
      if(!rows.length){
        root.textContent=tuDien("dashboardDormantEmpty");
        note.textContent="";capNhatPhanTrangBangKho("dormant",0);return;
      }
      const page=capNhatPhanTrangBangKho("dormant",rows.length);
      const header='<thead><tr><th>'+thoatHTML(tuDien("dashTopMaterial"))+
        '</th><th>'+thoatHTML(tuDien("dashboardDormantStock"))+
        '</th><th>'+thoatHTML(tuDien("dashboardDormantLast"))+
        '</th><th>'+thoatHTML(tuDien("dashboardDormantUnitPrice"))+'</th></tr></thead>';
      root.innerHTML='<table class="dashboard-detail-table">'+header+'<tbody>'+

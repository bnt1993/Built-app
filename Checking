      background:var(--app-panel); box-shadow:0 2px 7px rgba(0,0,0,.05); }
    .history-kind-filter:focus-visible { outline:2px solid var(--blue); outline-offset:2px; }
    .history-table td { font-variant-numeric:tabular-nums; }
    .history-table td:first-child { position:sticky; left:0; background:var(--app-panel); z-index:1; }
    .history-table th:first-child { position:sticky; left:0; z-index:4; }
    .history-table tbody tr:hover td:first-child { background:var(--app-hover); }
    @media(max-width:620px){ .history-kind-group { width:100%; }
      .history-kind-buttons { justify-content:space-between; }
      .history-kind-filter { flex:1 1 0; padding:5px 6px; }
    }
    .history-quantity.in { color:var(--green); font-weight:750; }
    .history-quantity.out { color:var(--red); font-weight:750; }
  </style>
</head>

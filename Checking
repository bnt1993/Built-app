    function dinhDangLuongHistory(n) {
      return new Intl.NumberFormat(ngonNguHienTai==="en"?"en-US":"vi-VN",
        {maximumFractionDigits:2}).format(n);
    }

    // Each direction is summed separately by quantity, not number of movements.
    // Never sum different units or silently ignore invalid records.
    function tongSoLuongHistory(rows) {
      const qtyCol=cotSoLuongHistoryDungCot();
      const unitCol=cotHistoryTheoTen(historyColumns,[
        "Unit of Entry","Base Unit of Measure","Unit","UOM","Đơn vị","Đơn vị tính"]);
      if(qtyCol<0)return {value:NaN,unit:"",reason:"materialHistoryQuantityMissing"};
      let total=0,unit="",invalid=false,mixed=false,missing=false;
      for(const rec of rows) {
        const raw=rec.cells[qtyCol],qty=chuyenThanhSo(raw);
        if(!Number.isFinite(qty)){invalid=true;continue;}
        total+=Math.abs(qty);
        if(unitCol>=0) {
          const entry=String(rec.cells[unitCol]??"").trim().toUpperCase();
          if(!entry){missing=true;continue;}
          if(unit&&unit!==entry)mixed=true;
          if(!unit)unit=entry;
        }
      }
      if(invalid)return {value:NaN,unit:"",reason:"materialHistoryQuantityInvalid"};
      if(mixed)return {value:NaN,unit:"",reason:"materialHistoryQuantityMixed"};
      if(missing)return {value:NaN,unit:"",reason:"materialHistoryQuantityUnit"};
      return {value:total,unit,reason:unitCol<0?"materialHistoryQuantityUnit":""};
    }

    function hienThiSoLuongVatTu(rowsForQuantity,allSapRows) {
      const stockRow=dongStockLichSuVatTu();
      const stockUnitCol=cotHistoryTheoTen(tieuDeCot,[
        "Unit","Stock Unit","Base Unit of Measure","UOM","Đơn vị","Đơn vị tính"]);
      const unit=stockRow&&stockUnitCol>=0?String(stockRow[stockUnitCol]??"").trim().toUpperCase():"";
      const stock=stockRow?chuyenThanhSo(stockRow[chiSoSoLuong]):NaN;
      document.getElementById("material-history-stock").textContent=Number.isFinite(stock)?
        dinhDangLuongHistory(stock)+(unit?" "+unit:""):"—";
      document.getElementById("material-history-stock-note").textContent=Number.isFinite(stock)?
        (unit||tuDien("materialHistoryQuantityUnit")):tuDien("consumptionNoStock");
      for(const kind of ["in","out","unknown"]) {
        const id=kind==="unknown"?"other":kind;
        const val=document.getElementById("material-history-"+id+"-count");
        const note=document.getElementById("material-history-"+kind+"-note");
        if(!historyLoaded){val.textContent="—";note.textContent="";continue;}
        const stat=tongSoLuongHistory(rowsForQuantity.filter(row=>row.type===kind));
        val.textContent=Number.isFinite(stat.value)?
          dinhDangLuongHistory(stat.value)+(stat.unit?" "+stat.unit:""):"—";
        note.textContent=stat.reason?tuDien(stat.reason):stat.unit;
        note.title=note.textContent;
      }
      const monthly=document.getElementById("material-history-monthly");
      const monthlyNote=document.getElementById("material-history-monthly-note");
      const coverage=document.getElementById("material-history-coverage");
      const coverageNote=document.getElementById("material-history-coverage-note");
      if(!historyLoaded) {
        monthly.textContent=coverage.textContent="—";
        monthlyNote.textContent=coverageNote.textContent=tuDien("consumptionNoHistory");
        return;
      }
      // Average/coverage stay based on the complete history (12 completed months),
      // regardless of table filters.
      const stats=thongKeConsumptionVatTu(allSapRows,stockRow);
      monthly.textContent=Number.isFinite(stats.average)?
        dinhDangLuongHistory(stats.average)+(stats.unit?" "+stats.unit:""):"—";
      coverage.textContent=Number.isFinite(stats.coverage)?tuDien("consumptionMonths",{
        count:new Intl.NumberFormat(ngonNguHienTai==="en"?"en-US":"vi-VN",
          {maximumFractionDigits:1}).format(stats.coverage)}):"—";
      const countNote=stats.invalid?tuDien("consumptionPartial",{
        count:dinhDangSoLuong.format(stats.invalid)}):"";
      monthlyNote.textContent=!stats.hasQuantity?tuDien("consumptionMissingQty"):
        !stats.summable?tuDien("consumptionMixedUnits"):
        !stats.hasDates?tuDien("consumptionNoDates"):
        tuDien("consumptionRecent",{period:stats.period})+(countNote?" · "+countNote:"");
      coverageNote.textContent=!stats.hasQuantity?tuDien("consumptionMissingQty"):
        !stats.summable||stats.mixed||stats.invalid?tuDien("consumptionIncomplete"):
        !stats.hasDates?tuDien("consumptionNoDates"):
        !Number.isFinite(stats.stock)||stats.stock<0?tuDien("consumptionNoStock"):
        !Number.isFinite(stats.average)||stats.average===0?tuDien("consumptionNoAverage"):
        !stats.compatible?tuDien("consumptionUnitMismatch"):
        tuDien("consumptionStock",{amount:dinhDangLuongHistory(stats.stock),unit:stats.stockUnit});
      monthlyNote.title=monthlyNote.textContent;
      coverageNote.title=coverageNote.textContent;
    }


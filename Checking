      if (tuKhoa.length < 4 || tuKhoa.length > 48) return false;
      const words = chuanHoaTimKiem(chuoi).split(/[^a-z0-9]+/).filter(Boolean);
      return words.some(word => Math.abs(word.length-tuKhoa.length)<=1 && trungGanDung(word,tuKhoa));
    }


    // One search box handles a phrase or many SAP codes separated by comma,
    // semicolon, pipe, newline or spaces for code-like tokens.
    function phanTichTimKiem(value, scope) {
      const raw=String(value??"").trim();
      if(!raw) return {terms:[],exactSap:null};
      const explicitlySeparated=/[,;|\r\n]/.test(raw);
      let parts=explicitlySeparated ? raw.split(/[,;|\r\n]+/) : [raw];
      if(!explicitlySeparated) {
        const words=raw.split(/\s+/).filter(Boolean);
        const lookLikeCodes=words.length>1 && words.every(x=>
          /^[a-z0-9._-]+$/i.test(x) && /\d/.test(x));
        if(words.length>1 && (scope==="sap" || lookLikeCodes)) parts=words;
      }
      const terms=[...new Set(parts.map(x=>x.trim().toLowerCase()).filter(Boolean))].slice(0,2000);
      // Multi-code searches use exact SAP matches. Other multi-keyword
      // searches keep the existing substring/typo-tolerant OR semantics.
      const sapList=terms.length>1 && (scope==="all"||scope==="sap") &&
        terms.every(x=>/^[a-z0-9._-]+$/i.test(x)&&/\d/.test(x))
        ? new Set(terms.map(x=>chuanHoaMaSap(x).toLowerCase())) : null;
      return {terms,exactSap:sapList};
    }


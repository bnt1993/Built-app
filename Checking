    function taoThongKeXuat(rows,columns) {
      const sapCol=cotHistoryTheoTen(columns,["Material","SAP","SAP Code","Material Number","Mã SAP","Mã vật tư"]);
      const qtyCol=cotHistoryTheoTen(columns,["Quantity","Qty","Movement Qty","Qty in unit of entry","Số lượng","So luong","Amount Qty","Quantity Change"]);
      const outCol=cotHistoryTheoTen(columns,["Out","Outbound","Qty Out","Xuat","Xuất","Số lượng xuất"]);
      const unitCol=cotHistoryTheoTen(columns,["Unit of Entry","Base Unit of Measure","Unit","UOM","Đơn vị","Đơn vị tính"]);
      const ready=sapCol>=0&&(qtyCol>=0||outCol>=0);
      const map=new Map();
      if(ready)for(const rec of rows) {
        if(rec.type!=="out")continue;
        const sap=chuanHoaMaSap(rec.cells[sapCol]).toLowerCase();
        if(!sap)continue;
        if(!map.has(sap))map.set(sap,{units:new Map(),invalid:0});
        const entry=map.get(sap);
        const qty=chuyenThanhSo(rec.cells[outCol>=0?outCol:qtyCol]);
        if(!Number.isFinite(qty)){entry.invalid++;continue;}
        const unit=unitCol>=0?String(rec.cells[unitCol]??"").trim().toUpperCase():"";
        entry.units.set(unit,(entry.units.get(unit)||0)+Math.abs(qty));
      }
      return {map,ready};
    }

    function capNhatCardXuat() {
      const card=document.getElementById("detail-issued");
      if(!card)return;
      const value=card.querySelector("span"),note=card.querySelector("small");
      note.textContent=tuDien("issuedScope");
      if(historyLoading){value.textContent=tuDien("historyLoading");return;}
      if(!historyLoaded){value.textContent=tuDien(historyStatusKey==="historyIdle"?"historyLoading":historyStatusKey);return;}
      if(!issuedSchemaReady){value.textContent=tuDien("issuedMissing");return;}
      if(!card.dataset.sap){value.textContent=tuDien("issuedMissing");return;}
      const entry=issuedBySap.get(card.dataset.sap);
      value.textContent=entry ? [...entry.units].map(([unit,qty])=>
        dinhDangSoLuong.format(qty)+" "+(unit||tuDien("issuedUnitUnknown"))).join(" · ")||"—" : "0";
      if(entry?.invalid)note.textContent+=" · "+tuDien("issuedPartial");
      if(["historyNoSource","historyInvalid"].includes(historyStatusKey))note.textContent+=" · "+tuDien("issuedStale");
    }

    function timNguonHistory() {
      const candidates=[
        "duLieuLichSu","duLieuHistory","duLieuLichSuNhapXuat","lichSuNhapXuat",
        "inventoryTransactions","historyData","HistoryData","HISTORY_DATA",
        "inventoryHistory","historyTransactions","duLieuNhapXuat"
      ];
      for(const key of candidates) {
        const data=window[key];
        if(Array.isArray(data) ||
           (data && typeof data==="object" && !Array.isArray(data) &&
            [data.rows,data.data,data.records,data.transactions].some(Array.isArray))) {
          return data;
        }
      }
      return null;
    }

    function tenHistoryChuan(ten) {
      return String(ten??"").normalize("NFD").replace(/[\u0300-\u036f]/g,"")
        .replace(/đ/g,"d").toLowerCase().replace(/[^a-z0-9]/g,"");
    }
    function cotHistoryTheoTen(headers, aliases) {
      const names=new Set(aliases.map(tenHistoryChuan));
      return headers.findIndex(key=>names.has(tenHistoryChuan(key)));
    }
    function ngayHistoryISO(value) {
      if(value==null || value==="")return "";
      const text=String(value).trim();
      let m=text.match(/^(\d{4})[-/.](\d{1,2})[-/.](\d{1,2})/);
      if(m) return m[1]+"-"+m[2].padStart(2,"0")+"-"+m[3].padStart(2,"0");
      m=text.match(/^(\d{1,2})[/. -](\d{1,2})[/. -](\d{4})/);
      if(m) return m[3]+"-"+m[2].padStart(2,"0")+"-"+m[1].padStart(2,"0");
      if(typeof value==="number" && value>20000 && value<100000) {
        // Excel date serial: Excel day 1 = 1900-01-01 (1900 leap-year quirk).
        return new Date(Date.UTC(1899,11,30)+Math.floor(value)*86400000).toISOString().slice(0,10);
      }
      return "";
    }

    // History.js actual movement values: INPUT, OUTPUT, SCRAP and SAP codes.
    // SAP reversal movements (102, 202, 502, 552) have the opposite effect
    // from their originating transaction. Transfer movements may have both
    // a positive receiving leg and a negative issuing leg.
    function loaiHistory(raw,row) {
      const kind=tenHistoryChuan(raw);
      const incoming=new Set([
        "in","input","inbound","import","receive","receipt","goodsreceipt","gr",
        "nhap","nhapkho","101","202","501","552","tang","plus"
      ]);
      const outgoing=new Set([
        "out","output","outbound","export","issue","goodsissue","gi","scrap",
        "xuat","xuatkho","201","102","502","551","giam","minus"
      ]);
      if(incoming.has(kind))return "in";
      if(outgoing.has(kind))return "out";
      const incomingValue=historyInColumn>=0?chuyenThanhSo(row[historyInColumn]):NaN;
      const outgoingValue=historyOutColumn>=0?chuyenThanhSo(row[historyOutColumn]):NaN;
      const hasIn=Number.isFinite(incomingValue)&&incomingValue>0;
      const hasOut=Number.isFinite(outgoingValue)&&outgoingValue>0;
      if(hasIn!==hasOut)return hasIn?"in":"out";
      // For transfer (301/302/311/312) and other SAP movement codes, an
      // explicit signed movement quantity indicates the direction of each leg.
      const qty=historyQuantityColumn>=0?chuyenThanhSo(row[historyQuantityColumn]):NaN;
      if(Number.isFinite(qty)&&qty!==0)return qty>0?"in":"out";
      return "unknown";
    }

    function bienDoiHistory(source) {
      let data=source,headers=null;
      if(data && !Array.isArray(data) && typeof data==="object") {
        headers=data.headers||data.columns||data.tieuDeCot||null;
        data=data.rows??data.data??data.records??data.transactions;
      }
      if(!Array.isArray(data))throw Error("HISTORY_BAD_FORMAT");
      if(!data.length) return {headers:Array.isArray(headers)?headers.map(String):[],rows:[]};
      let inputRows=data;
      if(Array.isArray(inputRows[0])) {
        if(!Array.isArray(headers)) {headers=inputRows[0];inputRows=inputRows.slice(1);}
        const maxLength=Math.max(headers.length,...inputRows.slice(0,100).map(r=>Array.isArray(r)?r.length:0));
        const names=Array.from({length:maxLength},(_,i)=>String(headers[i]??("Column "+(i+1))));
        const rows=inputRows.filter(Array.isArray);
        return {headers:names,rows};
      }
      if(inputRows[0] && typeof inputRows[0]==="object" && !Array.isArray(inputRows[0])) {
        const names=[];
        const seen=new Set();
        for(const row of inputRows) {
          if(!row || typeof row!=="object" || Array.isArray(row))continue;
          for(const key of Object.keys(row)) {
            if(!seen.has(key)) {seen.add(key);names.push(key);}
          }
        }
        return {headers:names,rows:inputRows.filter(x=>x&&typeof x==="object"&&!Array.isArray(x))
          .map(row=>names.map(name=>row[name]??""))};
      }
      throw Error("HISTORY_BAD_FORMAT");
    }

    function capNhatTrangThaiHistory(key,values={}) {
      historyStatusKey=key;
      historyStatusArgs=values;
      const status=document.getElementById("history-status");
      status.dataset.historyStatus=key;
      status.textContent=tuDien(key,values);
      status.classList.toggle("error",["historyNoSource","historyInvalid"].includes(key));
    }

    // Parse the actual 6 MB History.js as *data* rather than executing it.
    // It assigns window.duLieuCongTy, the same global used by data.js for Stock.
    // Parsing protects the live stock source from being overwritten.
    function docHistoryTuVanBan(source) {
      const assignment=/window\.(?:duLieuCongTy|duLieuLichSu|duLieuHistory|lichSuNhapXuat|inventoryTransactions|historyData)\s*=\s*\[/.exec(source);
      if(!assignment)throw Error("HISTORY_BAD_FORMAT");
      const from=assignment.index+assignment[0].length-1;
      const to=source.lastIndexOf("]");
      if(to<=from)throw Error("HISTORY_BAD_FORMAT");
      const data=JSON.parse(source.slice(from,to+1));
      const time=/window\.thoiGianCapNhat\s*=\s*("(?:\\.|[^"\\])*")/.exec(source);
      return {data,updated:time?JSON.parse(time[1]):""};
    }

    async function apDungNguonHistory(source,origin="file",updated="",sequence=historySeq) {
      let parsed;
      try { parsed=bienDoiHistory(source); }
      catch(err){capNhatTrangThaiHistory("historyInvalid");return false;}
      const columns=parsed.headers;
      const dateColumn=cotHistoryTheoTen(columns,[
        "Date","Posting Date","Document Date","Transaction Date","Datetime",
        "Created At","Ngay","Ngày","Ngày giao dịch","Ngày hạch toán","PostingDate"]);
      const typeColumn=cotHistoryTheoTen(columns,[
        "Type","Movement Type","Movement","IN/OUT","Transaction Type",
        "Loai","Loại","Loại giao dịch","Nhập/Xuất","Action"]);
      const qtyColumn=cotHistoryTheoTen(columns,[
        "Quantity","Qty","Movement Qty","Qty in unit of entry","Số lượng",
        "So luong","Amount Qty","Quantity Change"]);
      const inColumn=cotHistoryTheoTen(columns,["In","Inbound","Qty In","Nhap","Nhập","Số lượng nhập"]);
      const outColumn=cotHistoryTheoTen(columns,["Out","Outbound","Qty Out","Xuat","Xuất","Số lượng xuất"]);
      if(!columns.length || (typeColumn<0 && inColumn<0 && outColumn<0)) {
        capNhatTrangThaiHistory("historyInvalid");return false;
      }
      // Set source index hints before classification.
      historyDateColumn=dateColumn;
      historyTypeColumn=typeColumn;
      historyQuantityColumn=qtyColumn;
      historyInColumn=inColumn;
      historyOutColumn=outColumn;
      const indexed=[];
      let countIn=0,countOut=0;
      for(let i=0;i<parsed.rows.length;i++) {
        if(sequence!==historySeq)return false;
        const row=parsed.rows[i];
        const cells=row.map(v=>v!==null&&typeof v==="object"?JSON.stringify(v):String(v??""));
        const kind=loaiHistory(typeColumn>=0?row[typeColumn]:"",row);
        if(kind==="in")countIn++;
        if(kind==="out")countOut++;
        indexed.push({
          cells,number:i, date:dateColumn>=0?ngayHistoryISO(row[dateColumn]):"",
          type:kind,search:chuanHoaTimKiem(cells.join("\u0001"))
        });
        // Keep 60k+ movement records responsive on mobile browsers.
        if(i>0 && i%1600===0)await new Promise(resolve=>setTimeout(resolve,0));
      }
      if(sequence!==historySeq)return false;
      indexed.sort((a,b)=>(b.date||"").localeCompare(a.date||"") || a.number-b.number);
      historyColumns=columns;
      historyAll=indexed;
      const issued=taoThongKeXuat(indexed,columns);
      issuedBySap=issued.map;issuedSchemaReady=issued.ready;
      historyLoaded=true;
      historyPage=1;
      const total=indexed.length;
      document.getElementById("history-total").textContent=dinhDangSoLuong.format(total);
      document.getElementById("history-in").textContent=dinhDangSoLuong.format(countIn);
      document.getElementById("history-out").textContent=dinhDangSoLuong.format(countOut);
      const status=total?(origin==="existing"?"historyLoadedExisting":updated?"historyLoadedAt":"historyLoaded"):"historyEmpty";
      capNhatTrangThaiHistory(status,{count:dinhDangSoLuong.format(total),time:updated});
      capNhatNutLoaiHistory();
      locHistory();
      return true;
    }

    // Only the known array assignment is read; no eval/new Function on History.js.
    // Local file:// environments cannot fetch JS text, so they use a temporary
    // script, snapshot both shared globals, then restore Stock immediately.
    function taiHistoryBangScript() {
      return new Promise((resolve,reject)=>{
        const hasStock=Object.prototype.hasOwnProperty.call(window,"duLieuCongTy");
        const hasTime=Object.prototype.hasOwnProperty.call(window,"thoiGianCapNhat");
        const oldStock=window.duLieuCongTy;
        const oldTime=window.thoiGianCapNhat;
        const oldScript=document.getElementById("script-history-data");
        if(oldScript)oldScript.remove();
        const script=document.createElement("script");
        script.id="script-history-data";
        script.async=true;
        script.src=DUONG_DAN_HISTORY+"?t="+Date.now();
        let finished=false;
        const timer=setTimeout(()=>finish(null,Error("HISTORY_TIMEOUT")),18000);
        function restore() {
          if(hasStock)window.duLieuCongTy=oldStock;
          else delete window.duLieuCongTy;
          if(hasTime)window.thoiGianCapNhat=oldTime;
          else delete window.thoiGianCapNhat;
        }
        function finish(data,err) {
          if(finished)return;
          finished=true;
          clearTimeout(timer);
          restore();
          script.remove();
          if(err)reject(err);
          else resolve(data);
        }
        script.onload=()=>{
          const data=window.duLieuCongTy!==oldStock
            ? window.duLieuCongTy:timNguonHistory();
          finish({data,updated:window.thoiGianCapNhat||""},null);
        };
        script.onerror=()=>finish(null,Error("HISTORY_MISSING"));
        document.body.appendChild(script);
      });
    }

    async function taiHistory(force=false) {
      if(historyLoading || (historyLoaded && !force))return;
      historyLoading=true;
      const sequence=++historySeq;
      const button=document.getElementById("btn-refresh-history");
      button.disabled=true;
      capNhatTrangThaiHistory("historyLoading");
      capNhatCardXuat();
      try{
        let source;
        if(typeof fetch==="function" && location.protocol!=="file:") {
          const response=await fetch(DUONG_DAN_HISTORY+"?t="+Date.now(),{cache:"no-store",priority:"low"});
          if(!response.ok)throw Error("HISTORY_MISSING");
          source=docHistoryTuVanBan(await response.text());
        } else source=await taiHistoryBangScript();
        if(!source.data)throw Error("HISTORY_BAD_FORMAT");
        const ok=await apDungNguonHistory(source.data,"file",source.updated,sequence);
        if(!ok && historyStatusKey==="historyLoading")
          capNhatTrangThaiHistory("historyInvalid");
      }catch(err){
        console.warn("History.js:",err);
        // Preserve the last good History result when a reload fails.
        capNhatTrangThaiHistory(err.message==="HISTORY_BAD_FORMAT"||err instanceof SyntaxError
          ?"historyInvalid":"historyNoSource");
      }finally{
        if(sequence===historySeq) {
          historyLoading=false;
          button.disabled=false;
          capNhatCardXuat();
        }
      }
    }

    function capNhatNutLoaiHistory() {
      const selected=document.getElementById("history-type").value;
      document.querySelectorAll("[data-history-kind]").forEach(button=>{
        const active=button.dataset.historyKind===selected;
        button.classList.toggle("selected",active);
        button.setAttribute("aria-pressed",String(active));
      });
    }

    function chonLoaiHistory(kind) {
      if(!["all","in","out","unknown"].includes(kind))return;
      document.getElementById("history-type").value=kind;
      capNhatNutLoaiHistory();
      locHistory();
    }

    let historyPendingFilter=0;
    function locHistory() {
      if(!historyLoaded)return;
      const seq=++historyPendingFilter;
      const term=chuanHoaTimKiem(document.getElementById("history-search").value.trim());
      const kind=document.getElementById("history-type").value;
      const from=document.getElementById("history-from").value;
      const to=document.getElementById("history-to").value;
      historyPage=1;
      const selected=[];
      let at=0;
      function batch(){
        if(seq!==historyPendingFilter)return;
        const limit=Math.min(at+2000,historyAll.length);
        for(;at<limit;at++) {
          const row=historyAll[at];
          if(term&&!row.search.includes(term))continue;
          if(kind!=="all"&&row.type!==kind)continue;
          if(from&&(!row.date||row.date<from))continue;
          if(to&&(!row.date||row.date>to))continue;
          selected.push(row);
        }
        if(at<historyAll.length)requestAnimationFrame(batch);
        else {
          historyFiltered=selected;
          veTrangHistory();
        }
      }
      batch();
    }

    function veTrangHistory() {
      if(!historyLoaded)return;
      const headers=document.getElementById("history-head");
      headers.innerHTML='<tr><th scope="col">'+thoatHTML(tuDien("historyDirection"))+'</th>'+
        historyColumns.map(name=>'<th scope="col">'+thoatHTML(tenCotDaDich(name))+'</th>').join("")+'</tr>';
      const pages=Math.max(1,Math.ceil(historyFiltered.length/SO_DONG_HISTORY_MOI_TRANG));
      historyPage=Math.min(Math.max(1,historyPage),pages);
      const start=(historyPage-1)*SO_DONG_HISTORY_MOI_TRANG;
      const data=historyFiltered.slice(start,start+SO_DONG_HISTORY_MOI_TRANG);
      document.getElementById("history-body").innerHTML=data.map(rec=>{
        const label=rec.type==="in"?tuDien("historyInShort"):
          rec.type==="out"?tuDien("historyOutShort"):tuDien("historyOtherShort");
        return '<tr><td><span class="history-kind '+rec.type+'">'+thoatHTML(label)+'</span></td>'+
          rec.cells.map((val,j)=>{
            const accent=j===historyQuantityColumn?' class="history-quantity '+rec.type+'"':"";
            return '<td'+accent+' title="'+thoatHTML(val)+'">'+thoatHTML(val)+'</td>';
          }).join("")+'</tr>';
      }).join("") ||
        '<tr><td class="empty-table" colspan="'+Math.max(1,historyColumns.length+1)+'">'+
        thoatHTML(tuDien("historyNoResults"))+'</td></tr>';
      document.getElementById("history-matching").textContent=
        dinhDangSoLuong.format(historyFiltered.length);
      document.getElementById("history-count").textContent=tuDien("historyCount",{
        count:dinhDangSoLuong.format(historyFiltered.length),
        total:dinhDangSoLuong.format(historyAll.length)});
      document.getElementById("history-page").textContent=tuDien("historyPage",{current:historyPage,total:pages});
      document.getElementById("history-prev").disabled=historyPage<=1;
      document.getElementById("history-next").disabled=historyPage>=pages;
    }

    function doiTrangHistory(step){
      const max=Math.max(1,Math.ceil(historyFiltered.length/SO_DONG_HISTORY_MOI_TRANG));
      historyPage=Math.max(1,Math.min(max,historyPage+step));
      veTrangHistory();
      document.querySelector(".history-table-wrapper").scrollTop=0;
    }

    function xoaLocHistory(){
      for(const id of ["history-search","history-from","history-to"])
        document.getElementById(id).value="";
      chonLoaiHistory("all");
    }

    function capNhatNgonNguHistory(){
      capNhatNutLoaiHistory();
      if(historyLoaded) {
        capNhatTrangThaiHistory(historyStatusKey,{
          ...historyStatusArgs,count:dinhDangSoLuong.format(historyAll.length)});
        veTrangHistory();
      } else capNhatTrangThaiHistory(historyStatusKey,historyStatusArgs);
    }

    function caiDatNhacBaoCao() {
      ghiTuyChon("checking-report-reminder",document.getElementById("bao-cao-nhac-lich").value);
      kiemTraNhacBaoCao();
    }

    function kiemTraNhacBaoCao() {
      const choice=document.getElementById("bao-cao-nhac-lich");
      const message=document.getElementById("bao-cao-nhac-tin");
      if (!choice || !message) return;
      const mode=choice.value;
      if (mode==="off" || document.hidden || !chiMucSanSang) {
        message.textContent=tuDien("scheduleWaiting");return;
      }
      const date=new Date(),due=date.getHours()>=9 && (mode==="daily" || date.getDay()===1);
      message.textContent=due?tuDien("scheduleDue"):tuDien("scheduleWaiting");
    }

    function khoiTaoLichNhacBaoCao() {
      const mode=docTuyChon("checking-report-reminder");
      document.getElementById("bao-cao-nhac-lich").value=
        mode==="daily" || mode==="weekly" ? mode : "off";
      kiemTraNhacBaoCao();
    }

    // Lập chỉ mục theo nhóm, tránh khóa giao diện với bảng dữ liệu lớn.
    function taoChiMucTimKiem() {
      const lanHienTai = ++lanLapChiMuc;
      const chiSoBmNo = timCotTheoTen("BM No");
      // Prefer named headers; keep the existing quantity column position as a fallback.
      const cotSoLuong = tieuDeCot.findIndex(x =>
        ["quantity", "qty", "số lượng", "stock", "stock qty", "on hand", "tồn kho"].includes(String(x ?? "").trim().toLowerCase()));
      chiSoSoLuong = cotSoLuong >= 0 ? cotSoLuong : 3;
      chiSoReorderPoint = cotReorderPoint();
      danhSachGiaTri = [];
      analyticsReady = false;
      const chiSoGia = tieuDeCot.findIndex(x =>
        ["price", "unit price", "đơn giá", "giá"].includes(String(x ?? "").trim().toLowerCase()));
      let giaTriDaTinh = 0;
      let soDongGiaKhongHopLe = 0;
      duLieuTimKiem = [];
      soCoTonKho = 0;
      chiMucSanSang = false;
      dangLocDuLieu = true;
      let viTri = 1;
      const tong = Math.max(0, tatCaDuLieu.length - 1);
      document.getElementById("metric-total").textContent = dinhDangSoLuong.format(tong);
      document.getElementById("metric-instock").textContent = "…";
      document.getElementById("metric-attention").textContent = "…";
      tongGiaTriTonKho = null;
      soDongGiaTriKhongHopLe = 0;
      document.getElementById("metric-inventory-value").textContent = "…";
      document.getElementById("metric-value-note").textContent = tuDien("inventoryValueNote");
      document.getElementById("trang-thai-ban-ghi").textContent = tuDien("processing");
      document.getElementById("than-bang").innerHTML =
        '<tr><td colspan="6" class="empty-table">' + tuDien("preparing") + '</td></tr>';

      const groupColumn=tieuDeCot.findIndex(h=>["material group","materialgroup","matl group","group","nhóm vật tư","nhóm"].includes(String(h??"").trim().toLowerCase()));
      function xuLyNhom() {
        if (lanHienTai !== lanLapChiMuc) return;
        const gioiHan = Math.min(viTri + 1000, tatCaDuLieu.length);
        for (; viTri < gioiHan; viTri++) {
          const dong = tatCaDuLieu[viTri];
          if (!Array.isArray(dong)) continue;
          const giaTri = dong.map(ten => String(ten ?? "").toLowerCase());
          const soLuong = chuyenThanhSo(dong[chiSoSoLuong]);
          const coTonKho = soLuong > 0;
          const reorderPoint = chiSoReorderPoint >= 0 ? chuyenThanhSo(dong[chiSoReorderPoint]) : NaN;
          const trangThaiTon = trangThaiTheoReorderPoint(soLuong, reorderPoint);
          if (coTonKho) soCoTonKho++;
          // Inventory valuation uses all rows, independent of the active search/filter.
          // Do not count empty stock or non-numeric/negative prices as monetary value.
          let giaTriDong = 0;
          if (chiSoGia >= 0 && coTonKho) {
            const donGia = chuyenThanhSo(dong[chiSoGia]);
            const thanhTien = soLuong * donGia;
            if (Number.isFinite(donGia) && donGia >= 0 && Number.isFinite(thanhTien)) {
              giaTriDaTinh += thanhTien;
              giaTriDong = thanhTien;
              if (thanhTien > 0) danhSachGiaTri.push({sap:String(dong[0]??""),value:thanhTien,group:groupColumn>=0?String(dong[groupColumn]??""):"—"});
            } else {
              soDongGiaKhongHopLe++;
            }
          }
          duLieuTimKiem.push({
            chiSo: viTri,
            dong: dong,
            all: giaTri.join("\u0001"),
            sap: giaTri[0] || "",
            desc: giaTri[1] || "",
            part: giaTri[2] || "",
            bmno: chiSoBmNo >= 0 ? giaTri[chiSoBmNo] || "" : "",
            coTonKho: coTonKho, soLuong, reorderPoint, trangThaiTon, giaTriDong
          });
        }
        if (viTri < tatCaDuLieu.length) {
          setTimeout(xuLyNhom, 0);
        } else {
          chiMucSanSang = true;
          tongGiaTriTonKho = chiSoGia < 0 ? null : giaTriDaTinh;
          soDongGiaTriKhongHopLe = soDongGiaKhongHopLe;
          document.getElementById("metric-instock").textContent = dinhDangSoLuong.format(soCoTonKho);
          hienThiTongGiaTriKho();
          analyticsReady=true;
          capNhatThongKeNangCao();
          luuAnhChupKho();
          locDuLieu();
        }
      }
      xuLyNhom();
    }

    let boTriHoanTimKiem = null;
    let dangLocDuLieu = false;
    function yeuCauLocDuLieu() {
      clearTimeout(boTriHoanTimKiem);
      dangLocDuLieu = true;
      ++soLanLocDuLieu;
      trangHienTai = 1;
      boTriHoanTimKiem = setTimeout(locDuLieu, 170);
    }

    // Lọc theo từng nhịp animation frame và hủy các truy vấn đã lỗi thời.
    function locDuLieu() {
      clearTimeout(boTriHoanTimKiem);
      boTriHoanTimKiem = null;
      if (!chiMucSanSang) return;
      dangLocDuLieu = true;
      const tuKhoa = document.getElementById("o-tim-kiem").value.trim().toLowerCase();
      const cheDoTim = document.querySelector('input[name="truongTim"]:checked').value;
      const chiTonKho = document.getElementById("chk-ton-kho").checked;
      const locCanhBao=document.getElementById("loc-canh-bao").value;
      const {terms:nhieuTuKhoa,exactSap:danhSachSap}=phanTichTimKiem(tuKhoa,cheDoTim);
      const ganDung=document.getElementById("tim-gan-dung").checked;
      const truongTim = cheDoTim === "all" ? "all" : cheDoTim;
      const lanLocHienTai = ++soLanLocDuLieu;
      const moi = [];
      let viTri = 0;
      const tong = duLieuTimKiem.length;
      document.getElementById("trang-thai-ban-ghi").textContent = tuDien("searching");

      function xuLyNhom() {
        if (lanLocHienTai !== soLanLocDuLieu) return;
        const gioiHan = Math.min(viTri + 2500, tong);
        for (; viTri < gioiHan; viTri++) {
          const muc = duLieuTimKiem[viTri];
          const giaTri=muc[truongTim];
          const hopTuKhoa=danhSachSap
            ? danhSachSap.has(chuanHoaMaSap(muc.dong[0]).toLowerCase())
            : !tuKhoa || nhieuTuKhoa.some(term=>
                giaTri.includes(term) || (ganDung && coTuGanDung(giaTri,chuanHoaTimKiem(term))));
          if (hopTuKhoa && (!chiTonKho || muc.coTonKho) &&
              (locCanhBao==="all" || muc.trangThaiTon===locCanhBao)) moi.push(muc);
        }
        if (viTri < tong) {
          requestAnimationFrame(xuLyNhom);
          return;
        }
        ketQuaLoc = moi;
        sapXepKetQua();
        dangLocDuLieu = false;
        hienThiTrangHienTai();
        document.querySelector(".table-wrapper").scrollTop = 0;
        document.getElementById("trang-thai-ban-ghi").textContent =
          tuDien("records",{found:dinhDangSoLuong.format(ketQuaLoc.length), total:dinhDangSoLuong.format(tong)});

      }
      xuLyNhom();
    }

    function sapXepTheoCot(chiSoCot) {
      if (cotSapXep === chiSoCot) huongSapXep *= -1;
      else { cotSapXep = chiSoCot; huongSapXep = 1; }
      trangHienTai = 1;
      veTieuDe();
      locDuLieu();
    }

    function sapXepKetQua() {
      if (cotSapXep < 0) return;
      ketQuaLoc.sort((a, b) => {
        const giaTriA = String(a.dong[cotSapXep] ?? "").trim();
        const giaTriB = String(b.dong[cotSapXep] ?? "").trim();
        const soA = chuyenThanhSo(giaTriA);
        const soB = chuyenThanhSo(giaTriB);
        let ketQua;

        if (giaTriA === "" && giaTriB !== "") {
          ketQua = 1;
        } else if (giaTriA !== "" && giaTriB === "") {
          ketQua = -1;
        } else if (Number.isFinite(soA) && Number.isFinite(soB)) {
          ketQua = soA - soB;
        } else {
          ketQua = giaTriA.localeCompare(giaTriB, "vi", {
            numeric: true,
            sensitivity: "base"
          });
        }

        return ketQua * huongSapXep;
      });
    }

    function hienThiTrangHienTai() {
      const tongSoTrang = Math.max(1, Math.ceil(ketQuaLoc.length / SO_DONG_MOI_TRANG));
      if (trangHienTai > tongSoTrang) trangHienTai = tongSoTrang;
      const batDau = (trangHienTai - 1) * SO_DONG_MOI_TRANG;
      const mucTrenTrang = ketQuaLoc.slice(batDau, batDau + SO_DONG_MOI_TRANG);
      const html = mucTrenTrang.map(muc => {
        const selectedClass = muc.chiSo === dongDangChonIndex ? "selected" : "";
        const selectedAria = muc.chiSo === dongDangChonIndex ? "true" : "false";
        const o = COT_HIEN_THI.map(chiSoCot => {
          const giaTri = thoatHTML(hienThiGiaTri(chiSoCot, muc.dong[chiSoCot]));
          if (chiSoCot === 0) return '<td><span class="sap-code">' + giaTri + '</span></td>';
          if (chiSoCot === chiSoSoLuong) {
            const trangThai=muc.trangThaiTon||"unknown";
            const tooltip=tenTrangThaiTon(trangThai) +
              (Number.isFinite(muc.reorderPoint) ? ' · Reorder Point: '+muc.reorderPoint : '');
            return '<td><span class="stock-badge stock-'+trangThai+'" title="'+thoatHTML(tooltip)+'">' +
              (trangThai==="zero"?'⚠ ':'')+giaTri+'</span></td>';
          }
          return '<td>' + giaTri + '</td>';
        }).join("");
        return '<tr class="' + selectedClass + (muc.coTonKho ? '' : ' out-of-stock') + '" data-row-index="' + muc.chiSo +
          '" tabindex="0" aria-selected="' + selectedAria +
          '" onclick="chonDong(' + muc.chiSo + ', this)">' + o + '</tr>';
      }).join("");

      document.getElementById("than-bang").innerHTML = html ||
        '<tr><td colspan="6" class="empty-table">' + tuDien("noResults") + '</td></tr>';
      document.getElementById("thong-tin-trang").textContent = tuDien("page",{current:trangHienTai,total:tongSoTrang});
      document.getElementById("btn-trang-truoc").disabled = trangHienTai <= 1;
      document.getElementById("btn-trang-sau").disabled = trangHienTai >= tongSoTrang;
    }

    function doiTrang(buoc) {
      const tongSoTrang = Math.max(1, Math.ceil(ketQuaLoc.length / SO_DONG_MOI_TRANG));
      const trangMoi = trangHienTai + buoc;
      if (trangMoi < 1 || trangMoi > tongSoTrang) return;
      trangHienTai = trangMoi;
      hienThiTrangHienTai();
      document.querySelector(".table-wrapper").scrollTop = 0;
    }

    // Bottom-of-table auto-pagination. A small cooldown prevents one touch
    // gesture or a programmatic scroll reset from skipping several pages.
    let viTriCuonBangCu = 0;
    let mocChuyenTrangTuDong = 0;

    function xuLyCuonCuoiBang() {
      const vungBang = document.querySelector(".table-wrapper");
      if (!vungBang) return;
      const viTriHienTai = vungBang.scrollTop;
      const dangCuonXuong = viTriHienTai > viTriCuonBangCu + 1;
      viTriCuonBangCu = viTriHienTai;
      if (!dangCuonXuong || Date.now() < mocChuyenTrangTuDong) return;

      // Do not turn pages when the table is shorter than the scroll region.
      if (vungBang.scrollHeight <= vungBang.clientHeight + 24) return;
      const tongTrang = Math.max(1, Math.ceil(ketQuaLoc.length / SO_DONG_MOI_TRANG));
      if (trangHienTai >= tongTrang) return;
      if (viTriHienTai + vungBang.clientHeight < vungBang.scrollHeight - 24) return;

      mocChuyenTrangTuDong = Date.now() + 650;
      doiTrang(1);  // Preserves the existing Next/Previous button behavior.
      viTriCuonBangCu = 0;
    }

    function chonDongBangPhim(buoc) {
      if (ketQuaLoc.length === 0) return;

      const viTriHienTai = ketQuaLoc.findIndex(muc => muc.chiSo === dongDangChonIndex);
      let viTriMoi = viTriHienTai < 0
        ? (buoc > 0 ? 0 : ketQuaLoc.length - 1)
        : viTriHienTai + buoc;

      if (viTriMoi < 0 || viTriMoi >= ketQuaLoc.length) return;

      trangHienTai = Math.floor(viTriMoi / SO_DONG_MOI_TRANG) + 1;
      hienThiTrangHienTai();

      const mucMoi = ketQuaLoc[viTriMoi];
      const dongMoi = document.querySelector(
        '#than-bang tr[data-row-index="' + mucMoi.chiSo + '"]'
      );
      if (!dongMoi) return;

      chonDong(mucMoi.chiSo, dongMoi);
      dongMoi.scrollIntoView({ block: "nearest" });
    }

    function hienThiChiTiet(dongData) {
      let htmlChiTiet = "";
      const chiSoBm = timCotTheoTen("BM No");
      const sap=chuanHoaMaSap(dongData[0]).toLowerCase();
      const cardXuat='<div class="detail-item detail-outgoing" id="detail-issued" data-sap="'+thoatHTML(sap)+'"><label>'+
        thoatHTML(tuDien("issuedTitle"))+'</label><span aria-live="polite">…</span><small></small></div>';
      let hasPrice=false;
      for (let c = 0; c < tieuDeCot.length; c++) {
        if (c === chiSoBm) continue;
        const isPrice=["price","unit price","đơn giá","giá"].includes(String(tieuDeCot[c]).trim().toLowerCase())&&!hasPrice;
        const item='<div class="detail-item" data-col-index="' + c + '"><label>' +
          thoatHTML(tenCotDaDich(tieuDeCot[c])) + '</label><span>' +
          thoatHTML(hienThiGiaTri(c, dongData[c])) + '</span></div>';
        htmlChiTiet+=isPrice?'<div class="detail-price-stack">'+item+cardXuat+'</div>':item;
        if(isPrice)hasPrice=true;
      }
      if(!hasPrice)htmlChiTiet+=cardXuat;
      const luoiChiTiet = document.getElementById("luoi-chi-tiet");
      const cardBmNo = document.getElementById("bm-no-card");
      cardBmNo.remove();
      luoiChiTiet.innerHTML = htmlChiTiet;
      luoiChiTiet.appendChild(cardBmNo);
      capNhatCardBmNo(dongData);
      capNhatCardXuat();
      if(!issuedRequested&&!historyLoaded&&!historyLoading) {
        issuedRequested=true;
        // Let the selected material image start before downloading the history.
        setTimeout(()=>taiHistory(),150);
      }
    }

    function chonDong(index, element) {
      document.querySelectorAll("#than-bang tr").forEach(tr => {
        tr.classList.remove("selected");
        tr.setAttribute("aria-selected", "false");
      });
      element.classList.add("selected");
      element.setAttribute("aria-selected", "true");
      dongDangChonIndex = index;

      const dongData = tatCaDuLieu[index];
      const maSap = chuanHoaMaSap(dongData[0]); // Cột đầu tiên là Mã SAP
      document.getElementById("nhan-sap").textContent = tuDien("sapCode",{code:maSap || "—"});
      document.getElementById("chi-tiet-trong").style.display = "none";

      // Keep image/navigation state intact when re-rendering translated details.
      hienThiChiTiet(dongData);

      // Tải hình ảnh tương ứng với Mã SAP
      taiBoSuuTapAnh(maSap);
      if (window.matchMedia("(max-width: 900px)").matches) {
        document.querySelector(".detail-section").scrollIntoView({ behavior: "smooth", block: "start" });
      }
    }

    let lanTaiAnh = 0;
    let dangQuetAnh = false;
    const boNhoAnh = new Map();
    const dangKiemTraAnh = new Map();
    const boNhoBoSuuTap = new Map();

    // HEAD kiểm tra tên tệp mà không tải toàn bộ ảnh. Fallback Image() nếu
    // chạy file://, ổ mạng, hoặc server không hỗ trợ HEAD.
    function kiemTraAnh(url) {
      const daLuu = boNhoAnh.get(url);
      if (daLuu && daLuu.hetHan > Date.now()) return Promise.resolve(daLuu.coAnh);
      if (dangKiemTraAnh.has(url)) return dangKiemTraAnh.get(url);

      const tacVu = (async function() {
        let coAnh;
        if (location.protocol === "http:" || location.protocol === "https:") {
          const controller = new AbortController();
          const gioiHan = setTimeout(() => controller.abort(), 3000);
          try {
            const response = await fetch(url, {
              method: "HEAD", cache: "force-cache", signal: controller.signal
            });
            if (response.status === 404) {
              coAnh = false;
            } else if (response.ok) {
              const loai = (response.headers.get("content-type") || "").toLowerCase();
              coAnh = !loai || loai.startsWith("image/") || loai.includes("octet-stream");
            }
          } catch (e) {
            // Trình duyệt hoặc server không hỗ trợ HEAD: thử Image().
          } finally {
            clearTimeout(gioiHan);
          }
        }

        if (coAnh === undefined) {
          coAnh = await new Promise(resolve => {
            const img = new Image();
            let xong = false;
            const gioiHan = setTimeout(() => ketThuc(false), 5000);
            function ketThuc(ok) {
              if (xong) return;
              xong = true;
              clearTimeout(gioiHan);
              img.onload = null;
              img.onerror = null;
              resolve(ok);
            }
            img.onload = () => ketThuc(true);
            img.onerror = () => ketThuc(false);
            img.src = url;
          });
        }

        boNhoAnh.set(url, {
          coAnh: coAnh, hetHan: Date.now() + (coAnh ? 600000 : 60000)
        });
        if (boNhoAnh.size > 600) boNhoAnh.delete(boNhoAnh.keys().next().value);
        return coAnh;
      })();

      dangKiemTraAnh.set(url, tacVu);
      return tacVu.finally(() => dangKiemTraAnh.delete(url));
    }

    // Optional Material/manifest.json: {"SAP001":["SAP001_01.jpg","SAP001_02.png"]}.
    // A manifest avoids up to 22 HEAD requests per SAP; missing files fall back to scanning.
    let promiseManifestAnh = null;
    const bienTheAnh=new Map();
    function taiManifestAnh() {
      if(window.MaterialImageManifest&&typeof window.MaterialImageManifest==="object")
        return Promise.resolve(window.MaterialImageManifest);
      if(!promiseManifestAnh) {
        promiseManifestAnh=new Promise(resolve=>{
          const script=document.createElement("script");
          let done=false;
          const finish=value=>{if(done)return;done=true;clearTimeout(timer);script.remove();resolve(value);};
          const timer=setTimeout(()=>finish(null),2500);
          script.src=THU_MUC_HINH+"manifest.js";
          script.onload=()=>finish(window.MaterialImageManifest||null);
          script.onerror=()=>finish(null);
          document.head.appendChild(script);
        }).then(async data=>{
          if(data||!/^https?:$/.test(location.protocol))return data;
          const controller=new AbortController();
          const timer=setTimeout(()=>controller.abort(),2500);
          try {
            const response=await fetch(THU_MUC_HINH+"manifest.json",{cache:"no-cache",signal:controller.signal});
            return response.ok?await response.json():null;
          }catch{return null;}finally{clearTimeout(timer);}
        }).then(data=>data&&typeof data==="object"&&!Array.isArray(data)?data:null);
      }
      return promiseManifestAnh;
    }

    function hinhAnhTuManifest(manifest,sap) {
      if(!manifest)return null;
      const modern=manifest.version===2&&manifest.materials&&typeof manifest.materials==="object";
      const entries=modern?manifest.materials:manifest;
      if(!Object.prototype.hasOwnProperty.call(entries,sap))
        return modern&&manifest.complete===true?[]:null;
      const names=entries[sap];
      if(!Array.isArray(names))return null;
      const valid=name=>typeof name==="string"&&/^(?:_optimized\/)?[a-zA-Z0-9_. -]+\.(?:jpg|jpeg|png|webp)$/i.test(name);
      const url=name=>THU_MUC_HINH+name.split("/").map(encodeURIComponent).join("/");
      const images=[];
      for(const item of names) {
        const original=typeof item==="string"?item:item?.original;
        if(!valid(original))continue;
        const src=url(original);
        bienTheAnh.set(src,{
          preview:valid(item?.preview)?url(item.preview):src,
          thumb:valid(item?.thumb)?url(item.thumb):src
        });
        images.push(src);
      }
      return [...new Set(images)];
    }
    function duongDanAnh(src,kind) {return bienTheAnh.get(src)?.[kind]||src;}
    function ganAnh(img,src,original,priority="auto") {
      if(img.dataset.requested===src)return;
      img.dataset.requested=src;
      img.decoding="async";img.fetchPriority=priority;
      img.onerror=()=>{if(img.dataset.requested===src&&img.getAttribute("src")!==original)img.src=original;};
      img.src=src;
    }

    // Chỉ 4 tác vụ kiểm tra đồng thời, giữ dữ liệu từ SAP đã xem gần đây.
    async function taiBoSuuTapAnh(maSap) {
      const lanHienTai = ++lanTaiAnh;
      maSapDangXem = chuanHoaMaSap(maSap);
      danhSachAnhDangXem = [];
      viTriAnhDangXem = 0;
      dangQuetAnh = Boolean(maSapDangXem);
      capNhatGiaoDienAnh();
      if (!maSapDangXem) return;

      const boDaCo = boNhoBoSuuTap.get(maSapDangXem);
      if (boDaCo && boDaCo.hetHan > Date.now()) {
        danhSachAnhDangXem = boDaCo.urls.slice();
        dangQuetAnh = false;
        capNhatGiaoDienAnh();
        return;
      }

      const manifest=await taiManifestAnh();
      if(lanHienTai!==lanTaiAnh)return;
      const daBiet=hinhAnhTuManifest(manifest,maSapDangXem);
      if(daBiet!==null) {
        danhSachAnhDangXem=daBiet;
        dangQuetAnh=false;
        boNhoBoSuuTap.set(maSapDangXem,{urls:daBiet.slice(),hetHan:Date.now()+300000});
        capNhatGiaoDienAnh();
        return;
      }
      const danhSachTen = [];
      for (let k = 1; k <= SO_ANH_TOI_DA; k++) {
        const hauTo = String(k).padStart(2, "0");
        danhSachTen.push(maSapDangXem + "_" + hauTo + ".jpg");
        danhSachTen.push(maSapDangXem + "_" + hauTo + ".png");
      }
      danhSachTen.push(maSapDangXem + ".jpg", maSapDangXem + ".png");

      const hangDoi = [...new Set(danhSachTen)];
      let viTri = 0;
      async function congNhan() {
        while (viTri < hangDoi.length && lanHienTai === lanTaiAnh) {
          const url = THU_MUC_HINH + encodeURIComponent(hangDoi[viTri++]);
          const tonTai = await kiemTraAnh(url);
          if (tonTai && lanHienTai === lanTaiAnh && !danhSachAnhDangXem.includes(url)) {
            const anhDangChon = danhSachAnhDangXem[viTriAnhDangXem];
            danhSachAnhDangXem.push(url);
            danhSachAnhDangXem.sort();
            viTriAnhDangXem = anhDangChon
              ? danhSachAnhDangXem.indexOf(anhDangChon) : 0;
            capNhatGiaoDienAnh();
          }
        }
      }

      await Promise.all([congNhan(), congNhan(), congNhan(), congNhan()]);
      if (lanHienTai !== lanTaiAnh) return;
      dangQuetAnh = false;
      boNhoBoSuuTap.set(maSapDangXem, {
        urls: danhSachAnhDangXem.slice(),
        hetHan: Date.now() + (danhSachAnhDangXem.length ? 300000 : 60000)
      });
      if (boNhoBoSuuTap.size > 80) boNhoBoSuuTap.delete(boNhoBoSuuTap.keys().next().value);
      capNhatGiaoDienAnh();
    }

    // Chuẩn bị ảnh tiếp theo sau khi chuyển ảnh để thao tác mượt hơn.
    function napTruocAnhKeTiep() {
      if (danhSachAnhDangXem.length < 2) return;
      const url = danhSachAnhDangXem[(viTriAnhDangXem + 1) % danhSachAnhDangXem.length];
      const anh = new Image();
      anh.decoding = "async";
      anh.fetchPriority="low";
      anh.src = duongDanAnh(url,"preview");
    }

    function capNhatAnhThuNho() {
      const holder=document.getElementById("image-thumbnails");
      const key=danhSachAnhDangXem.join("\u0001");
      if(holder.dataset.galleryKey!==key) {
        holder.dataset.galleryKey=key;
        holder.innerHTML="";
        danhSachAnhDangXem.forEach((src,index)=>{
          const btn=document.createElement("button");
          btn.type="button";
          btn.className="image-thumb";
          btn.setAttribute("aria-label", (index+1)+" / "+danhSachAnhDangXem.length);
          const img=document.createElement("img");
          img.alt="";img.loading="lazy";img.width=55;img.height=55;
          ganAnh(img,duongDanAnh(src,"thumb"),src,"low");
          btn.appendChild(img);
          btn.addEventListener("click",()=>{
            viTriAnhDangXem=index;
            capNhatGiaoDienAnh();napTruocAnhKeTiep();
          });
          holder.appendChild(btn);
        });
      }
      [...holder.children].forEach((btn,index)=>
        btn.setAttribute("aria-pressed",String(index===viTriAnhDangXem)));
    }

    function capNhatGiaoDienAnh() {
      const imgEl = document.getElementById("anh-chinh");
      const btnPrev = document.getElementById("btn-anh-truoc");
      const btnNext = document.getElementById("btn-anh-sau");
      const counterEl = document.getElementById("dem-anh");
      const khuVucTrong = document.getElementById("anh-trong");
      const thongBaoAnh = khuVucTrong.querySelector("span:last-child");
      const tong = danhSachAnhDangXem.length;
      khuVucTrong.style.display = tong > 0 ? "none" : "grid";
      if (tong > 0) {
        if (viTriAnhDangXem >= tong) viTriAnhDangXem = 0;
        const src = danhSachAnhDangXem[viTriAnhDangXem];
        const preview=duongDanAnh(src,"preview");
        ganAnh(imgEl,preview,src,"high");
        const lightboxImg = document.getElementById("lightbox-img");
        if (document.getElementById("lightbox").style.display === "flex" &&
            lightboxImg.getAttribute("src") !== src) {
          lightboxImg.src = src;
          datLaiZoom();
        }
        counterEl.textContent = tuDien("imagesCount",{current:viTriAnhDangXem+1,total:tong}) +
          (dangQuetAnh ? tuDien("imagesLoading") : "");
        btnPrev.style.display = tong > 1 ? "block" : "none";
        btnNext.style.display = tong > 1 ? "block" : "none";
      } else {
        imgEl.removeAttribute("src");
        delete imgEl.dataset.requested;imgEl.onerror=null;
        document.getElementById("lightbox-img").removeAttribute("src");
        thongBaoAnh.textContent = dangQuetAnh ? tuDien("imagesSearching") :
          (maSapDangXem ? tuDien("imagesNone") : tuDien("selectSapImage"));
        counterEl.textContent = tuDien(dangQuetAnh ? "imagesFinding" : "imagesEmpty");
        btnPrev.style.display = "none";
        btnNext.style.display = "none";
      }
      capNhatAnhThuNho();
    }

    function doiAnhChiTiet(buoc, e) {
      e.stopPropagation();
      const tong = danhSachAnhDangXem.length;
      if (tong <= 1) return;
      viTriAnhDangXem = (viTriAnhDangXem + buoc + tong) % tong;
      capNhatGiaoDienAnh();
      napTruocAnhKeTiep();
    }

    function phongToAnh() {
      const anh = document.getElementById("anh-chinh");
      if (!danhSachAnhDangXem.length || !anh.hasAttribute("src")) return;
      document.getElementById("lightbox-img").src = danhSachAnhDangXem[viTriAnhDangXem];
      document.getElementById("lightbox").style.display = "flex";
      datLaiZoom();
    }

    function dongLightbox(e) {
      if (e) e.stopPropagation();
      document.getElementById("lightbox").style.display = "none";
      datLaiZoom();
    }

    function doiAnhLightbox(buoc, e) {
      if (e) e.stopPropagation();
      doiAnhChiTiet(buoc, { stopPropagation() {} });
    }

    function thayDoiZoom(buoc) {
      mucZoom = Math.min(3, Math.max(.5, mucZoom + buoc));
      capNhatZoom();
    }

    function datLaiZoom() {
      mucZoom = 1;
      capNhatZoom();
    }

    function capNhatZoom() {
      const img = document.getElementById("lightbox-img");
      const mucPhanTram = Math.round(mucZoom * 100);

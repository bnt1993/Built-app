        <span class="online-pill loading" id="tinh-trang-du-lieu" role="status" data-status="connecting">Đang kết nối</span>
        <button type="button" class="btn btn-secondary" onclick="taiDuLieu()" data-i18n-title="refreshTitle" title="Đồng bộ dữ liệu từ nguồn">↻ <span data-i18n="refresh">Đồng bộ</span></button>
      </div>
    </header>

    <main class="workspace">
      <div class="breadcrumbs"><span>Workspace</span><span>/</span><span class="active" data-i18n="breadcrumb">Tổng quan vật tư</span></div>
      <div class="intro">
        <h1><span data-i18n="heroFirst">Quản lý vật tư</span> <span data-i18n="heroAccent">thông minh.</span></h1>
        <p data-i18n="heroDesc">Tra cứu mã SAP, theo dõi tồn kho và xem hình ảnh vật tư trong cùng một không gian làm việc.</p>
      </div>

      <section class="metric-grid" data-i18n-aria="metricsAria" aria-label="Thống kê tồn kho">
        <div class="metric-card">
          <div class="metric-text"><div class="metric-label" data-i18n="totalMaterials">Tổng vật tư</div><strong class="metric-value" id="metric-total">—</strong><span class="metric-note" data-i18n="totalNote">Mã SAP trong hệ thống</span></div>
          <div class="metric-icon" aria-hidden="true">▦</div>
        </div>
        <div class="metric-card">
          <div class="metric-text"><div class="metric-label" data-i18n="inStock">Còn hàng</div><strong class="metric-value" id="metric-instock">—</strong><span class="metric-note" data-i18n="stockNote">Số dòng có tồn kho &gt; 0</span></div>
          <div class="metric-icon" aria-hidden="true">✓</div>
        </div>
        <div class="metric-card">
          <div class="metric-text"><div class="metric-label" data-i18n="filteredResults">Kết quả lọc</div><strong class="metric-value" id="metric-results">—</strong><span class="metric-note" data-i18n="resultNote">Theo tìm kiếm hiện tại</span></div>
          <div class="metric-icon" aria-hidden="true">⌕</div>
        </div>
      </section>

      <section class="toolbar" data-i18n-aria="searchFilters" aria-label="Tìm kiếm và bộ lọc">
        <div class="toolbar-primary">
          <div class="search-box-group">
            <div class="search-input">
              <input type="search" id="o-tim-kiem" autocomplete="off" data-i18n-aria="searchAria" aria-label="Tìm mã SAP, mô tả, part no" data-i18n-placeholder="searchPlaceholder" placeholder="Tìm mã SAP, mô tả hoặc Part No..." oninput="yeuCauLocDuLieu()">
              <span class="search-hint" aria-hidden="true">/</span>
            </div>
            <button type="button" class="btn btn-primary" onclick="locDuLieu()" data-i18n="search">Tìm kiếm</button>
            <button type="button" class="btn btn-secondary" onclick="lamMoi()" data-i18n="clear">Xóa</button>
          </div>
          <button type="button" class="btn btn-soft" onclick="xuatExcel()">↓ <span data-i18n="export">Xuất báo cáo Excel (.xlsx)</span></button>
        </div>
        <div class="toolbar-filters">
          <span class="filter-label" data-i18n="searchIn">Tìm trong</span>
          <div class="radio-group" role="group" data-i18n-aria="searchScopeAria" aria-label="Phạm vi tìm kiếm">
            <label><input type="radio" name="truongTim" value="all" onchange="yeuCauLocDuLieu()" checked><span data-i18n="searchAll">Tất cả</span></label>
            <label><input type="radio" name="truongTim" value="sap" onchange="yeuCauLocDuLieu()"><span data-i18n="searchSap">Mã SAP</span></label>
            <label><input type="radio" name="truongTim" value="desc" onchange="yeuCauLocDuLieu()"><span data-i18n="searchDesc">Mô tả</span></label>
            <label><input type="radio" name="truongTim" value="part" onchange="yeuCauLocDuLieu()"><span data-i18n="searchPart">Part No</span></label>

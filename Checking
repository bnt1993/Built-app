      const thuTu = option.sortCol >= 0 ?
        tenCotDaDich(tieuDeCot[option.sortCol]) + (option.sortDir === -1 ? " ↓" : " ↑") :
        tuDien("reportNoSort");
      const ngayBaoCao = new Date().toLocaleString(locale);
      const boLoc = [
        [tuDien("reportKeyword"), moTaLoc],
        [tuDien("reportScope"), phamVi],
        [tuDien("reportStockOnly"), option.onlyStock ? tuDien("reportYes") : tuDien("reportNo")],
        [tuDien("reportSort"), thuTu],
        [tuDien("reportUpdated"), option.updated || "—"],
        [tuDien("reportGenerated"), ngayBaoCao],
        [tuDien("reportStockStatus"),tuDien({all:"stockAny",healthy:"stockAbove",at:"stockEqual",below:"stockBelow",zero:"stockZero",unknown:"stockUnknown"}[option.status]||"stockAny")],
        [tuDien("reportFuzzy"),option.fuzzy?tuDien("reportYes"):tuDien("reportNo")]
      ];

      // Detail sheet: complete original SAP columns plus calculated line value.
      const header = tieuDeCot.map(tenCotDaDich);
      if (themThanhTien) header.push(tuDien("reportLineValue"));
      const widths = header.map((h,i) =>
        Math.min(45,Math.max(i === 1 ? 27 : 14, Math.min(35,String(h).length + 3))));
      const sample = Math.min(src.length, 250);
      for (let i = 0; i < sample; i++) {
        for (let col = 0; col < soCotNguon; col++) {
          const len = String(src[i].dong[col] ?? "").length;
          widths[col] = Math.min(col === 1 ? 46 : 34, Math.max(widths[col], Math.min(len+2,34)));
        }
      }
      if (themThanhTien) widths[cotCuoi-1] = 23;

      const rows = [];
      const merges = [];
      const mergeFull = row => { if (cotCuoi > 1) merges.push("A"+row+":"+tenCotCuoi+row); };
      const bigRow = (row, text, style, height) => {
        rows.push(hangXlsx(row, [oChuXlsx(0,row,text,style)],height));
        mergeFull(row);
      };
      bigRow(1,tuDien("reportDetailTitle"),1,42);
      bigRow(2,tuDien("reportSubtitle") + " | " + phamVi,2,26);
      bigRow(3,tuDien("reportKeyword") + ": " + moTaLoc +
        "   |   " + tuDien("reportStockOnly") + ": " +
        (option.onlyStock ? tuDien("reportYes") : tuDien("reportNo")),2,25);
      bigRow(4,tuDien("reportGenerated") + ": " + ngayBaoCao,2,25);
      rows.push(hangXlsx(6,header.map((h,col)=>oChuXlsx(col,6,h,7)),30));

      let tonKho = 0, conHang = 0, giaTri = 0, dongGiaLoi = 0;
      for (let i = 0; i < src.length; i++) {
        if (i > 0 && i % 1200 === 0) await new Promise(resolve => setTimeout(resolve, 0));
        const rec = src[i].dong;
        const row = i + 7;
        const qty = chuyenThanhSo(rec[colQty]);
        const stock = Number.isFinite(qty) && qty > 0;
        const reorder = colReorder >= 0 ? chuyenThanhSo(rec[colReorder]) : NaN;
        const stockLevel = trangThaiTheoReorderPoint(qty,reorder);
        const levelStyle = {healthy:20,at:21,below:22,zero:23,unknown:24}[stockLevel];
        if (stock) { tonKho += qty; conHang++; }
        const price = themThanhTien ? chuyenThanhSo(rec[colPrice]) : NaN;
        const validPrice = Number.isFinite(price) && price >= 0;
        const lineValue = stock && validPrice ? qty * price : 0;
        if (stock && themThanhTien && (!validPrice || !Number.isFinite(lineValue))) dongGiaLoi++;
        if (Number.isFinite(lineValue) && lineValue > 0) giaTri += lineValue;

        const even = i % 2 === 0;
        const stockStyle = stock ? (even ? 8 : 9) : 14;
        const qtyStyle = stock ? (even ? 12 : 13) : 15;
        const moneyStyle = stock ? (even ? 10 : 11) : 16;
        const cells = [];
        for (let j = 0; j < soCotNguon; j++) {
          const raw = rec[j] ?? "";
          const num = j === colQty ? qty : j === colPrice ? price : NaN;
          if (raw !== "" && Number.isFinite(num)) {
            cells.push(oSoXlsx(j,row,num,j === colPrice ? moneyStyle : j===colQty ? levelStyle : qtyStyle));
          } else {
            cells.push(oChuXlsx(j,row,raw,j===colQty?levelStyle:stockStyle));
          }
        }
        if (themThanhTien) {
          // Keep line amount editable in Excel and cache its numeric result.
          const refQty = tenCotXlsx(colQty) + row;
          const refPrice = tenCotXlsx(colPrice) + row;
          const formula = 'IF(AND(ISNUMBER(' + refQty + '),ISNUMBER(' + refPrice +
            '),' + refQty + '>0,' + refPrice + '>=0),' +
            refQty + '*' + refPrice + ',0)';
          if (Number.isFinite(qty) && validPrice && Number.isFinite(lineValue)) {
            cells.push(oSoXlsx(soCotNguon,row,lineValue,moneyStyle,formula));
          } else {
            cells.push(oChuXlsx(soCotNguon,row,"",stockStyle));
          }
        }
        rows.push(hangXlsx(row,cells,23));
      }
      const lastDataRow = Math.max(6,6+src.length);
      if (themThanhTien) {
        const sumRow = lastDataRow + 2;
        const formula = 'SUM(' + tenCotCuoi + '7:' + tenCotCuoi + lastDataRow + ')';
        rows.push(hangXlsx(sumRow,[
          oChuXlsx(0,sumRow,tuDien("reportValuation"),18),
          oSoXlsx(cotCuoi-1,sumRow,giaTri,19,formula)
        ],29));
        if (cotCuoi > 2) merges.push("A"+sumRow+":"+tenCotXlsx(cotCuoi-2)+sumRow);
      }
      const colsXml = widths.map((width,i) => '<col min="' +(i+1)+
        '" max="'+(i+1)+'" width="'+width+'" customWidth="1"/>').join("");
      const sheetNs = 'http://schemas.openxmlformats.org/spreadsheetml/2006/main';
      const sheetDetails = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' +
        '<worksheet xmlns="' + sheetNs + '"><dimension ref="A1:' +
        tenCotCuoi + (lastDataRow+(themThanhTien?2:0)) + '"/>' +
        '<sheetViews><sheetView showGridLines="0" workbookViewId="0">' +
        '<pane ySplit="6" topLeftCell="A7" activePane="bottomLeft" state="frozen"/>' +
        '<selection pane="bottomLeft" activeCell="A7" sqref="A7"/></sheetView></sheetViews>' +
        '<sheetFormatPr defaultRowHeight="22"/><cols>'+colsXml+'</cols><sheetData>' +
        rows.join("") + '</sheetData><autoFilter ref="A6:' +
        tenCotCuoi + lastDataRow + '"/>' +
        '<mergeCells count="'+merges.length+'">' +
        merges.map(x=>'<mergeCell ref="'+x+'"/>').join("") +
        '</mergeCells>' +
         '<pageMargins left="0.3" right="0.3" top="0.5" bottom="0.5" header="0.2" footer="0.2"/>' +
         '<pageSetup orientation="landscape" fitToWidth="1" fitToHeight="0"/></worksheet>';

      // Overview sheet with large title, 6 key metrics and report audit details.
      const s = [], mergeSummary = [];
      const full = row => mergeSummary.push("A"+row+":H"+row);
      const textRow = (r,text,style,height) => {
        s.push(hangXlsx(r,[oChuXlsx(0,r,text,style)],height));full(r);
      };
      textRow(1,tuDien("reportTitle"),1,44);
      textRow(2,tuDien("reportSubtitle"),2,25);
      textRow(3,tuDien("reportGenerated")+": "+ngayBaoCao,2,24);
      textRow(4,tuDien("reportDisclaimer"),17,25);
      textRow(6,tuDien("reportSummarySection"),3,30);
      const stats = [
        [tuDien("reportCount"),src.length,5],
        [tuDien("reportInStock"),conHang,5],
        [tuDien("reportOutStock"),src.length-conHang,5],
        [tuDien("reportQuantity"),tonKho,5],
        [tuDien("reportValuation"),themThanhTien ? giaTri : null,19],
        [tuDien("reportMissing"),dongGiaLoi,5]
      ];
      for (let i=0;i<stats.length;i++) {
        const r=8+i, [name,value,style]=stats[i];
        s.push(hangXlsx(r,[
          oChuXlsx(0,r,name,style===19?18:4),
          value===null ? oChuXlsx(3,r,"—",style) : oSoXlsx(3,r,value,style,
            style===19 ? "SUM('"+tenSheetChiTiet+"'!"+tenCotCuoi+"7:"+tenCotCuoi+lastDataRow+")" : "")
        ],29));
        mergeSummary.push("A"+r+":C"+r,"D"+r+":H"+r);
      }
      textRow(15,tuDien("reportFilterSection"),3,30);
      for(let i=0;i<boLoc.length;i++) {
        const r=17+i;
        s.push(hangXlsx(r,[oChuXlsx(0,r,boLoc[i][0],4),
          oChuXlsx(3,r,boLoc[i][1],8)],26));
        mergeSummary.push("A"+r+":C"+r,"D"+r+":H"+r);
      }
      textRow(28,tuDien("reportNote"),17,28);
      const sumCols = '<cols><col min="1" max="1" width="23" customWidth="1"/>' +
        '<col min="2" max="3" width="14" customWidth="1"/>' +
        '<col min="4" max="4" width="26" customWidth="1"/>' +
        '<col min="5" max="8" width="14" customWidth="1"/></cols>';
      const sheetOverview = '<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' +
        '<worksheet xmlns="' + sheetNs + '"><dimension ref="A1:H28"/>' +
        '<sheetViews><sheetView showGridLines="0" workbookViewId="0"/></sheetViews>' +
        '<sheetFormatPr defaultRowHeight="22"/>'+sumCols+'<sheetData>' +
        s.join("") + '</sheetData><mergeCells count="'+mergeSummary.length+'">' +
        mergeSummary.map(x=>'<mergeCell ref="'+x+'"/>').join("") +
        '</mergeCells>' +
         '<pageMargins left="0.35" right="0.35" top="0.5" bottom="0.5" header="0.2" footer="0.2"/>' +
         '<pageSetup orientation="portrait" fitToWidth="1" fitToHeight="1"/></worksheet>';
      const packType = 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';
      const files = [
        {name:"[Content_Types].xml",data:'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' +
          '<Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types">' +
          '<Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/>' +
          '<Default Extension="xml" ContentType="application/xml"/>' +
          '<Override PartName="/xl/workbook.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet.main+xml"/>' +
          '<Override PartName="/xl/styles.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.styles+xml"/>' +
          '<Override PartName="/xl/worksheets/sheet1.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>' +
          '<Override PartName="/xl/worksheets/sheet2.xml" ContentType="application/vnd.openxmlformats-officedocument.spreadsheetml.worksheet+xml"/>' +
          '</Types>'},
        {name:"_rels/.rels",data:'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' +
          '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">' +
          '<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="xl/workbook.xml"/>' +
          '</Relationships>'},
        {name:"xl/workbook.xml",data:'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' +
          '<workbook xmlns="'+sheetNs+'" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships">' +
          '<bookViews><workbookView/></bookViews><sheets>' +
          '<sheet name="'+tenSheetTongQuan+'" sheetId="1" r:id="rId1"/>' +
          '<sheet name="'+tenSheetChiTiet+'" sheetId="2" r:id="rId2"/></sheets>' +
          '<calcPr calcId="191029" fullCalcOnLoad="1"/></workbook>'},
        {name:"xl/_rels/workbook.xml.rels",data:'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>' +
          '<Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships">' +
          '<Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet1.xml"/>' +
          '<Relationship Id="rId2" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/worksheet" Target="worksheets/sheet2.xml"/>' +
          '<Relationship Id="rId3" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/styles" Target="styles.xml"/>' +
          '</Relationships>'},
        {name:"xl/styles.xml",data:taoKieuXlsx()},
        {name:"xl/worksheets/sheet1.xml",data:sheetOverview},
        {name:"xl/worksheets/sheet2.xml",data:sheetDetails}
      ];
      return new Blob([dongGoiZipXlsx(files)],{type:packType});
    }

    let dangXuatExcel = false;
    async function xuatExcel() {
      if (dangXuatExcel) return;
      if (!chiMucSanSang || dangLocDuLieu) {
        alert(tuDien("exportBusy"));
        return;
      }
      if (!tieuDeCot.length || !ketQuaLoc.length) {
        alert(tuDien("noExport"));
        return;
      }
      const mode = document.querySelector('input[name="truongTim"]:checked').value;
      const options = {
        keyword: document.getElementById("o-tim-kiem").value.trim(),
        scope: mode,
        onlyStock: document.getElementById("chk-ton-kho").checked,
        status:document.getElementById("loc-canh-bao").value,
        fuzzy:document.getElementById("tim-gan-dung").checked,
        sortCol: cotSapXep, sortDir: huongSapXep, updated: mocCapNhatCu
      };
      const nutXuat = document.getElementById("btn-xuat-excel");
      const nhanXuat = nutXuat.querySelector('[data-i18n="export"]');
      dangXuatExcel = true;
      nutXuat.disabled = true;
      nutXuat.setAttribute("aria-busy", "true");
      nhanXuat.textContent = tuDien("exportGenerating");
      try {
        await new Promise(resolve => setTimeout(resolve, 0));
        const blob = await taoBaoCaoXlsx(ketQuaLoc,options);
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        const date = new Date().toLocaleDateString("sv-SE");
        const time = new Date().toTimeString().slice(0, 5).replace(":", "");
        a.download = "SAP_Inventory_Report_" + date + "_" + time + ".xlsx";
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url),1500);
      } catch(err) {
        console.error("XLSX export:",err);
        alert(tuDien(err.message === "XLSX_EXCEL_LIMIT" ? "exportTooMany" : "exportFailed"));
      } finally {
        dangXuatExcel = false;
        nutXuat.disabled = false;
        nutXuat.removeAttribute("aria-busy");
        nhanXuat.textContent = tuDien("export");
      }
    }


    // A row's context-menu actions always target the row under the pointer.
    // Stock data remains read-only: "Export material" downloads its information,
    // never records an OUTPUT movement or edits History.js.
    let stockMenuIndex=-1;
    let stockMenuToastTimer=null;

    function dongMenuVatTu(traLaiFocus=false) {
      const menu=document.getElementById("stock-row-menu");
      const index=stockMenuIndex;
      menu.hidden=true;
      stockMenuIndex=-1;
      if(traLaiFocus&&index>=0) {
        const row=document.querySelector('#than-bang tr[data-row-index="'+index+'"]');
        if(row)row.focus({preventScroll:true});
      }
    }

    function moMenuVatTu(event,row) {
      const index=Number(row?.dataset.rowIndex);
      if(!Number.isInteger(index)||index<0||index>=tatCaDuLieu.length||
        !tatCaDuLieu[index])return;
      event.preventDefault();
      // Use the application's normal row-selection path to keep details in sync.
      chonDong(index,row);
      stockMenuIndex=index;
      const menu=document.getElementById("stock-row-menu");
      menu.hidden=false;
      // First place it on-screen so bounding dimensions are measurable.
      menu.style.left="0px";
      menu.style.top="0px";
      const bounds=menu.getBoundingClientRect();
      const x=Math.max(8,Math.min(event.clientX,window.innerWidth-bounds.width-8));
      const y=Math.max(8,Math.min(event.clientY,window.innerHeight-bounds.height-8));
      menu.style.left=x+"px";
      menu.style.top=y+"px";
      menu.querySelector('[role="menuitem"]')?.focus({preventScroll:true});
    }

    function thongBaoMenuVatTu(key,params={}) {
      const toast=document.getElementById("stock-menu-toast");
      toast.textContent=tuDien(key,params);
      toast.hidden=false;
      clearTimeout(stockMenuToastTimer);
      stockMenuToastTimer=setTimeout(()=>{toast.hidden=true;},2600);
    }

    async function saoChepTuMenu(value) {
      // Clipboard API may be unavailable on file:// and internal SAP networks.
      if(navigator.clipboard?.writeText) {
        try {await navigator.clipboard.writeText(value);return true;}
        catch(_) { /* fall back to temporary textarea */ }
      }
      const box=document.createElement("textarea");
      box.value=value;box.readOnly=true;
      box.style.position="fixed";box.style.left="-9999px";
      document.body.appendChild(box);
      box.select();
      let copied=false;
      try {copied=document.execCommand("copy");}
      catch(_) {copied=false;}
      box.remove();
      return copied;
    }

    async function xuatMotVatTu(index) {
      if(dangXuatExcel||!chiMucSanSang||!tieuDeCot.length) {
        thongBaoMenuVatTu("stockMenuExportBusy");return;
      }
      const row=tatCaDuLieu[index];
      if(!row)return;
      const sap=chuanHoaMaSap(row[0]);
      dangXuatExcel=true;
      try {
        // The existing Excel generator accepts an array of {dong,chiSo}.
        const blob=await taoBaoCaoXlsx([{dong:row,chiSo:index}],{
          keyword:sap,scope:"sap",onlyStock:false,status:"all",fuzzy:false,
          sortCol:-1,sortDir:1,updated:mocCapNhatCu
        });
        const url=URL.createObjectURL(blob);
        try {
          const link=document.createElement("a");
          link.href=url;
          const safeSap=(sap||"vat_tu").replace(/[^a-zA-Z0-9_-]/g,"_").slice(0,70);
          link.download="Vat_tu_"+safeSap+"_"+new Date().toLocaleDateString("sv-SE")+".xlsx";
          document.body.appendChild(link);
          link.click();
          link.remove();
          thongBaoMenuVatTu("stockMenuExportDone",{code:sap});
        } finally {
          setTimeout(()=>URL.revokeObjectURL(url),1500);
        }
      } catch(err) {
        console.error("Material Excel export:",err);
        thongBaoMenuVatTu("stockMenuExportFailed");
      } finally {
        dangXuatExcel=false;
      }
    }

    async function thaoTacMenuVatTu(action) {
      const index=stockMenuIndex;
      dongMenuVatTu();
      const row=tatCaDuLieu[index];
      if(!row)return;
      if(action==="history") {
        moLichSuVatTu(index);
        return;
      }
      if(action==="export") {
        await xuatMotVatTu(index);
        return;
      }
      let value="";
      if(action==="sap")value=chuanHoaMaSap(row[0]);
      else if(action==="part") {
        const partCol=cotTheoTenTimKiem([
          "Part No","Part No.","Part Number","Part Nr","Part #",
          "Part Code","Mã phụ tùng","Mã phụ kiện"
        ],tieuDeCot.length>5?5:2);
        value=partCol>=0?String(row[partCol]??"").trim():"";
        if(!value){thongBaoMenuVatTu("stockMenuNoPart");return;}
      } else return;
      if(!value)return;
      const copied=await saoChepTuMenu(value);
      thongBaoMenuVatTu(copied?"stockMenuCopied":"stockMenuCopyFailed",{value});
    }

    const stockMenuBody=document.getElementById("than-bang");
    stockMenuBody.addEventListener("contextmenu",event=>{
      const row=event.target.closest("tr[data-row-index]");
      if(row&&stockMenuBody.contains(row))moMenuVatTu(event,row);
    });
    stockMenuBody.addEventListener("keydown",event=>{
      if(event.key!=="ContextMenu"&&!(event.shiftKey&&event.key==="F10"))return;
      const row=event.target.closest("tr[data-row-index]");
      if(!row||!stockMenuBody.contains(row))return;
      const rect=row.getBoundingClientRect();
      moMenuVatTu({preventDefault:()=>event.preventDefault(),
        clientX:rect.left+Math.min(64,rect.width/2),
        clientY:Math.min(window.innerHeight-12,rect.top+Math.min(22,rect.height/2))},row);
    });
    const stockMenuElement=document.getElementById("stock-row-menu");
    stockMenuElement.addEventListener("keydown",event=>{
      if(event.key==="Escape"){
        event.preventDefault();event.stopPropagation();dongMenuVatTu(true);return;
      }
      if(event.key==="Tab"){dongMenuVatTu();return;}
      if(event.key==="ArrowDown"||event.key==="ArrowUp"){
        event.preventDefault();event.stopPropagation();
        const items=Array.from(stockMenuElement.querySelectorAll('[role="menuitem"]'));
        const at=items.indexOf(document.activeElement);
        const next=(at+(event.key==="ArrowDown"?1:-1)+items.length)%items.length;
        items[next]?.focus({preventScroll:true});
      }
    });
    document.addEventListener("pointerdown",event=>{
      if(!stockMenuElement.hidden&&!stockMenuElement.contains(event.target))dongMenuVatTu();
    });
    document.addEventListener("scroll",()=>{
      if(!stockMenuElement.hidden)dongMenuVatTu();
    },true);
    window.addEventListener("blur",()=>dongMenuVatTu());
    document.querySelector(".table-wrapper").addEventListener("scroll", xuLyCuonCuoiBang, { passive: true });
    document.getElementById("lightbox-img").addEventListener("wheel", xuLyZoomBangConLan, { passive: false });
    document.querySelector(".material-history-table").addEventListener("scroll",cuonTiepLichSuVatTu,{passive:true});
    document.getElementById("material-history-dialog").addEventListener("close",()=>{
      if(materialHistoryReturnFocus?.isConnected)materialHistoryReturnFocus.focus();
    });
    document.addEventListener("keydown", e => {
      // Native dialog owns Escape/Tab; prevent Stock shortcuts behind the modal.
      if(document.getElementById("material-history-dialog").open)return;
      const lightboxDangMo = document.getElementById("lightbox").style.display === "flex";
      if (lightboxDangMo) {
        if (e.key === "Escape") dongLightbox(e);
        if (e.key === "ArrowLeft") doiAnhLightbox(-1, e);
        if (e.key === "ArrowRight") doiAnhLightbox(1, e);
        if (e.key === "+" || e.key === "=") thayDoiZoom(.2);
        if (e.key === "-") thayDoiZoom(-.2);
        return;
      }

      const dangNhapLieu = ["INPUT", "TEXTAREA", "SELECT"].includes(document.activeElement?.tagName);
      if (e.key === "/" && !dangNhapLieu) {
        e.preventDefault();
        document.getElementById("o-tim-kiem").focus();
        return;
      }
      if (e.key === "Escape" && document.activeElement?.id === "o-tim-kiem") {
        document.getElementById("o-tim-kiem").blur();
        return;
      }
      if (e.key === "Enter" && document.activeElement?.dataset?.rowIndex) {
        e.preventDefault();
        if(e.shiftKey)moLichSuVatTu(Number(document.activeElement.dataset.rowIndex));
        else chonDong(Number(document.activeElement.dataset.rowIndex), document.activeElement);
        return;
      }
      if (dangNhapLieu) return;
      if (e.key === "ArrowUp" || e.key === "ArrowDown") {
        e.preventDefault();
        chonDongBangPhim(e.key === "ArrowDown" ? 1 : -1);
      }
    });

    // Khi tab nền, taiDuLieu() không tạo request. Trở lại tab sẽ cập nhật ngay.
    taiManifestAnh();
    khoiTaoTuyChon();
      const storedPageSize=Number(docTuyChon("checking-rows-per-page"));
      if(Number.isInteger(storedPageSize)&&storedPageSize>=1)
        SO_DONG_MOI_TRANG=Math.min(storedPageSize,SO_DONG_TRANG_TOI_DA);
      capNhatDieuKhienPhanTrang();
    document.querySelector(".view-tabs").addEventListener("keydown",xuLyPhimTab);
    const tabDuocLuu=docTuyChon("checking-active-tab");
    chuyenTab(CAC_TAB.includes(tabDuocLuu)?tabDuocLuu:"stock",{persist:false});
    khoiTaoLichNhacBaoCao();
    const dashboardNow=new Date();
    const selectedYear=String(dashboardNow.getFullYear());
    document.getElementById("dashboard-range-year-from").value=selectedYear;
    document.getElementById("dashboard-range-year-to").value=selectedYear;
    document.getElementById("dashboard-range-from").value=
      ngayDiaPhuongISO(new Date(dashboardNow.getFullYear(),dashboardNow.getMonth(),1));
    document.getElementById("dashboard-range-to").value=ngayDiaPhuongISO(dashboardNow);
    for(const id of ["dashboard-top-out","dashboard-dormant"]){
      const node=document.getElementById(id);
      node.addEventListener("dblclick",moLichSuBangDashboard);
      node.addEventListener("keydown",bamPhimLichSuBangDashboard);
    }
    doiKyPhanTichKho();
    taiDuLieu();
    setInterval(taiDuLieu, 30000);
    setInterval(kiemTraNhacBaoCao, 60000);
    document.addEventListener("visibilitychange", () => {
      if (!document.hidden) {taiDuLieu();kiemTraNhacBaoCao();}
    });
  </script>
</body>
</html>





            <div class="table-header-actions"><div class="reorder-legend">
<span><b class="legend-green"></b><span data-i18n="stockAbove">Trên định mức</span></span>
<span><b class="legend-yellow"></b><span data-i18n="stockEqual">Bằng định mức</span></span>

    let ngonNguHienTai = "vi";
    let giaoDienHienTai = "light";

    function tuDien(key, values = {}) {
      const text = NGON_NGU[ngonNguHienTai][key] ?? NGON_NGU.vi[key] ?? key;
      return String(text).replace(/\{([a-zA-Z]+)\}/g, (_, variable) =>
        Object.prototype.hasOwnProperty.call(values, variable) ? String(values[variable]) : "{" + variable + "}");
    }

    function ghiTuyChon(key, value) {
      try { localStorage.setItem(key, value); } catch (_) { /* file:// / private browsing */ }
    }
    function docTuyChon(key) {
      try { return localStorage.getItem(key); } catch (_) { return null; }
    }

    function tenCotDaDich(tenCot) {
      const ten = String(tenCot ?? "");
      const k = ten.trim().toLowerCase();
      const key = {
        "sap":"colSap", "sap code":"colSap", "mã sap":"colSap",
        "description":"colDescription", "mô tả":"colDescription",
        "part no":"colPart", "part no.":"colPart", "part number":"colPart",
        "quantity":"colQuantity", "qty":"colQuantity", "số lượng":"colQuantity",
        "price":"colPrice", "giá":"colPrice", "bm no":"colBm",
        "unit":"colUnit", "đơn vị":"colUnit", "group":"colGroup", "nhóm":"colGroup"
      }[k];
      return key ? tuDien(key) : ten;
    }

    function apDungNgonNgu() {
      document.documentElement.lang = ngonNguHienTai;
      document.querySelectorAll("[data-i18n]").forEach(el => {
        el.textContent = tuDien(el.dataset.i18n);
      });
      for (const [selector, attribute, key] of [
        ["[data-i18n-placeholder]","placeholder","i18nPlaceholder"],
        ["[data-i18n-title]","title","i18nTitle"],
        ["[data-i18n-aria]","aria-label","i18nAria"],
        ["[data-i18n-alt]","alt","i18nAlt"]
      ]) {
        document.querySelectorAll(selector).forEach(el =>
          el.setAttribute(attribute, tuDien(el.dataset[key]))
        );
      }
      document.getElementById("lang-vi").setAttribute("aria-pressed", String(ngonNguHienTai === "vi"));
      document.getElementById("lang-en").setAttribute("aria-pressed", String(ngonNguHienTai === "en"));
      document.getElementById("theme-toggle").setAttribute("aria-label",
        tuDien(giaoDienHienTai === "dark" ? "themeToLight" : "themeToDark"));
      document.getElementById("theme-toggle").title =
        tuDien(giaoDienHienTai === "dark" ? "themeToLight" : "themeToDark");
      const trangThai = document.getElementById("tinh-trang-du-lieu");
      trangThai.textContent = tuDien(trangThai.dataset.status || "statusConnecting");
      const capNhat = document.getElementById("trang-thai-cap-nhat");
      if (capNhat.dataset.messageKey) capNhat.textContent = tuDien(capNhat.dataset.messageKey, {
        time: capNhat.dataset.updateTime || "", file: duongDanOMang
      });

      if (tieuDeCot.length) veTieuDe();
      if (chiMucSanSang) {
        hienThiTrangHienTai();
        document.getElementById("trang-thai-ban-ghi").textContent = tuDien("records", {
          found: dinhDangSoLuong.format(ketQuaLoc.length),
          total: dinhDangSoLuong.format(duLieuTimKiem.length)
        });
      }
      const idDaChon = dongDangChonIndex;
      if (idDaChon >= 0 && tatCaDuLieu[idDaChon]) {
        document.getElementById("nhan-sap").textContent =
          tuDien("sapCode",{code:chuanHoaMaSap(tatCaDuLieu[idDaChon][0]) || "—"});
        hienThiChiTiet(tatCaDuLieu[idDaChon]);
      } else {
        document.getElementById("nhan-sap").textContent = tuDien("noSelectedSap");
      }
      document.getElementById("thong-tin-trang").textContent = tuDien("page", {
        current: trangHienTai, total: Math.max(1,Math.ceil(ketQuaLoc.length / SO_DONG_MOI_TRANG))
      });
      capNhatGiaoDienAnh();
      if (!tatCaDuLieu.length) document.getElementById("trang-thai-cap-nhat").textContent = tuDien("loadingSource");
    }

    function doiNgonNgu(ngonNgu) {
      if (ngonNgu !== "vi" && ngonNgu !== "en") return;
      ngonNguHienTai = ngonNgu;
      dinhDangSoLuong = new Intl.NumberFormat(ngonNgu === "en" ? "en-US" : "vi-VN");
      ghiTuyChon("checking-language", ngonNgu);
      apDungNgonNgu();
    }

    function apDungGiaoDien() {
      document.documentElement.dataset.theme = giaoDienHienTai;
      const nut = document.getElementById("theme-toggle");
      nut.textContent = giaoDienHienTai === "dark" ? "☀" : "☾";
      nut.setAttribute("aria-pressed", String(giaoDienHienTai === "dark"));
      nut.setAttribute("aria-label", tuDien(giaoDienHienTai === "dark" ? "themeToLight" : "themeToDark"));
      nut.title = tuDien(giaoDienHienTai === "dark" ? "themeToLight" : "themeToDark");
    }

    function doiGiaoDien() {
      giaoDienHienTai = giaoDienHienTai === "dark" ? "light" : "dark";
      ghiTuyChon("checking-theme", giaoDienHienTai);
      apDungGiaoDien();
    }

    function khoiTaoTuyChon() {
      const ngonNgu = docTuyChon("checking-language");
      const giaoDien = docTuyChon("checking-theme");
      ngonNguHienTai = ngonNgu === "en" ? "en" : "vi";
      dinhDangSoLuong = new Intl.NumberFormat(ngonNguHienTai === "en" ? "en-US" : "vi-VN");
      giaoDienHienTai = giaoDien === "dark" ? "dark" : "light";
      apDungGiaoDien();
      apDungNgonNgu();
    }

    // ================= CẤU HÌNH THƯ MỤC Ổ MẠNG =================
    const duongDanOMang = "data.js";
    const THU_MUC_HINH = "Material/"; // Thư mục chứa ảnh
    const SO_ANH_TOI_DA = 10;        // Tự động quét từ _01 đến _10
    const SO_DONG_MOI_TRANG = 75;
    // Chỉ hiển thị các cột Excel 1, 2, 6, 4, 5, 3 trong bảng.
    const COT_HIEN_THI = [0, 1, 5, 3, 4, 2];
    // ==========================================================

    let tatCaDuLieu = [];
    let tieuDeCot = [];
    let dongDangChonIndex = -1;
    let danhSachAnhDangXem = [];
    let viTriAnhDangXem = 0;
    let maSapDangXem = "";
    let mocCapNhatCu = "";
    let duLieuTimKiem = [];
    let soLanLocDuLieu = 0;
    let ketQuaLoc = [];
    let trangHienTai = 1;
    let cotSapXep = -1;
    let huongSapXep = 1;
    let mucZoom = 1;

    let lanTaiDuLieu = 0;
    let dangTaiScript = false;

    function datTrangThaiDuLieu(key, loai) {
      const el = document.getElementById("tinh-trang-du-lieu");
      el.dataset.status = key;
      el.textContent = tuDien(key);
      el.className = "online-pill" + (loai ? " " + loai : "");
    }

    function datThongBaoCapNhat(key, values = {}) {
      const el = document.getElementById("trang-thai-cap-nhat");
      el.dataset.messageKey = key;
      el.dataset.updateTime = values.time ?? "";
      el.textContent = tuDien(key, values);
    }

    function taiDuLieu() {
      if (document.hidden || dangTaiScript) return;
      dangTaiScript = true;
      const lanHienTai = ++lanTaiDuLieu;
      const scriptCu = document.getElementById("script-data");
      if (scriptCu) scriptCu.remove();

      const s = document.createElement("script");
      s.id = "script-data";
      s.async = true;
      s.src = duongDanOMang + "?t=" + Date.now();
      datTrangThaiDuLieu("statusLoading", "loading");

      let daHetGio = false;
      const gioiHan = setTimeout(function() {
        if (lanHienTai !== lanTaiDuLieu || !dangTaiScript) return;
        daHetGio = true;
        dangTaiScript = false;
        s.remove();
        datTrangThaiDuLieu("statusOffline", "error");
        datThongBaoCapNhat("statusTimeout");
      }, 15000);

      s.onload = function() {
        if (lanHienTai !== lanTaiDuLieu || daHetGio) return;
        clearTimeout(gioiHan);
        dangTaiScript = false;
        const duLieuMoi = window.duLieuCongTy;
        const thoiGianCapNhat = window.thoiGianCapNhat;
        const coMocCapNhat = thoiGianCapNhat !== undefined
          && thoiGianCapNhat !== null && thoiGianCapNhat !== "";

        if (!Array.isArray(duLieuMoi) || !duLieuMoi.length || !Array.isArray(duLieuMoi[0])) {
          datTrangThaiDuLieu("statusInvalid", "error");
          datThongBaoCapNhat("statusBadData");
          return;
        }
        if (!coMocCapNhat || thoiGianCapNhat !== mocCapNhatCu || !tatCaDuLieu.length) {
          mocCapNhatCu = coMocCapNhat ? thoiGianCapNhat : "";
          tatCaDuLieu = duLieuMoi;
          tieuDeCot = tatCaDuLieu[0];
          chiMucSanSang = false;
          soLanLocDuLieu++;
          veTieuDe();
          taoChiMucTimKiem();
        }
        datTrangThaiDuLieu("statusOnline");
        datThongBaoCapNhat("updated", {time: coMocCapNhat ? thoiGianCapNhat : new Date().toLocaleString(ngonNguHienTai === "en" ? "en-US" : "vi-VN")});
      };
      s.onerror = function() {
        if (lanHienTai !== lanTaiDuLieu || daHetGio) return;
        clearTimeout(gioiHan);
        dangTaiScript = false;
        datTrangThaiDuLieu("statusOffline", "error");
        datThongBaoCapNhat("statusLoadFail", {file:duongDanOMang});
      };
      document.body.appendChild(s);
    }

    function thoatHTML(giaTri) {
      return String(giaTri ?? "").replace(/[&<>"']/g, kyTu => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
      })[kyTu]);
    }

    function veTieuDe() {
      document.getElementById("dau-bang").innerHTML = "<tr>" + COT_HIEN_THI.map(chiSo => {
        const c = thoatHTML(tenCotDaDich(tieuDeCot[chiSo]));
        const dangSapXep = cotSapXep === chiSo;
        const muiTen = dangSapXep ? (huongSapXep === 1 ? "▲" : "▼") : "↕";
        const ariaSort = dangSapXep ? (huongSapXep === 1 ? "ascending" : "descending") : "none";
        return '<th aria-sort="' + ariaSort + '"><button type="button" class="sort-trigger" ' +
          'onclick="sapXepTheoCot(' + chiSo + ')" title="' + thoatHTML(tuDien("sortBy", {column:tenCotDaDich(tieuDeCot[chiSo])})) + '">' +
          c + '<span class="sort-indicator">' + muiTen + '</span></button></th>';
      }).join("") + "</tr>";
    }

    function laCotPrice(chiSoCot) {
      return String(tieuDeCot[chiSoCot] ?? "").trim().toLowerCase() === "price";
    }

    function chuyenThanhSo(giaTri) {
      const chuoi = String(giaTri ?? "").trim().replace(/\s/g, "");
      if (!chuoi) return NaN;

      let daChuanHoa = chuoi;
      if (chuoi.includes(".") && chuoi.includes(",")) {
        daChuanHoa = chuoi.lastIndexOf(",") > chuoi.lastIndexOf(".")
          ? chuoi.replace(/\./g, "").replace(",", ".")
          : chuoi.replace(/,/g, "");
      } else if (/^-?\d{1,3}(?:\.\d{3})+$/.test(chuoi)) {
        daChuanHoa = chuoi.replace(/\./g, "");
      } else if (/^-?\d{1,3}(?:,\d{3})+$/.test(chuoi)) {
        daChuanHoa = chuoi.replace(/,/g, "");
      } else if (chuoi.includes(",")) {
        daChuanHoa = chuoi.replace(",", ".");
      }

      return Number(daChuanHoa);
    }

    function hienThiGiaTri(chiSoCot, giaTri) {
      if (!laCotPrice(chiSoCot) || giaTri === null || giaTri === undefined || giaTri === "") {
        return giaTri ?? "";
      }

      const soTien = chuyenThanhSo(giaTri);
      if (!Number.isFinite(soTien)) return giaTri;

      return new Intl.NumberFormat("vi-VN", {
        style: "currency",
        currency: "VND",
        maximumFractionDigits: 0
      }).format(soTien);
    }

    function timCotTheoTen(tenCot) {
      const tenCanTim = tenCot.trim().toLowerCase();
      return tieuDeCot.findIndex(cot =>
        String(cot ?? "").trim().toLowerCase() === tenCanTim
      );
    }

    function chuanHoaMaSap(giaTri) {
      const ma = String(giaTri ?? "").trim();
      return /^\d+\.0+$/.test(ma) ? ma.replace(/\.0+$/, "") : ma;
    }

    function capNhatCardBmNo(dongData) {
      const card = document.getElementById("bm-no-card");
      const danhSach = document.getElementById("bm-no-list");
      const chiSoBmNo = timCotTheoTen("BM No");
      const giaTri = chiSoBmNo >= 0 ? String(dongData[chiSoBmNo] ?? "").trim() : "";
      const maBmNo = giaTri.split(/[,\n;|]+/).map(value => value.trim()).filter(Boolean);

      danhSach.innerHTML = maBmNo.map(value => `<span class="bm-no-value">${thoatHTML(value)}</span>`).join("");
      card.classList.toggle("visible", maBmNo.length > 0);

      const luoiChiTiet = document.getElementById("luoi-chi-tiet");
      const chiSoPrice = timCotTheoTen("Price");
      const thePrice = chiSoPrice >= 0 ? luoiChiTiet.querySelector(
        '.detail-item[data-col-index="' + chiSoPrice + '"]'
      ) : null;

      if (thePrice) {
        thePrice.after(card);
      } else {
        luoiChiTiet.appendChild(card);
      }
    }

    let chiMucSanSang = false;
    let lanLapChiMuc = 0;
    let soCoTonKho = 0;
    let dinhDangSoLuong = new Intl.NumberFormat("vi-VN");

    // Lập chỉ mục theo nhóm, tránh khóa giao diện với bảng dữ liệu lớn.
    function taoChiMucTimKiem() {
      const lanHienTai = ++lanLapChiMuc;
      const chiSoBmNo = timCotTheoTen("BM No");
      duLieuTimKiem = [];
      soCoTonKho = 0;
      chiMucSanSang = false;
      dangLocDuLieu = true;
      let viTri = 1;
      const tong = Math.max(0, tatCaDuLieu.length - 1);
      document.getElementById("metric-total").textContent = dinhDangSoLuong.format(tong);
      document.getElementById("metric-instock").textContent = "…";
      document.getElementById("metric-results").textContent = "…";
      document.getElementById("trang-thai-ban-ghi").textContent = tuDien("processing");
      document.getElementById("than-bang").innerHTML =
        '<tr><td colspan="6" class="empty-table">' + tuDien("preparing") + '</td></tr>';

      function xuLyNhom() {
        if (lanHienTai !== lanLapChiMuc) return;
        const gioiHan = Math.min(viTri + 1000, tatCaDuLieu.length);
        for (; viTri < gioiHan; viTri++) {
          const dong = tatCaDuLieu[viTri];
          if (!Array.isArray(dong)) continue;
          const giaTri = dong.map(ten => String(ten ?? "").toLowerCase());
          const coTonKho = chuyenThanhSo(dong[3]) > 0;
          if (coTonKho) soCoTonKho++;
          duLieuTimKiem.push({
            chiSo: viTri,
            dong: dong,
            all: giaTri.join("\u0001"),
            sap: giaTri[0] || "",
            desc: giaTri[1] || "",
            part: giaTri[2] || "",
            bmno: chiSoBmNo >= 0 ? giaTri[chiSoBmNo] || "" : "",
            coTonKho: coTonKho
          });
        }
        if (viTri < tatCaDuLieu.length) {
          setTimeout(xuLyNhom, 0);
        } else {
          chiMucSanSang = true;
          document.getElementById("metric-instock").textContent = dinhDangSoLuong.format(soCoTonKho);
          locDuLieu();
        }
      }
      xuLyNhom();
    }

    let boTriHoanTimKiem = null;
    let dangLocDuLieu = false;
    function yeuCauLocDuLieu() {
      clearTimeout(boTriHoanTimKiem);
      dangLocDuLieu = true;
      ++soLanLocDuLieu;
      trangHienTai = 1;
      boTriHoanTimKiem = setTimeout(locDuLieu, 170);
    }

    // Lọc theo từng nhịp animation frame và hủy các truy vấn đã lỗi thời.
    function locDuLieu() {
      clearTimeout(boTriHoanTimKiem);
      boTriHoanTimKiem = null;
      if (!chiMucSanSang) return;
      dangLocDuLieu = true;
      const tuKhoa = document.getElementById("o-tim-kiem").value.trim().toLowerCase();
      const cheDoTim = document.querySelector('input[name="truongTim"]:checked').value;
      const chiTonKho = document.getElementById("chk-ton-kho").checked;
      const truongTim = cheDoTim === "all" ? "all" : cheDoTim;
      const lanLocHienTai = ++soLanLocDuLieu;
      const moi = [];
      let viTri = 0;
      const tong = duLieuTimKiem.length;
      document.getElementById("trang-thai-ban-ghi").textContent = tuDien("searching");

      function xuLyNhom() {
        if (lanLocHienTai !== soLanLocDuLieu) return;
        const gioiHan = Math.min(viTri + 2500, tong);
        for (; viTri < gioiHan; viTri++) {
          const muc = duLieuTimKiem[viTri];
          if ((!tuKhoa || muc[truongTim].includes(tuKhoa)) && (!chiTonKho || muc.coTonKho)) {
            moi.push(muc);
          }
        }
        if (viTri < tong) {
          requestAnimationFrame(xuLyNhom);
          return;
        }
        ketQuaLoc = moi;
        sapXepKetQua();
        dangLocDuLieu = false;
        hienThiTrangHienTai();
        document.querySelector(".table-wrapper").scrollTop = 0;
        document.getElementById("trang-thai-ban-ghi").textContent =
          tuDien("records",{found:dinhDangSoLuong.format(ketQuaLoc.length), total:dinhDangSoLuong.format(tong)});
        document.getElementById("metric-results").textContent = dinhDangSoLuong.format(ketQuaLoc.length);
      }
      xuLyNhom();
    }

    function sapXepTheoCot(chiSoCot) {
      if (cotSapXep === chiSoCot) huongSapXep *= -1;
      else { cotSapXep = chiSoCot; huongSapXep = 1; }
      trangHienTai = 1;
      veTieuDe();
      locDuLieu();
    }

    function sapXepKetQua() {
      if (cotSapXep < 0) return;
      ketQuaLoc.sort((a, b) => {
        const giaTriA = String(a.dong[cotSapXep] ?? "").trim();
        const giaTriB = String(b.dong[cotSapXep] ?? "").trim();
        const soA = chuyenThanhSo(giaTriA);
        const soB = chuyenThanhSo(giaTriB);
        let ketQua;

        if (giaTriA === "" && giaTriB !== "") {
          ketQua = 1;
        } else if (giaTriA !== "" && giaTriB === "") {
          ketQua = -1;
        } else if (Number.isFinite(soA) && Number.isFinite(soB)) {
          ketQua = soA - soB;
        } else {
          ketQua = giaTriA.localeCompare(giaTriB, "vi", {
            numeric: true,
            sensitivity: "base"
          });
        }

        return ketQua * huongSapXep;
      });
    }

    function hienThiTrangHienTai() {
      const tongSoTrang = Math.max(1, Math.ceil(ketQuaLoc.length / SO_DONG_MOI_TRANG));
      if (trangHienTai > tongSoTrang) trangHienTai = tongSoTrang;
      const batDau = (trangHienTai - 1) * SO_DONG_MOI_TRANG;
      const mucTrenTrang = ketQuaLoc.slice(batDau, batDau + SO_DONG_MOI_TRANG);
      const html = mucTrenTrang.map(muc => {
        const selectedClass = muc.chiSo === dongDangChonIndex ? "selected" : "";
        const selectedAria = muc.chiSo === dongDangChonIndex ? "true" : "false";
        const o = COT_HIEN_THI.map(chiSoCot => {
          const giaTri = thoatHTML(hienThiGiaTri(chiSoCot, muc.dong[chiSoCot]));
          if (chiSoCot === 0) return '<td><span class="sap-code">' + giaTri + '</span></td>';
          if (chiSoCot === 3) return '<td><span class="stock-badge' +
            (muc.coTonKho ? '' : ' empty') + '"' +
            (muc.coTonKho ? '' : ' title="' + thoatHTML(tuDien("outOfStock")) + '"') + '>' +
            (muc.coTonKho ? '' : '⚠ ') + giaTri + '</span></td>';
          return '<td>' + giaTri + '</td>';
        }).join("");
        return '<tr class="' + selectedClass + (muc.coTonKho ? '' : ' out-of-stock') + '" data-row-index="' + muc.chiSo +
          '" tabindex="0" aria-selected="' + selectedAria +
          '" onclick="chonDong(' + muc.chiSo + ', this)">' + o + '</tr>';
      }).join("");

      document.getElementById("than-bang").innerHTML = html ||
        '<tr><td colspan="6" class="empty-table">' + tuDien("noResults") + '</td></tr>';
      document.getElementById("thong-tin-trang").textContent = tuDien("page",{current:trangHienTai,total:tongSoTrang});
      document.getElementById("btn-trang-truoc").disabled = trangHienTai <= 1;
      document.getElementById("btn-trang-sau").disabled = trangHienTai >= tongSoTrang;
    }

    function doiTrang(buoc) {
      const tongSoTrang = Math.max(1, Math.ceil(ketQuaLoc.length / SO_DONG_MOI_TRANG));
      const trangMoi = trangHienTai + buoc;
      if (trangMoi < 1 || trangMoi > tongSoTrang) return;
      trangHienTai = trangMoi;
      hienThiTrangHienTai();
      document.querySelector(".table-wrapper").scrollTop = 0;
    }

    // Bottom-of-table auto-pagination. A small cooldown prevents one touch
    // gesture or a programmatic scroll reset from skipping several pages.
    let viTriCuonBangCu = 0;
    let mocChuyenTrangTuDong = 0;

    function xuLyCuonCuoiBang() {
      const vungBang = document.querySelector(".table-wrapper");
      if (!vungBang) return;
      const viTriHienTai = vungBang.scrollTop;
      const dangCuonXuong = viTriHienTai > viTriCuonBangCu + 1;
      viTriCuonBangCu = viTriHienTai;
      if (!dangCuonXuong || Date.now() < mocChuyenTrangTuDong) return;

      // Do not turn pages when the table is shorter than the scroll region.
      if (vungBang.scrollHeight <= vungBang.clientHeight + 24) return;
      const tongTrang = Math.max(1, Math.ceil(ketQuaLoc.length / SO_DONG_MOI_TRANG));
      if (trangHienTai >= tongTrang) return;
      if (viTriHienTai + vungBang.clientHeight < vungBang.scrollHeight - 24) return;

      mocChuyenTrangTuDong = Date.now() + 650;
      doiTrang(1);  // Preserves the existing Next/Previous button behavior.
      viTriCuonBangCu = 0;
    }

    function chonDongBangPhim(buoc) {
      if (ketQuaLoc.length === 0) return;

      const viTriHienTai = ketQuaLoc.findIndex(muc => muc.chiSo === dongDangChonIndex);
      let viTriMoi = viTriHienTai < 0
        ? (buoc > 0 ? 0 : ketQuaLoc.length - 1)
        : viTriHienTai + buoc;

      if (viTriMoi < 0 || viTriMoi >= ketQuaLoc.length) return;

      trangHienTai = Math.floor(viTriMoi / SO_DONG_MOI_TRANG) + 1;
      hienThiTrangHienTai();

      const mucMoi = ketQuaLoc[viTriMoi];
      const dongMoi = document.querySelector(
        '#than-bang tr[data-row-index="' + mucMoi.chiSo + '"]'
      );
      if (!dongMoi) return;

      chonDong(mucMoi.chiSo, dongMoi);
      dongMoi.scrollIntoView({ block: "nearest" });
    }

    function hienThiChiTiet(dongData) {
      let htmlChiTiet = "";
      const chiSoBm = timCotTheoTen("BM No");
      for (let c = 0; c < tieuDeCot.length; c++) {
        if (c === chiSoBm) continue;
        htmlChiTiet += '<div class="detail-item" data-col-index="' + c + '"><label>' +
          thoatHTML(tenCotDaDich(tieuDeCot[c])) + '</label><span>' +
          thoatHTML(hienThiGiaTri(c, dongData[c])) + '</span></div>';

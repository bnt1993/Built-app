          const timestamp=new Date().toLocaleDateString("sv-SE");
          link.download="Lich_su_"+safeSap+"_"+timestamp+".xlsx";
          document.body.appendChild(link);
          link.click();
          link.remove();
        } finally {setTimeout(()=>URL.revokeObjectURL(url),1500);}
      } catch(err) {
        console.error("History XLSX export:",err);
        alert(tuDien(err.message==="XLSX_EXCEL_LIMIT"?"historyExportLimit":"historyExportFailed"));
      } finally {
        materialHistoryExporting=false;
        button.disabled=!historyLoaded||historyLoading||!materialHistoryRows.length;
        button.removeAttribute("aria-busy");
        caption.textContent=tuDien("historyExport");
      }
    }

